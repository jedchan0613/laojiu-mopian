# 这是线上管理服务的配置示例，不包含真实账号或密钥。
# 正式配置文件应放在服务器 /etc/laojiumopian-admin.env，并设置为仅 root 可读。

LJM_ADMIN_MODE=online
LJM_ADMIN_HOST=127.0.0.1
LJM_ADMIN_PORT=4174
LJM_ADMIN_ORIGIN=https://admin.laojiumopian.com
PUBLIC_SITE_URL=https://laojiumopian.com

LJM_PROJECT_ROOT=/srv/laojiumopian-admin/app/current
LJM_ADMIN_DATA_ROOT=/srv/laojiumopian-admin/data
LJM_SUBMISSION_DATA_DIR=/srv/laojiumopian-admin/data/submissions
LJM_NPM_COMMAND=/snap/node/current/bin/npm
LJM_PUBLIC_RELEASES_DIR=/srv/laojiumopian/releases
LJM_PUBLIC_LIVE_LINK=/srv/laojiumopian/releases/live

# 在 Cloudflare Zero Trust 中复制团队域名和本应用的 Audience (AUD) Tag 后替换下面两项。
LJM_CF_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM-NAME.cloudflareaccess.com
LJM_CF_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUD_TAG

# 只填写允许进入管理页的邮箱；多个邮箱使用英文逗号分隔。
LJM_ADMIN_ALLOWED_EMAILS=REPLACE_WITH_YOUR_EMAIL@example.com
