# 独立账户服务（local-admin/account-server.mjs）配置示例，不含任何真实账号或密钥。
# 正式配置只放在服务器私密环境文件里，不要提交到项目，也不要放进公开目录。

# development | production；生产环境会拒绝本机测试投递通道。
LJM_ACCOUNT_ENV=development

# 服务固定只监听 127.0.0.1，端口默认 4175。
LJM_ACCOUNT_PORT=4175

# 公开网站来源地址：用于校验账户接口的请求来源，必须与浏览器实际访问的地址一致。
LJM_ACCOUNT_ORIGIN=http://127.0.0.1:4173

# 管理入口来源地址：只有该来源可以调用 /api/account-admin/*。
LJM_ADMIN_ORIGIN=http://127.0.0.1:4173

# 账户私密数据目录（必须是绝对路径，且不能位于 site/、public-assets/、local-admin/public/ 或公开版本目录内）。
# 目录内会存放 accounts.db、来源地址盐与本机测试投递目录 mail-outbox/。
LJM_ACCOUNT_DATA_DIR=/srv/laojiumopian-admin/data/accounts

# 邮件通道：none（未配置，登录会明确提示服务不可用）、file（仅开发/测试）、https（正式，必需）。
LJM_MAIL_TRANSPORT=none

# HTTPS 通道参数：服务商的发信接口地址、API 密钥、发件人。密钥只放在服务器私密环境文件。
LJM_MAIL_API_ENDPOINT=
LJM_MAIL_API_KEY=
LJM_MAIL_FROM=

# 来源地址摘要所用的盐：留空时会在数据目录生成一个随机值并保存到 .ip-salt（权限 0600）。
LJM_ACCOUNT_IP_SALT=
