---
import ContactWidget from '../components/ContactWidget.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BrandMark from '../components/BrandMark.astro';
import brandFont from '../assets/fonts/noto-serif-sc-brand.woff2?url';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	pageType?: 'website' | 'article';
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title = '老旧默片｜普通人的生活档案',
	description = '老旧默片——从一张照片、一封信和一件旧物开始，保存普通人的生活痕迹。',
	image,
	pageType = 'website',
	structuredData,
} = Astro.props;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isArchive = currentPath.startsWith('/archive');
const isAbout = currentPath.startsWith('/about');
const isContribute = currentPath.startsWith('/contribute');
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site) : undefined;
const shareImageUrl = image && Astro.site ? new URL(image, Astro.site) : undefined;
const serializedStructuredData = structuredData
	? JSON.stringify(structuredData).replaceAll('<', '\\u003c')
	: undefined;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
		<link rel="preload" href={brandFont} as="font" type="font/woff2" crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#d9d1bd" />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:site_name" content="老旧默片" />
		<meta property="og:type" content={pageType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
		{shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
		{serializedStructuredData && (
			<script type="application/ld+json" set:html={serializedStructuredData} />
		)}
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">跳到主要内容</a>
		<div class:list={['site-shell', { 'site-shell--archive': isArchive }]}>
			<header class="site-header" data-home-brand={isHome ? 'compact' : undefined}>
				<nav aria-label="主要导航">
					<a class="site-brand" href="/" aria-label="老旧默片首页" aria-current={isHome ? 'page' : undefined}>
						<span class="site-logo"><BrandMark /></span>
						<span class="site-name">老旧默片</span>
					</a>
					<div class="site-links">
						<a href="/archive/" aria-current={isArchive ? 'page' : undefined}>档案</a>
						<a href="/about/" aria-current={isAbout ? 'page' : undefined}>关于</a>
						<a href="/contribute/" aria-current={isContribute ? 'page' : undefined}>我要投稿</a>
					</div>
				</nav>
			</header>

			<main class="site-main" id="main-content" tabindex="-1">
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-identity">
					<p class="footer-name">老旧默片</p>
					<p class="footer-subtitle">普通人的生活档案</p>
					<SocialLinks />
				</div>
				<div class="footer-end">
					<div class="footer-links">
						<a href="/corrections/">纠错与撤下</a>
						<ContactWidget />
					</div>
					<p class="footer-statement">公开页只展示经过核对的发布副本。</p>
				</div>
			</footer>
		</div>
	</body>
</html>

