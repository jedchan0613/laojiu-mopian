---
import mark from '../../public/brand-mark.svg?raw';

interface Props {
	variant?: 'ink' | 'seal';
}

const { variant = 'ink' } = Astro.props;
---

<span class:list={['brand-mark', { 'brand-mark--seal': variant === 'seal' }]} aria-hidden="true" set:html={mark} />

<style>
	.brand-mark {
		display: block;
		width: 100%;
		height: 100%;
		color: var(--site-text);
	}

	.brand-mark--seal {
		padding: 12.5%;
		border-radius: 5%;
		color: #f6f0e3;
		background: var(--site-accent);
	}

	.brand-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
