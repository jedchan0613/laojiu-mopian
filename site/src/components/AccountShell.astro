---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/account.css';

interface Props {
	current: 'contributions' | 'favorites' | 'settings';
	title: string;
	description: string;
	heading: string;
	lede: string;
}

const { current, title, description, heading, lede } = Astro.props;
const items = [
	{ key: 'contributions', href: '/me/contributions/', label: '我的投稿', note: '' },
	{ key: 'favorites', href: '/me/favorites/', label: '我的收藏', note: '' },
	{ key: 'settings', href: '/me/settings/', label: '账户设置', note: '' },
] as const;
---

<BaseLayout title={title} description={description} robots="noindex, nofollow">
	<div class="account-page" data-ljm-account-page={current}>
		<header class="account-hero">
			<div>
				<p class="eyebrow">用户中心</p>
				<h1>{heading}</h1>
				<p class="account-lede">{lede}</p>
			</div>
			<div class="account-seal" aria-hidden="true"><span>老旧默片</span><strong>我的</strong><span>账户</span></div>
		</header>
		<nav class="account-nav" aria-label="用户中心导航">
			{items.map((item) => (
				<a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
					{item.label}{item.note ? <small>{item.note}</small> : null}
				</a>
			))}
		</nav>
		<slot />
	</div>
</BaseLayout>
