---
const playlist = [
	{ title: 'Lullaby（夏日蝉鸣）', src: '/audio/lullaby-summer-cicadas.ogg' },
	{ title: 'Last Reunion', src: '/audio/last-reunion.mp3' },
];
const firstTrack = playlist[0];
---

<aside
	class="background-music"
	data-background-music
	data-background-music-playlist={JSON.stringify(playlist)}
	data-state="paused"
	aria-label="背景音乐"
>
	<audio
		data-background-music-audio
		src={firstTrack.src}
		preload="metadata"
	></audio>
	<button
		class="background-music__toggle"
		type="button"
		data-background-music-toggle
		aria-pressed="false"
		aria-label={`播放背景音乐《${firstTrack.title}》`}
		title={`背景音乐：${firstTrack.title}`}
	>
		<svg class="background-music__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
			<path d="M9.25 17.25V6.5l8-1.75v10.5" />
			<path d="M9.25 9.15l8-1.75" />
			<ellipse cx="6.75" cy="17.4" rx="2.5" ry="1.85" />
			<ellipse cx="14.75" cy="15.4" rx="2.5" ry="1.85" />
		</svg>
		<span data-background-music-label aria-live="polite">播放音乐</span>
	</button>
	<span class="background-music__track" data-background-music-track aria-hidden="true">
		1 / {playlist.length} · {firstTrack.title}
	</span>
</aside>

<script>
	type BackgroundTrack = { title: string; src: string };

	const root = document.querySelector<HTMLElement>('[data-background-music]');
	const audio = root?.querySelector<HTMLAudioElement>('[data-background-music-audio]');
	const toggle = root?.querySelector<HTMLButtonElement>('[data-background-music-toggle]');
	const label = root?.querySelector<HTMLElement>('[data-background-music-label]');
	const trackLabel = root?.querySelector<HTMLElement>('[data-background-music-track]');

	if (root && audio && toggle && label && trackLabel && root.dataset.ready !== 'true') {
		root.dataset.ready = 'true';

		const preferenceKey = 'ljm-background-music-preference';
		const positionKey = 'ljm-background-music-position-v2';
		const trackIndexKey = 'ljm-background-music-track-index';
		let playlist: BackgroundTrack[] = [];
		try {
			const parsedPlaylist = JSON.parse(root.dataset.backgroundMusicPlaylist ?? '[]');
			if (Array.isArray(parsedPlaylist)) {
				playlist = parsedPlaylist.filter((track): track is BackgroundTrack => (
					typeof track?.title === 'string' && typeof track?.src === 'string'
				));
			}
		} catch {
			playlist = [];
		}

		let currentTrackIndex = 0;
		let wantsPlayback = false;
		const failedTrackIndexes = new Set<number>();

		try {
			// 只有访客主动点过"播放音乐"，才在本次浏览的后续页面延续播放；
			// 首次来访一律保持安静，绝不在访客点击其他内容时突然出声。
			wantsPlayback = sessionStorage.getItem(preferenceKey) === 'playing';
			const savedTrackIndex = Number(sessionStorage.getItem(trackIndexKey));
			if (Number.isInteger(savedTrackIndex) && savedTrackIndex >= 0 && savedTrackIndex < playlist.length) {
				currentTrackIndex = savedTrackIndex;
			}
		} catch {
			wantsPlayback = false;
		}

		audio.volume = 0.24;
		const currentTrack = () => playlist[currentTrackIndex];

		const updateTrackPresentation = () => {
			const track = currentTrack();
			if (!track) return;
			trackLabel.textContent = `${currentTrackIndex + 1} / ${playlist.length} · ${track.title}`;
			toggle.title = `背景音乐：${track.title}`;
		};

		const rememberPreference = (preference: 'playing' | 'paused') => {
			try {
				sessionStorage.setItem(preferenceKey, preference);
			} catch {
				// 浏览器禁用会话存储时，播放器仍可在当前页面正常工作。
			}
		};

		const rememberPosition = () => {
			try {
				sessionStorage.setItem(trackIndexKey, String(currentTrackIndex));
				if (Number.isFinite(audio.currentTime) && audio.currentTime > 0) {
					sessionStorage.setItem(positionKey, String(audio.currentTime));
				}
			} catch {
				// 播放进度只用于页面之间衔接，写入失败不影响播放。
			}
		};

		const showState = (state: 'playing' | 'waiting' | 'paused' | 'unavailable') => {
			const track = currentTrack();
			const isPlaying = state === 'playing';
			root.dataset.state = state;
			toggle.setAttribute('aria-pressed', String(isPlaying));

			if (state === 'playing') {
				label.textContent = '暂停音乐';
				toggle.setAttribute('aria-label', `暂停背景音乐《${track?.title ?? ''}》`);
				return;
			}

			if (state === 'unavailable') {
				label.textContent = '音乐不可用';
				toggle.setAttribute('aria-label', '背景音乐暂时不可用');
				toggle.disabled = true;
				return;
			}

			label.textContent = '播放音乐';
			toggle.setAttribute('aria-label', `播放背景音乐《${track?.title ?? ''}》`);
		};

		const requestPlayback = async () => {
			if (!wantsPlayback) return;
			try {
				await audio.play();
				showState('playing');
			} catch {
				// 主流浏览器会拦截未经访客交互的有声自动播放。
				showState('waiting');
			}
		};

		const unlockPlayback = (event: Event) => {
			if (event.target instanceof Node && root.contains(event.target)) return;
			if (wantsPlayback && audio.paused) void requestPlayback();
		};

		const loadTrack = (trackIndex: number, position = 0) => {
			if (!playlist.length) return;
			currentTrackIndex = (trackIndex + playlist.length) % playlist.length;
			const track = currentTrack();
			if (!track) return;
			audio.src = track.src;
			audio.load();
			updateTrackPresentation();
			try {
				sessionStorage.setItem(trackIndexKey, String(currentTrackIndex));
				sessionStorage.setItem(positionKey, String(position));
			} catch {
				// 曲目顺序只在当前标签页内记忆，存储不可用时从第一首开始。
			}
			if (position > 0) {
				audio.addEventListener('loadedmetadata', () => {
					try {
						audio.currentTime = Math.min(position, Math.max(0, audio.duration - 0.25));
					} catch {
						// 无法恢复进度时从曲目开头播放。
					}
				}, { once: true });
			}
		};

		const playNextTrack = () => {
			failedTrackIndexes.clear();
			loadTrack(currentTrackIndex + 1);
			if (wantsPlayback) void requestPlayback();
		};

		const playNextAvailableTrack = () => {
			failedTrackIndexes.add(currentTrackIndex);
			if (failedTrackIndexes.size >= playlist.length) {
				showState('unavailable');
				return;
			}

			let nextTrackIndex = (currentTrackIndex + 1) % playlist.length;
			while (failedTrackIndexes.has(nextTrackIndex)) {
				nextTrackIndex = (nextTrackIndex + 1) % playlist.length;
			}
			loadTrack(nextTrackIndex);
			if (wantsPlayback) void requestPlayback();
		};

		audio.addEventListener('playing', () => showState('playing'));
		audio.addEventListener('pause', () => showState(wantsPlayback ? 'waiting' : 'paused'));
		audio.addEventListener('ended', playNextTrack);
		audio.addEventListener('error', playNextAvailableTrack);

		if (!playlist.length) {
			showState('unavailable');
		} else {
			let savedPosition = 0;
			try {
				savedPosition = Number(sessionStorage.getItem(positionKey));
			} catch {
				savedPosition = 0;
			}
			loadTrack(currentTrackIndex, Number.isFinite(savedPosition) ? savedPosition : 0);
		}

		toggle.addEventListener('click', () => {
			if (audio.paused) {
				wantsPlayback = true;
				rememberPreference('playing');
				void requestPlayback();
				return;
			}

			wantsPlayback = false;
			rememberPreference('paused');
			audio.pause();
			showState('paused');
		});

		document.addEventListener('pointerdown', unlockPlayback, { capture: true });
		document.addEventListener('keydown', unlockPlayback, { capture: true });
		window.addEventListener('pagehide', rememberPosition);

		if (playlist.length) {
			if (wantsPlayback) void requestPlayback();
			else showState('paused');
		}
	}
</script>

<style>
	.background-music {
		position: fixed;
		left: env(safe-area-inset-left, 0);
		bottom: max(16px, env(safe-area-inset-bottom));
		z-index: 60;
		display: inline-flex;
		align-items: center;
		max-width: calc(100vw - env(safe-area-inset-left, 0px));
		color: #eee8dc;
		background: rgba(39, 39, 35, 0.94);
		border: 1px solid rgba(238, 232, 220, 0.32);
		border-left: 0;
		box-shadow: 0 7px 22px rgba(48, 45, 39, 0.18);
	}

	.background-music audio {
		display: none;
	}

	.background-music__toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		padding: 0.48rem 0.62rem;
		color: inherit;
		background: transparent;
		border: 0;
		cursor: pointer;
		font: inherit;
		font-size: 0.72rem;
		line-height: 1.45;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}

	.background-music__toggle:hover,
	.background-music__toggle:focus-visible {
		color: #fffaf0;
		background: rgba(255, 255, 255, 0.08);
	}

	.background-music__toggle:disabled {
		cursor: default;
		opacity: 0.66;
	}

	.background-music__icon {
		display: block;
		flex: 0 0 auto;
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.35;
		stroke-linecap: square;
		stroke-linejoin: miter;
	}

	.background-music[data-state='playing'] .background-music__icon {
		color: #d88b76;
	}

	.background-music__track {
		display: none;
	}

	@media (max-width: 640px) {
		.background-music {
			bottom: max(10px, env(safe-area-inset-bottom));
		}
	}

	@media print {
		.background-music {
			display: none;
		}
	}
</style>
