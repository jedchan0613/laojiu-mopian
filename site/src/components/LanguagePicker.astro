---
import {getLocale,localizePath,languageNames,locales,t} from '../i18n/ui';
const locale=getLocale(Astro.url.pathname);
interface Props { pathname?: string; }
const {pathname} = Astro.props;
---
<details class="language-picker" data-language-picker>
  <summary aria-label={t('选择语言',locale)}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg>
    <span lang={locale}>{languageNames[locale]}</span>
    <svg class="language-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>
  </summary>
  <div class="language-options">
    <p>{t('选择语言',locale)}</p>
    {locales.map(language=><a href={localizePath(pathname ?? Astro.url.pathname,language)} lang={language} hreflang={language} data-language={language} data-language-target={pathname ? localizePath(pathname,language) : undefined} aria-current={language===locale?'true':undefined}><span>{languageNames[language]}</span><span class="language-check" aria-hidden="true">{language===locale?'✓':''}</span></a>)}
  </div>
</details>
<script>
  for(const picker of document.querySelectorAll<HTMLDetailsElement>('[data-language-picker]')) {
    picker.addEventListener('keydown',event=>{if(event.key==='Escape'){picker.open=false;picker.querySelector('summary')?.focus();}});
    document.addEventListener('click',event=>{if(event.target instanceof Node&&!picker.contains(event.target))picker.open=false;});
  }
</script>
<style>
  .language-picker{position:relative;flex:0 0 auto;font:0.8rem/1.4 var(--site-ui-font);z-index:40}
  summary{list-style:none;display:flex;align-items:center;gap:0.5rem;min-height:40px;padding:0.45rem 0.65rem;border:1px solid var(--site-border-soft);border-radius:5px;cursor:pointer;color:var(--site-ink);background:transparent;white-space:nowrap}
  summary::-webkit-details-marker{display:none}
  summary:hover,.language-picker[open] summary{background:var(--site-paper)}
  summary:focus-visible,a:focus-visible{outline:2px solid var(--site-ink);outline-offset:3px}
  .language-chevron{transition:transform 150ms}.language-picker[open] .language-chevron{transform:rotate(180deg)}
  .language-options{position:absolute;right:0;top:calc(100% + 8px);width:190px;padding:0.45rem;max-height:min(370px,calc(100dvh - 160px));overflow-y:auto;overscroll-behavior:contain;background:var(--site-paper);border:1px solid var(--site-border-soft);border-radius:7px;box-shadow:0 10px 28px rgb(44 40 35 / 12%)}
  .language-options p{margin:0;padding:0.4rem 0.65rem;color:var(--site-muted);font-size:0.7rem}
  .language-options a{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:42px;padding:0.55rem 0.65rem;text-decoration:none;border-radius:4px;color:var(--site-ink);font:inherit;letter-spacing:normal}
  .language-options a:hover,.language-options a[aria-current='true']{background:var(--site-mat)}
  .language-check{width:1rem;font-weight:600}
  @media(max-width:640px){summary{min-height:38px;padding:0.35rem 0.5rem;font-size:0.76rem;gap:0.35rem}.language-options{width:180px}}
</style>
