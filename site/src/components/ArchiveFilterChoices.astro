---
interface Choice {
  value: string;
  label: string;
  count?: number;
  objectTypes?: string[];
  disabled?: boolean;
}
interface Props {
  id: string;
  label: string;
  choices: Choice[];
  selected?: string;
  variant?: 'category' | 'facet' | 'sort';
  searchLabel?: string;
}
const { id, label, choices, selected = '', variant = 'facet', searchLabel } = Astro.props;
---

<div class:list={['archive-choices', `archive-choices--${variant}`]} data-archive-choices={id}>
  <select id={id} aria-label={label} hidden>
    {choices.map(choice => (
      <option value={choice.value} selected={choice.value === selected} disabled={choice.disabled} data-object-types={choice.objectTypes?.join('|')}>
        {choice.label}
      </option>
    ))}
  </select>
  {variant === 'facet' && <h3>{label}</h3>}
  {searchLabel && (
    <label class="archive-choice-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
      <input type="search" data-choice-search aria-label={`${label} · ${searchLabel}`} placeholder={searchLabel} autocomplete="off" />
    </label>
  )}
  <div class="archive-choice-options" role="group" aria-label={label}>
    {choices.map(choice => (
      <button type="button" data-filter-value={choice.value} aria-pressed={choice.value === selected ? 'true' : 'false'} disabled={choice.disabled} aria-controls="archive-list">
        <span>{choice.label}</span>{choice.count !== undefined && <small data-choice-count={choice.value}>{choice.count}</small>}
      </button>
    ))}
  </div>
</div>

<style>
  .archive-choices { min-width: 0; }
  select[hidden] { display: none; }
  h3 { margin: 0 0 12px; color: var(--site-ink); font: 500 1rem/1.5 var(--site-ui-font); }
  .archive-choice-options { display: flex; flex-wrap: wrap; align-content: start; gap: 4px 20px; }
  button { display: inline-flex; align-items: baseline; gap: 5px; min-height: 40px; max-width: 100%; padding: 7px 0; border: 0; border-bottom: 1px solid transparent; background: transparent; color: var(--site-muted); cursor: pointer; font: 0.9375rem/1.6 var(--site-ui-font); text-align: start; overflow-wrap: anywhere; }
  button[aria-pressed='true'] { color: var(--site-accent); border-bottom-color: currentColor; font-weight: 600; }
  button:hover { color: var(--site-accent); }
  button:disabled { opacity: .38; cursor: default; }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--site-focus-outline); outline-offset: 4px; }
  button[hidden] { display: none; }
  small { color: var(--site-subtle); font-size: 0.75rem; font-weight: 400; }
  .archive-choices--category .archive-choice-options { gap: 4px 25px; }
  .archive-choices--category button { min-height: 44px; padding: 10px 0 9px; font-size: 1rem; }
  .archive-choices--facet .archive-choice-options { max-height: 240px; overflow-y: auto; padding: 4px; margin: -4px; scrollbar-width: thin; }
  .archive-choices--facet button { scroll-margin-block-start: 48px; }
  .archive-choice-search { display: flex; align-items: center; gap: 9px; margin: 0 0 12px; border-bottom: 1px solid var(--site-border-soft); color: var(--site-subtle); }
  .archive-choice-search svg { flex-shrink: 0; }
  .archive-choice-search input { width: 100%; min-width: 0; min-height: 40px; padding: 5px 0; border: 0; border-radius: 0; background: transparent; color: var(--site-ink); font: 1rem/1.6 var(--site-ui-font); }
  .archive-choice-search input::placeholder { color: var(--site-subtle); opacity: 1; }
  .archive-choices--sort .archive-choice-options { display: grid; gap: 0; }
  .archive-choices--sort button { width: 100%; min-height: 44px; padding: 8px 0; border-bottom: 0; }
  .archive-choices--sort button[aria-pressed='true']::after { content: '✓'; margin-inline-start: auto; }
  @media (max-width: 700px) {
    .archive-choices--category .archive-choice-options { gap: 0 20px; }
    .archive-choices--category button { font-size: 0.9375rem; }
    .archive-choices--facet .archive-choice-options { max-height: 200px; }
  }
</style>
