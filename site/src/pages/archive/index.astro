---

import { t, getLocale, localizePath, canonicalPath } from '../../i18n/ui';
const locale = getLocale(Astro.url.pathname);
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumBrowseCard from '../../components/AlbumBrowseCard.astro';
import { createAlbumBrowseViews } from '../../data/album-browse';
import { archiveItems } from '../../data/archive';
import {
  archiveCategories,
  getArchiveCategorySlug,
} from '../../data/archive-categories';
import {
  createArchiveRecordView,
  isPublishedArchiveItem,
} from '../../data/archive-view';
import { getResponsiveImage } from '../../data/responsive-images';

const publishedViews = archiveItems
  .filter(isPublishedArchiveItem)
  .map(item => createArchiveRecordView(item, locale));
const albumBrowseViews = createAlbumBrowseViews(archiveItems, locale);
const albumKeyByItemId = new Map(albumBrowseViews.flatMap((album) => album.memberIds.map((id) => [id, album.slug] as const)));

// 目前只读取显示年代中出现的首个四位年份。将来遇到年份不明确的资料时，
// 它仍会显示在“全部年代”中，但不会被错误归入某个具体年代。
const availableDecades = [
  ...new Set(
    publishedViews
      .map((view) => view.decade)
      .filter((decade): decade is string => Boolean(decade)),
  ),
].sort((a, b) => Number(a) - Number(b));

const availablePlaces = [...new Set(publishedViews.flatMap((view) => view.placeFilters))];
const placeLabels = Object.assign({}, ...publishedViews.map(view => view.placeFilterLabels));
const tagLabels = Object.assign({}, ...publishedViews.map(view => view.tagLabels));
const availableTags = [...new Set(publishedViews.flatMap((view) => view.canonicalTags))];

// 列表卡片展示用标签：去掉与地点重复的标签，避免「珠海」同时出现在地点和标签里。
// 过滤规则：标签与 placeFilters 精确匹配，或标签是 placeDisplay 的子串，均视为重复。
const filterDisplayTags = (tags: string[], placeDisplay: string, placeFilters: string[]) =>
  tags.filter((tag) => !placeFilters.includes(tag) && !placeDisplay.includes(tag));
const decadeBrowseEntries = availableDecades.map((decade) => ({
  label: t("{0}年代", locale, {0: (decade)}),
  value: decade,
  count: publishedViews.filter((view) => view.decade === decade).length,
}));
const normalizePlaceLabel = (value: string) => value.trim().replace(/[省市区县]$/, '');
// “按地点浏览”取每条档案最能定位的一层结构化地点（优先市级），
// 含“未知”的层级跳过；再回匹配到该档案地点筛选值中的对应项。
const browsePlaceLevels = ['city', 'district', 'street_town', 'specific_place', 'province', 'country'] as const;
const browsePlaceMap = new Map<string, { label: string; value: string; count: number }>();
for (const view of publishedViews) {
  const preferred = browsePlaceLevels
    .map((field) => view.item.core[field]?.trim())
    .find((value): value is string => Boolean(value) && !value!.includes('未知'));
  if (!preferred) continue;
  const filterValue = view.placeFilters.find((place) => place === preferred)
    ?? view.placeFilters.find((place) => normalizePlaceLabel(place) === normalizePlaceLabel(preferred));
  if (!filterValue) continue;
  const existing = browsePlaceMap.get(filterValue);
  browsePlaceMap.set(filterValue, {
    label: view.placeFilterLabels[filterValue] ?? preferred,
    value: filterValue,
    count: (existing?.count ?? 0) + 1,
  });
}
const placeBrowseEntries = [...browsePlaceMap.values()]
  .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label, 'zh-CN'))
  .slice(0, 6);
// “最近收录”以首次录入日期为准；实物获得日期只在缺少录入日期时兜底。
// 同一天录入时继续比较更新时间、获得日期和永久编号，保证结果稳定。
const publishedEntries = [...publishedViews]
  .sort((left, right) => {
    const leftCreated = left.item.core.created_date?.trim() || left.item.core.accession_date?.trim() || '';
    const rightCreated = right.item.core.created_date?.trim() || right.item.core.accession_date?.trim() || '';
    const createdOrder = rightCreated.localeCompare(leftCreated);
    if (createdOrder !== 0) return createdOrder;
    const updatedOrder = (right.item.core.updated_date ?? '').localeCompare(left.item.core.updated_date ?? '');
    if (updatedOrder !== 0) return updatedOrder;
    const accessionOrder = (right.item.core.accession_date ?? '').localeCompare(left.item.core.accession_date ?? '');
    if (accessionOrder !== 0) return accessionOrder;
    return right.id.localeCompare(left.id, 'zh-CN', { numeric: true, sensitivity: 'base' });
  })
  .map((view) => ({
    view,
    coverImage: view.images[0] ? getResponsiveImage(view.images[0]) : undefined,
  }));
// 构建时生成的搜索索引：只包含公开展示层已有的文字字段，按永久编号索引。
// 转义所有“<”，避免档案文字中出现标签开头时截断脚本数据。
const searchIndexJson = JSON.stringify(
  publishedViews.map((view) => ({ id: view.id, fields: view.searchFields })),
).replaceAll('<', '\\u003c');
---

<BaseLayout
  title={t("档案｜老旧默片", locale)}
  description={t("浏览老旧默片收录的照片、纸张、卡片与普通生活痕迹。", locale)}
  image={publishedEntries[0]?.coverImage?.src}
>
  <div class="archive-page">
    <header class="archive-heading">
      <h1>{t("档案", locale)}</h1>
      <p class="introduction">{t("被时间留下来的照片、纸张、卡片与普通生活痕迹。", locale)}</p>
    </header>

    {(decadeBrowseEntries.length > 0 || placeBrowseEntries.length > 0) && (
      <details class="archive-paths" data-archive-paths open>
        <summary class="archive-paths-heading">
          <span class="archive-paths-title" id="archive-paths-heading">{t("按年代与地点浏览", locale)}</span>
          <span class="archive-paths-toggle" aria-hidden="true">{t("展开 / 收起", locale)}</span>
        </summary>
        <div class:list={{
          'archive-paths-grid': true,
          'is-single': decadeBrowseEntries.length === 0 || placeBrowseEntries.length === 0,
        }}>
          {decadeBrowseEntries.length > 0 && (
            <section class="archive-path-group" aria-labelledby="archive-decade-path-heading">
              <h3 id="archive-decade-path-heading">{t("按年代浏览", locale)}</h3>
              <div class="archive-path-links">
                {decadeBrowseEntries.map((entry) => (
                  <a href={localizePath(`/archive/?decade=${entry.value}&sort=date-asc`, locale)}>
                    <span>{t(entry.label, locale)}</span><small>{entry.count}</small>
                  </a>
                ))}
              </div>
            </section>
          )}
          {placeBrowseEntries.length > 0 && (
            <section class="archive-path-group" aria-labelledby="archive-place-path-heading">
              <h3 id="archive-place-path-heading">{t("按地点浏览", locale)}</h3>
              <div class="archive-path-links">
                {placeBrowseEntries.map((entry) => (
                  <a href={localizePath(`/archive/?place=${encodeURIComponent(entry.value)}`, locale)}>
                    <span>{t(entry.label, locale)}</span><small>{entry.count}</small>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>
      </details>
    )}

    <section
      class="archive-index"
      aria-label={t("档案目录", locale)}
      data-archive-page-size="12"
    >
      <header class="archive-index-heading">
        <div class="archive-index-title">
          <div><h2>{t("查找档案", locale)}</h2></div>
        </div>
      </header>
      <nav class="archive-view-modes" aria-label={t('浏览方式', locale)}>
        <a href={localizePath('/archive/', locale)} data-archive-view="grouped" aria-current="page">{t('相册与单件', locale)}</a>
        <a href={localizePath('/archive/?view=albums', locale)} data-archive-view="albums">{t('仅看相册', locale)}</a>
        <a href={localizePath('/archive/?view=items', locale)} data-archive-view="items">{t('逐件查看全部档案', locale)}</a>
      </nav>
      <p class="archive-view-note">{t('同册档案默认收拢，进入相册后逐件查看。数量始终按真实档案件数统计，含相册总档案。', locale)}</p>
      <div class="archive-controls" aria-label={t("档案搜索与筛选", locale)}>
        <div class="archive-control">
          <label for="archive-search">{t("关键词搜索", locale)}</label>
          <input
            id="archive-search"
            type="search"
            placeholder={t("题名、地点或关键词", locale)}
            autocomplete="off"
            spellcheck={false}
            aria-controls="archive-list"
          />
          <div class="archive-search-assist" id="archive-search-assist" hidden>
            <span>{t("相关线索", locale)}</span>
            <div id="archive-search-suggestions"></div>
          </div>
        </div>

        <div class="archive-control">
          <label for="archive-category">{t("藏品分类", locale)}</label>
          <select id="archive-category" aria-controls="archive-list">
            <option value="">{t("全部分类", locale)}</option>
            {archiveCategories.map((category) => (
              <option
                value={category.slug}
                data-object-types={category.objectTypes.join('|')}
              >
                {t(category.label, locale)}
              </option>
            ))}
          </select>
        </div>

        <div class="archive-control">
          <label for="archive-sort">{t("排序方式", locale)}</label>
          <select id="archive-sort" aria-controls="archive-list">
            <option value="relevance" disabled>{t("按相关度", locale)}</option>
            <option value="recent">{t("最近收录", locale)}</option>
            <option value="likes">{t("最多点赞", locale)}</option>
            <option value="date-asc">{t("年代从早到晚", locale)}</option>
            <option value="date-desc">{t("年代从晚到早", locale)}</option>
            <option value="type">{t("按藏品类型", locale)}</option>
          </select>
        </div>

        <details class="archive-more-filters" id="archive-more-filters">
          <summary><span>{t("更多筛选", locale)}</span><small id="archive-more-summary">{t("年代、地点、标签", locale)}</small></summary>
          <div class="archive-secondary-controls">
            <div class="archive-control">
              <label for="archive-decade">{t("年代", locale)}</label>
              <select id="archive-decade" aria-controls="archive-list">
                <option value="">{t("全部年代", locale)}</option>
                {availableDecades.map((decade) => <option value={decade}>{t('{0}年代',locale,{0:decade})}</option>)}
              </select>
            </div>

            <div class="archive-control">
              <label for="archive-place">{t("地点", locale)}</label>
              <select id="archive-place" aria-controls="archive-list">
                <option value="">{t("全部地点", locale)}</option>
                {availablePlaces.map((place) => <option value={place}>{placeLabels[place] ?? place}</option>)}
              </select>
            </div>

            <div class="archive-control">
              <label for="archive-tag">{t("标签", locale)}</label>
              <select id="archive-tag" aria-controls="archive-list">
                <option value="">{t("全部标签", locale)}</option>
                {availableTags.map((tag) => <option value={tag}>{tagLabels[tag] ?? tag}</option>)}
              </select>
            </div>
          </div>
        </details>
      </div>

      <div class="archive-actions" id="archive-actions" hidden>
        <div class="active-filters" aria-label={t("当前筛选条件", locale)}>
          <span>{t("当前筛选", locale)}</span>
          <div id="archive-filter-chips"></div>
        </div>
        <button class="clear-filters ui-text-link" id="archive-clear" type="button" aria-controls="archive-list">
          {t("清除全部", locale)}
        </button>
      </div>

      <p
        class="results-summary"
        id="archive-results-summary"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {t("共", locale)} {publishedViews.length} {t("件档案", locale)}
      </p>

      <div class="archive-empty-state" id="archive-empty-state" hidden>
        <h2 id="archive-empty-title">{t("没有找到符合条件的档案", locale)}</h2>
        <span id="archive-empty-description">{t("可以减少筛选条件，或清除后浏览全部档案。", locale)}</span>
        <button class="ui-action ui-action--secondary" id="archive-empty-clear" type="button">{t("清除全部筛选", locale)}</button>
      </div>

      <ul class="archive-list" id="archive-list">
        {albumBrowseViews.map((album) => (
          <li data-archive-album-card={album.slug} data-album-record-count={album.recordCount}>
            <AlbumBrowseCard album={album} locale={locale} showMatches />
            <ul class="album-matched-items" data-album-matched-items hidden></ul>
          </li>
        ))}
        {
          publishedEntries.map(({ view, coverImage }, originalIndex) => (
            <li
              data-archive-item
              data-archive-album-key={albumKeyByItemId.get(view.id)}
              hidden={albumKeyByItemId.has(view.id)}
              data-archive-category={getArchiveCategorySlug(view.objectType)}
              data-archive-decade={view.decade}
              data-archive-places={`|${view.placeFilters.join('|')}|`}
              data-archive-tags={`|${view.canonicalTags.join('|')}|`}
              data-archive-id={view.id}
              data-archive-accession={view.item.core.accession_date ?? ''}
              data-archive-year={view.item.core.date_display.match(/\d{4}/)?.[0] ?? ''}
              data-archive-type-label={view.typeLabel}
              data-archive-title={view.title}
              data-archive-original-index={originalIndex}
            >
              <a
                class="archive-entry"
                href={localizePath(`/archive/${view.id}/`, locale)}
                aria-label={t("查看档案：{0}", locale, {0: (view.title)})}
                data-archive-entry
              >
                <figure class="archive-image">
                  {coverImage && (
                    <img
                      src={coverImage.src}
                      srcset={coverImage.srcset}
                      sizes="(max-width: 700px) calc(100vw - 32px), 400px"
                      alt={view.imageDescriptions[0]}
                      width={coverImage.width}
                      height={coverImage.height}
                      loading={originalIndex === 0 ? 'eager' : 'lazy'}
                      fetchpriority={originalIndex === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  )}
                </figure>

                <div class="archive-information">
                  <h2 data-search-highlight>{view.title}</h2>

                  {view.description && <p class="archive-description" data-search-highlight>{view.description}</p>}

                  <dl class="archive-facts">
                    <div>
                      <dt>{t("类型", locale)}</dt>
                      <dd data-search-highlight>{view.typeLabel}</dd>
                    </div>
                    <div>
                      <dt>{t("年代", locale)}</dt>
                      <dd data-search-highlight>{view.dateDisplay}</dd>
                    </div>
                    <div>
                      <dt>{t("地点", locale)}</dt>
                      <dd data-search-highlight>{view.placeDisplay}</dd>
                    </div>
                  </dl>

                  <ul class="archive-tags" aria-label={t("标签", locale)}>
                    {filterDisplayTags(view.tags, view.placeDisplay, view.placeFilters).map((tag) => <li data-search-highlight>{tag}</li>)}
                  </ul>

                  <p class="archive-match-reason" data-match-reason hidden></p>

                  <span class="archive-entry-action" aria-hidden="true">{t("查看档案 →", locale)}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <nav class="archive-pagination" id="archive-pagination" aria-label={t("档案分页", locale)} hidden>
        <p id="archive-page-summary"></p>
        <div>
          <button class="ui-action ui-action--secondary" id="archive-page-previous" type="button">{t("← 上一页", locale)}</button>
          <span id="archive-page-numbers" aria-label={t("页码", locale)}></span>
          <button class="ui-action ui-action--secondary" id="archive-page-next" type="button">{t("下一页 →", locale)}</button>
        </div>
      </nav>
      <script type="application/json" id="archive-search-index" set:html={searchIndexJson} />
    </section>
  </div>
</BaseLayout>

<script>
import {clientText as ct,clientPath,clientLocale} from '../../i18n/client';

import '../../scripts/archive-likes';
  import {
    SEARCH_FIELD_LABELS,
    normalizeSearchText,
    scoreEntryAgainstFields,
    searchTermsFrom,
    type ArchiveSearchMatch,
  } from '../../scripts/archive-search';
  import type { ArchiveSearchFields } from '../../data/archive-view';
  import { groupArchiveMatches } from '../../data/archive-browse.mjs';

  const archiveIndex = document.querySelector<HTMLElement>('.archive-index');
  const searchInput = document.querySelector<HTMLInputElement>('#archive-search');
  const browsePaths = document.querySelector<HTMLDetailsElement>('[data-archive-paths]');
  const narrowScreen = window.matchMedia('(max-width: 700px)');
  const syncBrowsePaths = () => { if (browsePaths) browsePaths.open = !narrowScreen.matches; };
  syncBrowsePaths();
  narrowScreen.addEventListener('change', syncBrowsePaths);
  const categorySelect = document.querySelector<HTMLSelectElement>('#archive-category');
  const sortSelect = document.querySelector<HTMLSelectElement>('#archive-sort');
  const decadeSelect = document.querySelector<HTMLSelectElement>('#archive-decade');
  const placeSelect = document.querySelector<HTMLSelectElement>('#archive-place');
  const tagSelect = document.querySelector<HTMLSelectElement>('#archive-tag');
  const clearFiltersButton = document.querySelector<HTMLButtonElement>('#archive-clear');
  const archiveActions = document.querySelector<HTMLElement>('#archive-actions');
  const moreFilters = document.querySelector<HTMLDetailsElement>('#archive-more-filters');
  const moreFiltersSummary = document.querySelector<HTMLElement>('#archive-more-summary');
  const filterChips = document.querySelector<HTMLElement>('#archive-filter-chips');
  const emptyState = document.querySelector<HTMLElement>('#archive-empty-state');
  const emptyTitle = document.querySelector<HTMLElement>('#archive-empty-title');
  const emptyDescription = document.querySelector<HTMLElement>('#archive-empty-description');
  const emptyClearButton = document.querySelector<HTMLButtonElement>('#archive-empty-clear');
  const searchAssist = document.querySelector<HTMLElement>('#archive-search-assist');
  const searchSuggestions = document.querySelector<HTMLElement>('#archive-search-suggestions');
  const archiveList = document.querySelector<HTMLElement>('#archive-list');
  const resultsSummary = document.querySelector<HTMLElement>('#archive-results-summary');
  const pagination = document.querySelector<HTMLElement>('#archive-pagination');
  const pageSummary = document.querySelector<HTMLElement>('#archive-page-summary');
  const previousPageButton = document.querySelector<HTMLButtonElement>('#archive-page-previous');
  const nextPageButton = document.querySelector<HTMLButtonElement>('#archive-page-next');
  const pageNumbers = document.querySelector<HTMLElement>('#archive-page-numbers');
  const archiveEntries = Array.from(document.querySelectorAll<HTMLElement>('[data-archive-item]'));
  const albumCards = new Map(Array.from(document.querySelectorAll<HTMLElement>('[data-archive-album-card]'))
    .map((entry) => [entry.dataset.archiveAlbumCard!, entry]));
  const entriesById = new Map(archiveEntries.map((entry) => [entry.dataset.archiveId!, entry]));
  const viewModeLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-archive-view]'));
  const requestedViewMode = new URLSearchParams(window.location.search).get('view');
  let viewMode = requestedViewMode === 'albums' || requestedViewMode === 'items' ? requestedViewMode : 'grouped';
  const highlightOriginalText = new WeakMap<HTMLElement, string>();
  const browseStateKey = 'ljm-archive-browse-state';
  const pageSize = Math.max(1, Number(archiveIndex?.dataset.archivePageSize) || 12);
  let currentPage = 1;
  // 访客手动选择过排序方式后，不再自动切换到“按相关度”。
  let userChosenSort = false;
  // 「最多点赞」排序使用的计数：由点赞脚本在拿到计数后逐件通知本页。
  const likeCounts = new Map<string, number>();
  let likesAvailable = true;

  document.addEventListener('archive-likes-updated', (event) => {
    const detail = (event as CustomEvent<{ itemId?: string; count?: number }>).detail;
    if (!detail?.itemId || !Number.isInteger(detail.count) || (detail.count ?? -1) < 0) return;
    likeCounts.set(detail.itemId, detail.count ?? 0);
    // 计数到达后如果正按点赞排序，立即按最新计数重排（包括刚点赞的那件）。
    if (sortSelect?.value === 'likes') updateArchiveResults();
  });

  document.addEventListener('archive-likes-unavailable', () => {
    likesAvailable = false;
    syncLikesSortOption();
    if (sortSelect?.value === 'likes') {
      sortSelect.value = 'recent';
      userChosenSort = false;
      updateArchiveResults();
      updateFiltersInAddress();
    }
  });

  const syncLikesSortOption = () => {
    const likesOption = sortSelect?.querySelector<HTMLOptionElement>('option[value="likes"]');
    if (likesOption) likesOption.disabled = !likesAvailable;
  };

  // 构建时写入页面的搜索索引：永久编号 → 分字段搜索文字。
  const searchFieldsByItemId = new Map<string, ArchiveSearchFields>();
  try {
    const indexElement = document.querySelector<HTMLElement>('#archive-search-index');
    const entries = JSON.parse(indexElement?.textContent ?? '[]') as Array<{ id: string; fields: ArchiveSearchFields }>;
    for (const entry of entries) {
      if (entry?.id && entry.fields) searchFieldsByItemId.set(entry.id, entry.fields);
    }
  } catch {
    // 索引损坏时搜索退化为“找不到结果”，不影响分类、年代等结构化筛选。
  }

  const splitDataValues = (value: string | undefined) => (value ?? '').split('|').filter(Boolean);

  const setAddressParameter = (url: URL, name: string, value: string) => {
    if (value) url.searchParams.set(name, value);
    else url.searchParams.delete(name);
  };

  const updateFiltersInAddress = () => {
    if (!searchInput || !categorySelect || !sortSelect || !decadeSelect || !placeSelect || !tagSelect) return;
    const url = new URL(window.location.href);
    url.searchParams.delete('type');
    setAddressParameter(url, 'q', searchInput.value.trim());
    setAddressParameter(url, 'category', categorySelect.value);
    setAddressParameter(url, 'decade', decadeSelect.value);
    setAddressParameter(url, 'place', placeSelect.value);
    setAddressParameter(url, 'tag', tagSelect.value);
    url.searchParams.delete('topic');
    setAddressParameter(url, 'sort', sortSelect.value === 'recent' ? '' : sortSelect.value);
    setAddressParameter(url, 'page', currentPage > 1 ? String(currentPage) : '');
    setAddressParameter(url, 'view', viewMode === 'grouped' ? '' : viewMode);
    window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    for (const link of viewModeLinks) {
      const destination = new URL(url);
      setAddressParameter(destination, 'view', link.dataset.archiveView === 'grouped' ? '' : link.dataset.archiveView ?? '');
      destination.searchParams.delete('page');
      link.href = `${destination.pathname}${destination.search}`;
      if (link.dataset.archiveView === viewMode) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    }
  };

  const currentBrowseHref = () => `${window.location.pathname}${window.location.search}`;

  const renderActiveFilterChips = () => {
    if (!filterChips || !searchInput || !categorySelect || !decadeSelect || !placeSelect || !tagSelect) return;
    const definitions = [
      { key: 'q', label: ct("关键词"), value: searchInput.value.trim() },
      { key: 'category', label: ct("分类"), value: categorySelect.value ? categorySelect.selectedOptions[0]?.textContent?.trim() ?? '' : '' },
      { key: 'decade', label: ct("年代"), value: decadeSelect.value ? ct("{0}年代", {0: (decadeSelect.value)}) : '' },
      { key: 'place', label: ct("地点"), value: placeSelect.value ? placeSelect.selectedOptions[0]?.textContent?.trim() ?? placeSelect.value : '' },
      { key: 'tag', label: ct("标签"), value: tagSelect.value ? tagSelect.selectedOptions[0]?.textContent?.trim() ?? tagSelect.value : '' },
    ].filter((definition) => definition.value);

    filterChips.replaceChildren(...definitions.map((definition) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.clearFilter = definition.key;
      button.textContent = `${definition.label}${clientLocale() === 'en' ? ': ' : '：'}${definition.value} ×`;
      button.setAttribute('aria-label', ct("移除{0}筛选：{1}", {0: (definition.label), 1: (definition.value)}));
      return button;
    }));
  };

  const saveBrowseState = (targetId = '', targetAlbumSlug = '') => {
    try {
      window.sessionStorage.setItem(
        browseStateKey,
        JSON.stringify({ href: currentBrowseHref(), scrollY: window.scrollY, targetId, targetAlbumSlug, restorePending: false }),
      );
    } catch {
      // 浏览器禁用会话存储时，网址中的筛选条件仍然可以独立恢复。
    }
  };

  const compareText = (left: string, right: string) =>
    left.localeCompare(right, clientLocale(), { numeric: true, sensitivity: 'base' });

  // 页面在构建时已经按首次录入日期排好，浏览器只需恢复这份稳定次序。
  const compareRecentEntries = (left: HTMLElement, right: HTMLElement) =>
    Number(left.dataset.archiveOriginalIndex ?? 0) - Number(right.dataset.archiveOriginalIndex ?? 0);

  const sortArchiveEntries = (scoreMap: Map<HTMLElement, ArchiveSearchMatch>) => {
    if (!sortSelect || !archiveList) return;
    const sortMode = sortSelect.value;
    archiveEntries.sort((left, right) => {
      const leftYear = Number(left.dataset.archiveYear);
      const rightYear = Number(right.dataset.archiveYear);
      const leftHasYear = Number.isFinite(leftYear) && leftYear > 0;
      const rightHasYear = Number.isFinite(rightYear) && rightYear > 0;
      if (sortMode === 'relevance') {
        // 没有关键词时所有条目得分一致，自然落到“最近收录”的次序。
        const leftScore = scoreMap.get(left)?.score ?? -1;
        const rightScore = scoreMap.get(right)?.score ?? -1;
        if (leftScore !== rightScore) return rightScore - leftScore;
        const recentOrder = compareRecentEntries(left, right);
        if (recentOrder !== 0) return recentOrder;
      } else if (sortMode === 'likes') {
        // 点赞多的在前；计数一致时沿用“最近收录”的稳定次序。
        const leftCount = likeCounts.get(left.dataset.archiveId ?? '') ?? 0;
        const rightCount = likeCounts.get(right.dataset.archiveId ?? '') ?? 0;
        if (leftCount !== rightCount) return rightCount - leftCount;
        const recentOrder = compareRecentEntries(left, right);
        if (recentOrder !== 0) return recentOrder;
      } else if (sortMode === 'date-asc' || sortMode === 'date-desc') {
        if (leftHasYear !== rightHasYear) return leftHasYear ? -1 : 1;
        if (leftHasYear && rightHasYear && leftYear !== rightYear) {
          return sortMode === 'date-asc' ? leftYear - rightYear : rightYear - leftYear;
        }
      } else if (sortMode === 'type') {
        const typeOrder = compareText(left.dataset.archiveTypeLabel ?? '', right.dataset.archiveTypeLabel ?? '');
        if (typeOrder !== 0) return typeOrder;
      } else {
        const recentOrder = compareRecentEntries(left, right);
        if (recentOrder !== 0) return recentOrder;
      }
      const titleOrder = compareText(left.dataset.archiveTitle ?? '', right.dataset.archiveTitle ?? '');
      if (titleOrder !== 0) return titleOrder;
      return Number(left.dataset.archiveOriginalIndex ?? 0) - Number(right.dataset.archiveOriginalIndex ?? 0);
    });
    archiveList.append(...archiveEntries);
  };

  const renderSearchHighlights = (terms: string[]) => {
    document.querySelectorAll<HTMLElement>('[data-search-highlight]').forEach((element) => {
      if (!highlightOriginalText.has(element)) highlightOriginalText.set(element, element.textContent ?? '');
      const original = highlightOriginalText.get(element) ?? '';
      element.replaceChildren();
      if (!terms.length || !original) {
        element.textContent = original;
        return;
      }
      const normalized = original.toLocaleLowerCase(clientLocale());
      const ranges: Array<[number, number]> = [];
      for (const term of terms) {
        let fromIndex = 0;
        while (fromIndex < normalized.length) {
          const matchIndex = normalized.indexOf(term, fromIndex);
          if (matchIndex < 0) break;
          ranges.push([matchIndex, matchIndex + term.length]);
          fromIndex = matchIndex + Math.max(1, term.length);
        }
      }
      ranges.sort((left, right) => left[0] - right[0]);
      const merged = ranges.reduce<Array<[number, number]>>((result, range) => {
        const previous = result.at(-1);
        if (previous && range[0] <= previous[1]) previous[1] = Math.max(previous[1], range[1]);
        else result.push([...range]);
        return result;
      }, []);
      if (!merged.length) {
        element.textContent = original;
        return;
      }
      let cursor = 0;
      for (const [start, end] of merged) {
        if (start > cursor) element.append(document.createTextNode(original.slice(cursor, start)));
        const mark = document.createElement('mark');
        mark.textContent = original.slice(start, end);
        element.append(mark);
        cursor = end;
      }
      if (cursor < original.length) element.append(document.createTextNode(original.slice(cursor)));
    });
  };

  const renderMatchReasons = (scoreMap: Map<HTMLElement, ArchiveSearchMatch>, hasTerms: boolean) => {
    for (const entry of archiveEntries) {
      const reason = entry.querySelector<HTMLElement>('[data-match-reason]');
      if (!reason) continue;
      const match = scoreMap.get(entry);
      if (!hasTerms || !match) {
        reason.hidden = true;
        reason.textContent = '';
        continue;
      }
      reason.hidden = false;
      reason.textContent = ct("匹配：{0}", {0: (match.matchedFields.map((field) => SEARCH_FIELD_LABELS[field]).join(' · '))});
    }
  };

  // 输入关键词时把“按相关度”开放为可用排序；此前未手动选过排序时自动切换。
  // 清空关键词后关闭该选项，并恢复默认的“最近收录”。
  const syncRelevanceSort = (hasTerms: boolean) => {
    if (!sortSelect) return;
    const relevanceOption = sortSelect.querySelector<HTMLOptionElement>('option[value="relevance"]');
    if (!relevanceOption) return;
    if (hasTerms) {
      relevanceOption.disabled = false;
      if (!userChosenSort && sortSelect.value === 'recent') sortSelect.value = 'relevance';
    } else {
      relevanceOption.disabled = true;
      if (sortSelect.value === 'relevance') {
        sortSelect.value = 'recent';
        userChosenSort = false;
      }
    }
  };

  const renderSearchSuggestions = (matchingEntries: HTMLElement[], terms: string[]) => {
    if (!searchAssist || !searchSuggestions || !tagSelect || !terms.length) {
      if (searchAssist) searchAssist.hidden = true;
      return;
    }
    const tagCounts = new Map<string, number>();
    for (const entry of matchingEntries) {
      for (const tag of splitDataValues(entry.dataset.archiveTags)) {
        if (tag === tagSelect.value) continue;
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
      }
    }
    const tagLabel = (value: string) => Array.from(tagSelect.options).find((option) => option.value === value)?.textContent?.trim() ?? value;
    const suggestions = [...tagCounts.entries()]
      .sort((left, right) => {
        const leftNear = terms.some((term) => normalizeSearchText(tagLabel(left[0])).includes(term));
        const rightNear = terms.some((term) => normalizeSearchText(tagLabel(right[0])).includes(term));
        return Number(rightNear) - Number(leftNear) || right[1] - left[1] || compareText(left[0], right[0]);
      })
      .slice(0, 5);
    searchSuggestions.replaceChildren(...suggestions.map(([tag, count]) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.suggestedTag = tag;
      button.textContent = `${tagLabel(tag)} · ${count}`;
      button.setAttribute('aria-label', ct("按相关标签“{0}”继续筛选", {0: (tagLabel(tag))}));
      return button;
    }));
    searchAssist.hidden = suggestions.length === 0;
  };

  const renderPagination = (matchingEntries: HTMLElement[]) => {
    const totalPages = Math.max(1, Math.ceil(matchingEntries.length / pageSize));
    currentPage = Math.min(Math.max(1, currentPage), totalPages);
    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, matchingEntries.length);
    matchingEntries.forEach((entry, index) => {
      entry.hidden = index < startIndex || index >= endIndex;
    });
    if (!pagination || !pageSummary || !previousPageButton || !nextPageButton || !pageNumbers) {
      return { startIndex, endIndex, totalPages };
    }
    pagination.hidden = totalPages <= 1;
    pageSummary.textContent = ct("第 {0} 页，共 {1} 页", {0: (currentPage), 1: (totalPages)});
    previousPageButton.disabled = currentPage <= 1;
    nextPageButton.disabled = currentPage >= totalPages;
    pageNumbers.replaceChildren(...Array.from({ length: totalPages }, (_, index) => {
      const page = index + 1;
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.archivePage = String(page);
      button.textContent = String(page);
      button.setAttribute('aria-label', ct("前往第 {0} 页", {0: (page)}));
      if (page === currentPage) button.setAttribute('aria-current', 'page');
      return button;
    }));
    return { startIndex, endIndex, totalPages };
  };

  const updateArchiveResults = () => {
    if (!searchInput || !categorySelect || !sortSelect || !decadeSelect || !placeSelect || !tagSelect || !resultsSummary) return;
    const terms = searchTermsFrom(searchInput.value);
    syncRelevanceSort(terms.length > 0);
    const selectedCategory = categorySelect.value;
    const selectedDecade = decadeSelect.value;
    const selectedPlace = placeSelect.value;
    const selectedTag = tagSelect.value;
    const scoreMap = new Map<HTMLElement, ArchiveSearchMatch>();
    const initialMatches = archiveEntries.filter((entry) => {
      const fields = searchFieldsByItemId.get(entry.dataset.archiveId ?? '');
      const keywordMatch = terms.length === 0
        ? { score: 0, matchedFields: [] }
        : fields
          ? scoreEntryAgainstFields(terms, fields)
          : null;
      const matchesCategory = !selectedCategory || entry.dataset.archiveCategory === selectedCategory;
      const matchesDecade = !selectedDecade || entry.dataset.archiveDecade === selectedDecade;
      const matchesPlace = !selectedPlace || (entry.dataset.archivePlaces ?? '').includes(`|${selectedPlace}|`);
      const matchesTag = !selectedTag || (entry.dataset.archiveTags ?? '').includes(`|${selectedTag}|`);
      const isMatch = keywordMatch !== null && matchesCategory && matchesDecade && matchesPlace && matchesTag;
      if (isMatch && terms.length > 0 && keywordMatch) scoreMap.set(entry, keywordMatch);
      entry.hidden = !isMatch;
      return isMatch;
    });
    // 按真实档案筛选、排序后才收拢，不能拿甲的年代和乙的地点拼成一次命中。
    sortArchiveEntries(scoreMap);
    const matchedIds = new Set(initialMatches.map((entry) => entry.dataset.archiveId));
    const matchingEntries = archiveEntries.filter((entry) => matchedIds.has(entry.dataset.archiveId)
      && (viewMode !== 'albums' || Boolean(entry.dataset.archiveAlbumKey)));
    const displayGroups = groupArchiveMatches(matchingEntries.map((entry) => ({
      id: entry.dataset.archiveId!, albumKey: entry.dataset.archiveAlbumKey,
    })), viewMode);
    archiveEntries.forEach((entry) => { entry.hidden = true; });
    albumCards.forEach((entry) => { entry.hidden = true; });
    const hasActiveFilters = terms.length > 0 || Boolean(selectedCategory || selectedDecade || selectedPlace || selectedTag);
    const displayEntries: HTMLElement[] = [];
    for (const group of displayGroups) {
      const entry = group.kind === 'album' ? albumCards.get(group.key) : entriesById.get(group.key);
      if (!entry) continue;
      displayEntries.push(entry);
      if (group.kind !== 'album') continue;
      const matchSummary = entry.querySelector<HTMLElement>('[data-album-matches]');
      if (matchSummary) matchSummary.textContent = ct('命中 {0} 件 / 册内共 {1} 件公开档案', {
        0: group.memberIds.length, 1: entry.dataset.albumRecordCount ?? '',
      });
      const matchedItems = entry.querySelector<HTMLElement>('[data-album-matched-items]');
      if (matchedItems) {
        matchedItems.hidden = !hasActiveFilters;
        matchedItems.replaceChildren(...group.memberIds.slice(0, 3).flatMap((id: string) => {
          const member = entriesById.get(id);
          const memberLink = member?.querySelector<HTMLAnchorElement>('[data-archive-entry]');
          if (!memberLink) return [];
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = memberLink.href;
          link.textContent = member?.dataset.archiveTitle ?? id;
          link.dataset.archiveEntry = '';
          link.dataset.matchItemId = id;
          li.append(link);
          return [li];
        }));
      }
    }
    archiveList?.append(...displayEntries);
    renderSearchHighlights(terms);
    renderMatchReasons(scoreMap, terms.length > 0);
    renderSearchSuggestions(matchingEntries, terms);
    const pageState = renderPagination(displayEntries);
    const advancedFilterCount = [selectedDecade, selectedPlace, selectedTag].filter(Boolean).length;
    if (moreFiltersSummary) moreFiltersSummary.textContent = advancedFilterCount ? ct("已选 {0} 项", {0: (advancedFilterCount)}) : ct("年代、地点、标签");
    if (archiveActions) archiveActions.hidden = !hasActiveFilters;
    renderActiveFilterChips();
    if (emptyState) emptyState.hidden = matchingEntries.length !== 0;
    if (!matchingEntries.length) {
      const hasOnlyCategoryFilter = Boolean(selectedCategory) && !terms.length && !selectedDecade && !selectedPlace && !selectedTag;
      const hasKeywordFilter = terms.length > 0;
      resultsSummary.textContent = hasOnlyCategoryFilter ? ct("当前暂无此类档案。") : ct("没有找到符合条件的档案。");
      if (viewMode === 'albums') {
        resultsSummary.textContent = ct('没有找到符合条件的相册。');
        if (emptyTitle) emptyTitle.textContent = ct('没有找到符合条件的相册。');
        if (emptyDescription) emptyDescription.textContent = ct('可以清除筛选，或切换到“相册与单件”浏览其他档案。');
        return;
      }
      if (emptyTitle) emptyTitle.textContent = hasOnlyCategoryFilter ? ct("这个分类还没有公开档案") : ct("没有找到符合条件的档案");
      if (emptyDescription) emptyDescription.textContent = hasOnlyCategoryFilter
        ? ct("可以先浏览其他分类；新内容通过发布检查后会出现在这里。")
        : hasKeywordFilter
          ? ct("可以换一个更短的关键词、减少同时搜索的词数，或清除后浏览全部档案。")
          : ct("可以移除部分筛选条件，或清除后浏览全部档案。");
      return;
    }
    const rangeText = pageState.totalPages > 1 ? ct('，本页显示第 {0}–{1} 个浏览入口', { 0: pageState.startIndex + 1, 1: pageState.endIndex }) : '';
    const albumCount = displayGroups.filter((group) => group.kind === 'album').length;
    const itemCount = displayGroups.filter((group) => group.kind === 'item').length;
    resultsSummary.textContent = viewMode === 'items'
      ? ct('{0} {1} 件档案 · 逐件展示{2}', {0: hasActiveFilters ? ct('找到') : ct('共'), 1: matchingEntries.length, 2: rangeText})
      : ct('{0} {1} 件档案 · {2} 本相册、{3} 件未归册档案{4}', {
      0: hasActiveFilters ? ct('找到') : ct('共'), 1: matchingEntries.length,
      2: albumCount, 3: itemCount, 4: rangeText,
    });
  };

  const applyFilterChange = () => {
    currentPage = 1;
    updateArchiveResults();
    updateFiltersInAddress();
    saveBrowseState();
  };

  searchInput?.addEventListener('input', applyFilterChange);
  for (const link of viewModeLinks) link.addEventListener('click', (event) => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
    event.preventDefault();
    viewMode = link.dataset.archiveView ?? 'grouped';
    applyFilterChange();
  });
  categorySelect?.addEventListener('change', applyFilterChange);
  sortSelect?.addEventListener('change', () => {
    userChosenSort = true;
    applyFilterChange();
  });
  decadeSelect?.addEventListener('change', applyFilterChange);
  placeSelect?.addEventListener('change', applyFilterChange);
  tagSelect?.addEventListener('change', applyFilterChange);

  searchSuggestions?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-suggested-tag]');
    if (!button || !tagSelect) return;
    tagSelect.value = button.dataset.suggestedTag ?? '';
    applyFilterChange();
  });

  const clearAllFilters = () => {
    if (!searchInput || !categorySelect || !decadeSelect || !placeSelect || !tagSelect) return;
    searchInput.value = '';
    categorySelect.value = '';
    decadeSelect.value = '';
    placeSelect.value = '';
    tagSelect.value = '';
    currentPage = 1;
    if (moreFilters) moreFilters.open = false;
    updateArchiveResults();
    updateFiltersInAddress();
    saveBrowseState();
    searchInput.focus();
  };

  clearFiltersButton?.addEventListener('click', clearAllFilters);
  emptyClearButton?.addEventListener('click', clearAllFilters);

  filterChips?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-clear-filter]');
    if (!button || !searchInput || !categorySelect || !decadeSelect || !placeSelect || !tagSelect) return;
    const controls = { q: searchInput, category: categorySelect, decade: decadeSelect, place: placeSelect, tag: tagSelect };
    const control = controls[button.dataset.clearFilter as keyof typeof controls];
    if (!control) return;
    control.value = '';
    control.focus();
    applyFilterChange();
  });

  const changePage = (page: number) => {
    currentPage = page;
    updateArchiveResults();
    updateFiltersInAddress();
    saveBrowseState();
    resultsSummary?.scrollIntoView({ behavior: 'auto', block: 'start' });
  };
  previousPageButton?.addEventListener('click', () => changePage(currentPage - 1));
  nextPageButton?.addEventListener('click', () => changePage(currentPage + 1));
  pageNumbers?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-archive-page]');
    if (button) changePage(Number(button.dataset.archivePage));
  });

  const addressParameters = new URLSearchParams(window.location.search);
  const requestedKeyword = addressParameters.get('q');
  const requestedCategory = addressParameters.get('category');
  const requestedType = addressParameters.get('type');
  const requestedDecade = addressParameters.get('decade');
  const requestedPlace = addressParameters.get('place');
  const requestedTag = addressParameters.get('tag');
  const requestedSort = addressParameters.get('sort');
  const requestedPage = Number(addressParameters.get('page'));
  const categoryOptions = Array.from(categorySelect?.options ?? []);
  const hasRequestedCategory = categoryOptions.some((option) => option.value === requestedCategory);
  const selectRequestedValue = (select: HTMLSelectElement | null, value: string | null) => {
    if (select && value && Array.from(select.options).some((option) => option.value === value)) select.value = value;
  };

  if (searchInput && requestedKeyword) searchInput.value = requestedKeyword;
  selectRequestedValue(decadeSelect, requestedDecade);
  selectRequestedValue(placeSelect, requestedPlace);
  selectRequestedValue(tagSelect, requestedTag);
  selectRequestedValue(sortSelect, requestedSort);
  if (Number.isInteger(requestedPage) && requestedPage > 0) currentPage = requestedPage;
  if (categorySelect && requestedCategory && hasRequestedCategory) categorySelect.value = requestedCategory;
  else if (categorySelect && requestedType) {
    const legacyTypeCategory = categoryOptions.find((option) => (option.dataset.objectTypes ?? '').split('|').includes(requestedType));
    if (legacyTypeCategory) categorySelect.value = legacyTypeCategory.value;
  }
  if (moreFilters && [decadeSelect?.value, placeSelect?.value, tagSelect?.value].some(Boolean)) moreFilters.open = true;

  updateArchiveResults();
  updateFiltersInAddress();

  archiveList?.addEventListener('click', (event) => {
    const entryLink = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-archive-entry], [data-album-entry]');
    if (!entryLink) return;
    const targetId = entryLink.dataset.matchItemId ?? entryLink.closest<HTMLElement>('[data-archive-id]')?.dataset.archiveId ?? '';
    const albumSlug = entryLink.closest<HTMLElement>('[data-archive-album-card]')?.dataset.archiveAlbumCard ?? '';
    saveBrowseState(targetId, albumSlug);
  });

  try {
    const storedState = JSON.parse(window.sessionStorage.getItem(browseStateKey) ?? 'null');
    if (storedState?.restorePending === true && storedState.href === currentBrowseHref() && Number.isFinite(storedState.scrollY)) {
      window.requestAnimationFrame(() => window.scrollTo({ top: storedState.scrollY, behavior: 'auto' }));
      window.sessionStorage.setItem(browseStateKey, JSON.stringify({ ...storedState, restorePending: false }));
    }
  } catch {
    // 无法读取会话状态时不影响筛选本身。
  }
</script>

<style>
  .archive-view-modes { display:flex; flex-wrap:wrap; gap:0.65rem; margin:0 0 0.8rem; }
  .archive-view-modes a { padding:0.5rem 0.85rem; border:1px solid var(--site-border-soft); color:var(--site-muted); text-decoration:none; font:0.8rem/1.6 var(--site-ui-font); }
  .archive-view-modes a[aria-current="page"] { color:var(--site-accent); border-color:var(--site-accent); background:var(--site-paper); }
  .archive-view-note { margin:0 0 1.3rem; color:var(--site-muted); font:0.78rem/1.8 var(--site-ui-font); }
  .album-matched-items { padding:0.85rem 1.2rem 0.85rem 2.2rem; margin:0; border:1px solid var(--site-border-soft); border-top:0; font:0.78rem/1.8 var(--site-ui-font); }
  .album-matched-items :global(a) { color:var(--site-accent); }
  .archive-page {
    padding-top: 1.15rem;
  }

  .archive-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--site-border-soft);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .introduction {
    max-width: 32rem;
    margin: 0;
    color: var(--site-muted);
    font-size: 0.88rem;
    line-height: 1.65;
    letter-spacing: 0.02em;
  }

  .archive-paths {
    margin-top: 0.85rem;
    padding: 0.55rem 0 0.35rem;
    background: transparent;
    border: 0;
  }

  .archive-paths-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    min-height: 2rem;
  }

  .archive-paths-heading::-webkit-details-marker { display: none; }
  .archive-paths-toggle { color: var(--site-subtle); font: 0.68rem var(--site-ui-font); }

  .archive-paths-title,
  .archive-index-title {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .archive-paths-title > :global(.site-icon),
  .archive-index-title > :global(.site-icon) {
    width: 1rem;
    height: 1rem;
    margin-top: 0.12rem;
    color: var(--site-muted);
  }

  .archive-paths-heading p,
  .archive-paths-heading #archive-paths-heading,
  .archive-path-group h3 {
    margin: 0;
  }

  .archive-paths-heading p {
    display: none;
  }

  .archive-paths-heading #archive-paths-heading {
    color: var(--site-subtle);
    font-family: var(--site-ui-font);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .archive-paths-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin-top: 0.45rem;
  }

  .archive-path-group {
