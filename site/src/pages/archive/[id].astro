---

import { t, getLocale, localizePath, canonicalPath, dateLocale } from '../../i18n/ui';
const locale = getLocale(Astro.url.pathname);
import {translationLocales} from '../../../../shared/locale-config.mjs';
import { serializeHtmlJson } from '../../../../shared/html-json.mjs';
import {getArchiveTranslation} from '../../data/archive-localization';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveLikeButton from '../../components/ArchiveLikeButton.astro';
import ArchiveFavoriteButton from '../../components/ArchiveFavoriteButton.astro';
import { archiveItems, type ArchiveItem } from '../../data/archive';
import {
  archiveCategories,
  getArchiveCategorySlug,
} from '../../data/archive-categories';
import {
  createArchiveRecordView,
  getSpecificMetadataFacts,
  isPublishedArchiveItem,
  type DisplayFact,
} from '../../data/archive-view';
import { getCodeLabel } from '../../data/code-dictionary';
import { getPublicUsagePolicy } from '../../data/archive-rights';
import { getResponsiveImage } from '../../data/responsive-images';
import { publishedAlbumGroups, curatedAlbumForId } from '../../data/album-groups';
import { compareAlbumPositions } from '../../data/album-position.mjs';
import { letterTranscriptionPages } from '../../data/letter-transcription-pages.mjs';
import { normalizeArchivePlace, isBrowseableArchivePlace } from '../../../../shared/archive-place-filters.mjs';

export function getStaticPaths() {
  return archiveItems.filter(isPublishedArchiveItem).map((item) => ({
    params: { id: item.core.item_id },
    props: { item },
  }));
}

interface Props {
  item: ArchiveItem;
}

const { item } = Astro.props;
const view = createArchiveRecordView(item, locale);
const publishedViews = archiveItems.filter(isPublishedArchiveItem).map(item => createArchiveRecordView(item, locale));
const currentCategorySlug = getArchiveCategorySlug(view.objectType);
const categorySource = archiveCategories.find((category) => category.slug === currentCategorySlug);
const currentCategory = categorySource ? {...categorySource, label: t(categorySource.label, locale)} : undefined;
const categoryViews = publishedViews.filter(
  (candidate) => getArchiveCategorySlug(candidate.objectType) === currentCategorySlug,
);
const categoryIndex = categoryViews.findIndex((candidate) => candidate.id === view.id);
const previousView = categoryIndex > 0 ? categoryViews[categoryIndex - 1] : undefined;
const nextView = categoryIndex >= 0 && categoryIndex < categoryViews.length - 1
  ? categoryViews[categoryIndex + 1]
  : undefined;
const defaultBackHref = currentCategorySlug ? `/archive/?category=${currentCategorySlug}` : '/archive/';

interface LinkedDisplayFact extends DisplayFact {
  href?: string;
}

const hasText = (value: string | undefined) => Boolean(value?.trim());
const isLetter = item.core.object_type === 'LET';
const hasPublicTranscription = hasText(view.transcription);
const hasPublicOriginal = view.images.length > 0;
const translatedLetter = locale !== 'zh-CN' && hasText(view.transcriptionTranslation);
const visibleLetterText = translatedLetter ? view.transcriptionTranslation : view.originalTranscription;
// 译文可能只是整封摘要，不能从原文的页标推断译文与图片逐页对应。
const letterPages = isLetter && !translatedLetter
  ? letterTranscriptionPages(visibleLetterText, item.public_view.image_descriptions, view.images.length)
  : [];
// 访客看信件首先想看原件：有原件发布副本时默认“只看原件”，没有原件时才回退到文字阅读。
const initialLetterMode = hasPublicOriginal ? 'original' : 'text';
const letterReadingModes = [
  hasPublicOriginal ? { value: 'original', label: t("只看原件", locale) } : undefined,
  hasPublicTranscription ? { value: 'text', label: t("文字阅读", locale) } : undefined,
  hasPublicTranscription && hasPublicOriginal ? { value: 'compare', label: t("原件对照", locale) } : undefined,
].filter((mode): mode is { value: string; label: string } => Boolean(mode));
const compactFacts = <T extends DisplayFact>(facts: T[]) => facts.filter((fact) => hasText(fact.value));
const joinText = (value: string[] | undefined) => value?.filter(hasText).join('、') ?? '';
const archiveFilterHref = (name: 'category' | 'decade' | 'place' | 'tag', value: string) =>
  `/archive/?${name}=${encodeURIComponent(value)}`;
// “地点”行的同地点链接取最能定位的一层结构化地点（优先市级），含“未知”的层级跳过。
const placeLinkLevels = ['city', 'district', 'street_town', 'specific_place', 'province', 'country'] as const;
const preferredPlace = placeLinkLevels
  .map((field) => item.core[field]?.trim())
  .find(isBrowseableArchivePlace);
const preferredPlaceFilter = preferredPlace ? normalizeArchivePlace(preferredPlace) : undefined;
const formatDisplayDate = (value: string | undefined) => {
  const match = value?.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return value?.trim() ?? '';
  if (locale !== 'zh-CN') return new Intl.DateTimeFormat(dateLocale(locale), {year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(`${value}T00:00:00Z`));
  return t("{0}年{1}月{2}日", locale, {0: (match[1]), 1: (Number(match[2])), 2: (Number(match[3]))});
};
const basicFacts = compactFacts<LinkedDisplayFact>([
  {
    label: t("类型", locale),
    value: view.typeLabel,
    href: currentCategorySlug ? archiveFilterHref('category', currentCategorySlug) : undefined,
  },
  {
    label: t("年代", locale),
    value: view.dateDisplay,
    href: view.decade ? archiveFilterHref('decade', view.decade) : undefined,
  },
  {
    label: t("地点", locale),
    value: view.placeDisplay,
    href: preferredPlaceFilter ? archiveFilterHref('place', preferredPlaceFilter) : undefined,
  },
  { label: t("人物", locale), value: joinText(view.localizedCore.people) },
]);

const updatedDate = formatDisplayDate(item.core.updated_date);

const specificFacts = getSpecificMetadataFacts(item, { locale });

// 面向访客的“更多信息”只显示中文标签：永久编号、收藏品编码、类型代码、
// 维度代码等内部编码不在公开页展示；永久编号仍保留在“引用与分享”区块供核对使用。
const displayLabel = (code: string | undefined) => hasText(code) ? getCodeLabel(code, locale) : '';
const researchManagementFacts = compactFacts([
  { label: t("来源地点", locale), value: view.localizedCore.source_place ?? '' },
  { label: t("保存等级", locale), value: displayLabel(item.core.condition_grade) },
]);
const getImageRole = (description: string, index: number) => {
  if (/册内影像选览|非实物封面/.test(description)) return '册内影像选览';
  const matchedRole = ['正面', '背面', '封面', '内页', '全景', '细节', '留言面', '风景面'].find((role) =>
    description.includes(role));
  return matchedRole ?? t("图片 {0}", locale, {0: (index + 1)});
};
const galleryImages = view.images.map((source, index) => ({
  ...getResponsiveImage(source),
  description: view.imageDescriptions[index],
  role: t(getImageRole(item.public_view.image_descriptions?.[index] || (source.includes('/front-') ? '正面' : source.includes('/back-') ? '背面' : '细节'), index), locale),
}));

// 浏览足迹：当前档案的概要信息，由页面脚本写入访客自己的浏览器，
// 供首页「您最近看过」继续浏览使用；没有公开图片时图片字段留空。
const firstGalleryImage = galleryImages[0];
const recordViewData = {
  id: view.id,
  title: view.title,
  typeLabel: view.typeLabel,
  dateDisplay: view.dateDisplay,
  imageSrc: firstGalleryImage?.src ?? '',
  imageAlt: firstGalleryImage?.description ?? '',
  imageWidth: firstGalleryImage?.width ?? 0,
  imageHeight: firstGalleryImage?.height ?? 0,
};
const hasNarrativeContent = (!isLetter && hasText(view.transcription)) || hasText(view.localizedCore.provenance_notes);
const hasTags = view.tags.length > 0;
const usagePolicy = getPublicUsagePolicy(item.core.rights_status, locale);
const downloadableImages = usagePolicy.canDownloadPublicationCopy
  ? view.images.map((source, index) => ({
    source,
    description: view.imageDescriptions[index],
    filename: `${view.id}-${String(index + 1).padStart(2, '0')}.${source.split('.').at(-1) ?? 'jpg'}`,
  }))
  : [];
const relatedRecordEntries = publishedViews
  .filter((candidate) => candidate.id !== view.id)
  .map((candidate) => {
    const sharedTags = candidate.canonicalTags.filter((tag) => view.canonicalTags.includes(tag));
    // 国家与省级区域太宽泛，不作为优先推荐的地点线索。
    const specificPlaces = ['city', 'district', 'street_town', 'specific_place'] as const;
    const sharedPlaces = specificPlaces.flatMap((field) => {
      const place = item.core[field]?.trim();
      const otherPlace = candidate.item.core[field]?.trim();
      return place && isBrowseableArchivePlace(place) &&
        normalizeArchivePlace(place) === normalizeArchivePlace(otherPlace) ? [place] : [];
    }).filter((place, index, places) => places.indexOf(place) === index);
    const explicitRelation = Boolean(item.core.related_item_ids?.includes(candidate.id) ||
      candidate.item.core.related_item_ids?.includes(view.id) ||
      item.core.album_id && item.core.album_id === candidate.item.core.album_id ||
      item.core.series_id && item.core.series_id === candidate.item.core.series_id);
    const sameDecade = Boolean(view.decade && candidate.decade === view.decade);
    const candidateCategorySlug = getArchiveCategorySlug(candidate.objectType);
    const sameCategory = Boolean(currentCategorySlug && candidateCategorySlug === currentCategorySlug);
    const reasons = [
      explicitRelation ? t('来自同一组档案线索',locale) : '',
      sharedTags.length ? t("共同线索：{0}", locale, {0: (sharedTags.slice(0, 2).map(tag => view.tagLabels[tag] ?? tag).join(locale !== 'zh-CN' ? t(', ',locale) : '、'))}) : '',
      sharedPlaces.length ? t("关联地点：{0}", locale, {0: (sharedPlaces.slice(0, 2).map(place => view.placeFilterLabels[place] ?? place).join(locale !== 'zh-CN' ? t(', ',locale) : '、'))}) : '',
      sameDecade ? t("同属{0}年代", locale, {0: (view.decade)}) : '',
      sameCategory ? t("同属{0}", locale, {0: (t(currentCategory?.label ?? '相近类型',locale))}) : '',
    ].filter(Boolean);
    const score = Number(explicitRelation) * 12 + sharedTags.length * 4 + sharedPlaces.length * 6 + Number(sameDecade) * 2
      + Number(sameCategory) * 2 + Number(candidate.objectType !== view.objectType) * 0.25;
    return {
      view: candidate,
      score,
      reason: reasons[0] ?? '',
      coverImage: candidate.images[0] ? getResponsiveImage(candidate.images[0]) : undefined,
    };
  })
  .filter((entry) => entry.score > 0 && entry.reason)
  .sort((left, right) => right.score - left.score || left.view.item.core.title.localeCompare(right.view.item.core.title, 'zh-CN'))
  .slice(0, 3);
const recordUrl = Astro.site ? new URL(localizePath(`/archive/${view.id}/`, locale), Astro.site) : undefined;
// 入口与生成页面使用同一套公开分组，避免历史编号产生断链或误计其他物件。
const albumGroup = publishedAlbumGroups().find((group) => group.members.some((member) => member.core.item_id === view.id));
const isCorrespondence = Boolean(albumGroup?.isCorrespondence);
const albumMateCount = isCorrespondence ? albumGroup!.members.length : albumGroup?.photos.length ?? 0;
const albumContextLabel = isCorrespondence ? t("本辑档案", locale) : t("同册照片", locale);
const isWholeAlbumGroup = Boolean(albumGroup && !isCorrespondence && !albumGroup.photos.length && albumGroup.albums.length);
const wholeAlbumImageCount = albumGroup?.albums.reduce((count, album) => count + album.core.publication_file_path.length, 0) ?? 0;
const albumPhotos = [...(isCorrespondence ? albumGroup!.members : albumGroup?.photos ?? [])].sort((left,right) =>
  isCorrespondence ?
    (left.core.date_start || left.core.date_display || '').localeCompare(right.core.date_start || right.core.date_display || '') || left.core.item_id.localeCompare(right.core.item_id) :
  compareAlbumPositions(left.core.original_position,right.core.original_position) ||
  left.core.title.localeCompare(right.core.title,'zh-CN') || left.core.item_id.localeCompare(right.core.item_id));
const albumPhotoIndex = albumPhotos.findIndex((photo) => photo.core.item_id === view.id);
const previousAlbumPhoto = albumPhotoIndex > 0 ? albumPhotos[albumPhotoIndex - 1] : undefined;
const nextAlbumPhoto = albumPhotoIndex >= 0 ? albumPhotos[albumPhotoIndex + 1] : undefined;
// 同册照片的页尾与页首保持同一页序，避免向下读完后跳到另一套分类顺序。
const previousBrowseView = albumPhotoIndex >= 0
  ? (previousAlbumPhoto ? createArchiveRecordView(previousAlbumPhoto, locale) : undefined) : previousView;
const nextBrowseView = albumPhotoIndex >= 0
  ? (nextAlbumPhoto ? createArchiveRecordView(nextAlbumPhoto, locale) : undefined) : nextView;
const previousRecordLabel = isLetter && previousBrowseView?.objectType === 'LET' ? `← ${t('上一封信', locale)}`
  : albumPhotoIndex >= 0 && !isCorrespondence ? `← ${t("同册上一件", locale)}` : t("← 上一件", locale);
const nextRecordLabel = isLetter && nextBrowseView?.objectType === 'LET' ? `${t('下一封信', locale)} →`
  : albumPhotoIndex >= 0 && !isCorrespondence ? `${t("同册下一件", locale)} →` : t("下一件 →", locale);
const albumLinkLabel = albumGroup
  ? (isWholeAlbumGroup ? `${t('{0} 件相册档案 · {1} 幅整册影像', locale, { 0: albumGroup.albums.length, 1: wholeAlbumImageCount })} →`
    : curatedAlbumForId(albumGroup.albumId)
    ? `${t(curatedAlbumForId(albumGroup.albumId)!.title, locale)} · ${t("{0} 件公开档案", locale, { 0: albumMateCount })} →`
    : item.core.object_type === 'ALB'
    ? t("翻阅本册档案（共 {0} 件） →", locale, { 0: albumMateCount })
    : t("查看整本相册（共 {0} 件照片档案） →", locale, { 0: albumMateCount }))
  : '';
const archiveIndexUrl = Astro.site ? new URL(localizePath('/archive/', locale), Astro.site) : undefined;
const recordStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: view.title,
  identifier: view.id,
  description: view.description || `${view.typeLabel}，${view.dateDisplay || '年代未知'}。`,
  dateCreated: item.core.created_date,
  dateModified: item.core.updated_date,
  temporalCoverage: view.dateDisplay || undefined,
  contentLocation: hasText(view.placeDisplay) && !view.placeDisplay.includes('未知')
    ? { '@type': 'Place', name: view.placeDisplay }
    : undefined,
  keywords: view.tags.length ? view.tags : undefined,
  image: Astro.site ? galleryImages.map((image) => new URL(image.src, Astro.site).href) : undefined,
  url: recordUrl?.href,
  isPartOf: {
    '@type': 'CollectionPage',
    name: t('老旧默片',locale),
    inLanguage: locale,
    url: archiveIndexUrl?.href,
  },
};

const breadcrumbItems = [
  { name: t('首页',locale), url: '/' },
  { name: t('档案',locale), url: '/archive/' },
  ...(currentCategory ? [{ name: currentCategory.label, url: `/archive/?category=${currentCategorySlug}` }] : []),
  { name: view.title, url: `/archive/${view.id}/` },
];
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: Astro.site ? new URL(localizePath(item.url,locale), Astro.site).href : localizePath(item.url,locale),
  })),
};
---

<BaseLayout
  archiveStyle="editorial"
  title={t("{0}｜老旧默片", locale, {0: (view.title)})}
  description={view.description || `${view.title}，${view.typeLabel}，${view.dateDisplay || '年代未知'}。`}
  image={galleryImages[0]?.src}
  pageType="article"
  structuredData={[recordStructuredData, breadcrumbStructuredData]}
  translationAvailability={Object.fromEntries(translationLocales.map(language=>[language,getArchiveTranslation(item,language).state==='published']))}
  englishAvailable={getArchiveTranslation(item,'en').state === 'published'}
  thaiAvailable={getArchiveTranslation(item,'th').state === 'published'}
  robots={locale !== 'zh-CN' && view.translationState !== 'published' ? 'noindex,follow' : undefined}
>
  <article class="record-page" data-record-id={view.id}>
    {locale !== 'zh-CN' && view.translationState !== 'published' && <p class="translation-notice" role="status">{t('Some translations are pending review. Source text is shown where a current translation is unavailable.',locale)}</p>}
    <div class="record-top">
      <nav class="record-breadcrumb" aria-label={t("面包屑", locale)}>
        <a href={localizePath("/", locale)} class="breadcrumb-link">{t("首页", locale)}</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a href={localizePath("/archive/", locale)} class="breadcrumb-link">{t("档案", locale)}</a>
        {currentCategory && (
          <Fragment>
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            <a href={localizePath(`/archive/?category=${currentCategorySlug}`, locale)} class="breadcrumb-link">{currentCategory.label}</a>
          </Fragment>
        )}
      </nav>
      <a class="back-link ui-text-link" href={localizePath(defaultBackHref, locale)} data-record-back>{t("← 返回档案", locale)}</a>
    </div>

    <header class="record-heading">
      <div class="record-heading-row">
        <div class="record-heading-copy">
          <p class="section-mark"><span>{view.typeLabel}</span>{view.dateDisplay && <span>{view.dateDisplay}</span>}</p>
          <h1>{view.title}</h1>
        </div>
      </div>
      {albumGroup && (
        <nav class="record-album-context" aria-label={isWholeAlbumGroup ? t('整册影像', locale) : albumContextLabel}>
          <div>
            <a class="ui-text-link" href={localizePath(albumGroup.href, locale)} data-album-entry>{albumLinkLabel}</a>
            {item.core.object_type === 'PHO' && item.core.original_position && <small>{t("相册中的位置", locale)}：{item.core.original_position}</small>}
          </div>
          {(previousAlbumPhoto || nextAlbumPhoto) && <div class="record-album-navigation">
            {previousAlbumPhoto && <a href={localizePath(`/archive/${previousAlbumPhoto.core.item_id}/`, locale)} rel="prev">{previousRecordLabel}</a>}
            {nextAlbumPhoto && <a href={localizePath(`/archive/${nextAlbumPhoto.core.item_id}/`, locale)} rel="next">{nextRecordLabel}</a>}
          </div>}
        </nav>
      )}
    </header>

    <div
      class:list={['record-sheet', { 'record-sheet--letter': isLetter }]}
      data-letter-reader={isLetter ? 'true' : undefined}
      data-letter-mode={isLetter ? initialLetterMode : undefined}
    >
      {isLetter && (
        <header class="letter-reading-header" data-reader-toolbar>
            <div class="letter-reading-position">
              <h2>{t("信件阅读", locale)}</h2>
              {letterPages.length > 0 && <select data-letter-position aria-label={t('选择信页', locale)}>
                {letterPages.map((_, index) => <option value={index + 1}>
                  {t('第 {0} 页，共 {1} 页', locale, {0: index + 1, 1: letterPages.length})}
                </option>)}
              </select>}
            </div>
            {letterReadingModes.length > 1 && (
              <div class="letter-reading-modes" role="group" aria-label={t("选择信件查看方式", locale)}>
                {letterReadingModes.map((mode) => (
                  <button
                    type="button"
                    data-letter-mode-select={mode.value}
                    aria-pressed={String(mode.value === initialLetterMode)}
                  >
                    {mode.label}
                  </button>
                ))}
              </div>
            )}
            {!hasPublicTranscription && <p class="letter-reading-introduction">{locale === 'zh-CN'
              ? '这封信暂未提供公开释文。'
              : t('No public transcription is available for this letter. Only reviewed publication copies of the original are shown.',locale)}</p>}
        </header>
      )}

      {isLetter && hasPublicTranscription && (
        <article class="letter-transcription" aria-labelledby="letter-transcription-heading">
          <header>
              <h2 id="letter-transcription-heading">{locale !== 'zh-CN' && !view.transcriptionTranslation ? t('Original text · translation pending',locale) : t("电子文字", locale)}</h2>
              <div class="letter-text-size" role="group" aria-label={t("调整文字字号", locale)}>
                <span>{t("字号", locale)}</span>
                <button type="button" data-letter-size-select="small" aria-pressed="false">{t("小", locale)}</button>
                <button type="button" data-letter-size-select="medium" aria-pressed="true">{t("中", locale)}</button>
                <button type="button" data-letter-size-select="large" aria-pressed="false">{t("大", locale)}</button>
              </div>
          </header>
          {locale !== 'zh-CN' && view.transcriptionTranslation && <div class="translation-heading">{view.transcriptionKind === 'summary' ? t('Translation summary',locale) : t('Translation',locale)}</div>}
          <div class="letter-transcription-text" data-letter-text lang={translatedLetter ? locale : view.originalLanguage}>{letterPages.length > 0
            ? letterPages.map((page: string, index: number) => <div class="letter-page-sheet">
                <input type="button" class="letter-page-link" data-letter-original-page={index + 1} value={t('看本页原件', locale)} />
                <div data-letter-page={index + 1} data-current-page={String(index === 0)} tabindex="-1">{page}</div>
              </div>)
            : visibleLetterText}</div>
          {locale !== 'zh-CN' && view.transcriptionTranslation && view.originalTranscription && <details class="original-text"><summary>{t('View original text',locale)}</summary><div class="letter-transcription-text" lang={view.originalLanguage}>{view.originalTranscription}</div></details>}
          <footer>
            <span>{locale === 'zh-CN' ? '原件图片是最终核对依据。' : t('Original images are shown first and remain the source for verification. The transcription preserves original paragraphs and line breaks; switch views at any time.',locale)}</span>
            {view.originalTranscription.includes('〔不清〕') && <span>{t("〔不清〕表示原件难以辨认", locale)}</span>}
            {view.originalTranscription.includes('□') && <span>{t("□ 表示原件文字缺失", locale)}</span>}
          </footer>
        </article>
      )}

      {
        galleryImages.length > 0 && (
          <div
            class="record-gallery"
            data-record-gallery
            data-record-image-count={galleryImages.length}
            data-page-counter-format={letterPages.length ? t('第 {0} 页，共 {1} 页', locale, {0: '{page}', 1: letterPages.length}) : undefined}
            data-gallery-items={JSON.stringify(galleryImages.map((image) => ({
              src: image.src,
              srcset: image.srcset,
              description: image.description,
              role: image.role,
              width: image.width,
              height: image.height,
            })))}
            aria-label={t("档案图片", locale)}
          >
            <figure class="record-image">
              <button
                class="record-image-open"
                type="button"
                data-gallery-open
                data-gallery-swipe
                aria-label={t("放大查看：{0}", locale, {0: (galleryImages[0].description)})}
              >
                <img
                  data-gallery-main
                  src={galleryImages[0].src}
                  srcset={galleryImages[0].srcset}
                  sizes="(max-width: 760px) calc(100vw - 32px), min(72vw, 920px)"
                  alt={galleryImages[0].description}
                  width={galleryImages[0].width}
                  height={galleryImages[0].height}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
                <span class="record-image-hint">{t("放大查看", locale)}</span>
              </button>
              <figcaption>
                <span class="record-image-caption">
                  <strong data-gallery-role>{galleryImages[0].role}</strong>
                  <span data-gallery-caption>{galleryImages[0].description}</span>
                </span>
                {letterPages.length > 0 && <button type="button" class="letter-page-link" data-letter-read-page>{t('读本页文字', locale)}</button>}
              </figcaption>
            </figure>
            {galleryImages.length > 1 && (
              <div class="record-gallery-controls" aria-label={t("切换当前档案图片", locale)}>
                <button class="gallery-step gallery-step-previous" type="button" data-gallery-previous-inline>
                  <span aria-hidden="true">←</span> {letterPages.length ? t('上一页', locale) : t("上一张", locale)}
                </button>
                <output data-gallery-counter aria-live="polite">{t(letterPages.length ? '第 {0} 页，共 {1} 页' : '第 {0} 张，共 {1} 张', locale, {0: 1, 1: galleryImages.length})}</output>
                <button class="gallery-step gallery-step-next" type="button" data-gallery-next-inline>
                  {letterPages.length ? t('下一页', locale) : t("下一张", locale)} <span aria-hidden="true">→</span>
                </button>
              </div>
            )}
            {galleryImages.length > 1 && (
              <div class="record-thumbnails" aria-label={t("切换档案图片", locale)}>
                {galleryImages.map((image, index) => (
                  <button
                    type="button"
                    aria-label={letterPages.length ? t('前往第 {0} 页', locale, {0: index + 1}) : t("查看第 {0} 张图片：{1}", locale, {0: (index + 1), 1: (image.description)})}
                    aria-current={index === 0 ? 'true' : 'false'}
                    data-gallery-thumbnail
                    data-gallery-src={image.src}
                    data-gallery-srcset={image.srcset}
                    data-gallery-alt={image.description}
                    data-gallery-width={image.width}
                    data-gallery-height={image.height}
                    data-gallery-index={index + 1}
                  >
                    <img
                      src={image.src}
                      srcset={image.srcset}
                      sizes="88px"
                      alt=""
                      width="180"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{index + 1}</span>
                  </button>
                ))}
              </div>
            )}

            <dialog class="record-lightbox" data-gallery-lightbox aria-label={t("在暗室中查看档案图片", locale)}>
              <div class="lightbox-shell">
                <button class="lightbox-close" type="button" data-gallery-close aria-label={t("关闭放大图片", locale)}>{t("关闭", locale)}</button>
                <div class="lightbox-zoom" aria-label={t("图片大小", locale)}>
                  <button type="button" data-gallery-zoom-out aria-label={t("缩小图片", locale)}>−</button>
                  <output data-gallery-zoom-level aria-live="polite">100%</output>
                  <button type="button" data-gallery-zoom-in aria-label={t("放大图片", locale)}>＋</button>
                  <button type="button" data-gallery-zoom-reset>{t("适应窗口", locale)}</button>
                </div>
                {galleryImages.length > 1 && (
                  <button class="lightbox-previous" type="button" data-gallery-previous aria-label={letterPages.length ? t('上一页', locale) : t("查看上一张图片", locale)}>
                    <span aria-hidden="true">←</span>
                  </button>
                )}
                <figure class="lightbox-figure" data-gallery-swipe>
                  <div class="lightbox-stage" data-gallery-zoom-stage tabindex="0" aria-label={t("图片区域，放大后可拖动；加减键调整大小，0键恢复", locale)}>
                    <img
                      data-lightbox-main
                      sizes="100vw"
                      alt={galleryImages[0].description}
                      width={galleryImages[0].width}
                      height={galleryImages[0].height}
                      decoding="async"
                    />
                  </div>
                  <figcaption>
                    <span class="lightbox-caption-copy">
                      <strong data-lightbox-role>{galleryImages[0].role}</strong>
                      <span data-lightbox-caption>{galleryImages[0].description}</span>
                    </span>
                    <small data-lightbox-counter>{t(letterPages.length ? '第 {0} 页，共 {1} 页' : '第 {0} 张，共 {1} 张', locale, {0: 1, 1: galleryImages.length})}</small>
                  </figcaption>
                </figure>
                {galleryImages.length > 1 && (
                  <button class="lightbox-next" type="button" data-gallery-next aria-label={letterPages.length ? t('下一页', locale) : t("查看下一张图片", locale)}>
                    <span aria-hidden="true">→</span>
                  </button>
                )}
              </div>
            </dialog>
          </div>
        )
      }

      <section class="record-basic-information" aria-labelledby="basic-heading">
        {hasText(view.description) && <p class="record-lead">{view.description}</p>}
        <h2 class="facts-heading icon-heading" id="basic-heading"><span>{t("基本信息", locale)}</span></h2>
        <dl class="record-facts">
          {
            basicFacts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>
                  {fact.href ? (
                    <a class="fact-filter-link" href={localizePath(fact.href, locale)}>
                      {fact.value}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  ) : fact.value}
                </dd>
              </div>
            ))
          }
        </dl>
        {(hasTags || hasText(updatedDate)) && (
          <div class="record-sidebar-meta" aria-label={t("标签与更新时间", locale)}>
            {hasTags && (
              <div class="record-sidebar-meta-group">
                <h3 class="icon-heading"><span>{t("标签", locale)}</span></h3>
                <ul class="record-tags record-tags--sidebar">
                  {view.canonicalTags.map((tag) => (
                    <li><a href={localizePath(archiveFilterHref('tag', tag), locale)}>{view.tagLabels[tag] ?? tag}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {hasText(updatedDate) && (
              <div class="record-sidebar-meta-group record-updated-date">
                <h3 class="icon-heading"><span>{t("最后更新", locale)}</span></h3>
                <p><time datetime={item.core.updated_date}>{updatedDate}</time></p>
              </div>
            )}
          </div>
        )}
        <div class="record-heading-actions" aria-label={t("档案互动操作", locale)}>
          <ArchiveLikeButton itemId={view.id} title={view.title} compact />
          <ArchiveFavoriteButton itemId={view.id} title={view.title} />
        </div>
      </section>
    </div>

    <div class="record-notes">
      {
        hasNarrativeContent && (
          <section class="record-section" aria-labelledby="description-heading">
            <h2 class="icon-heading" id="description-heading"><span>{locale !== 'zh-CN' ? (isLetter ? t('Provenance and sources',locale) : t('Story and original text',locale)) : isLetter ? '流传与来源' : '故事与原文'}</span></h2>
            <div class="section-content">
              {hasText(view.localizedCore.provenance_notes) && (
                <div class="subsection">
                  <h3>{t("流传线索", locale)}</h3>
                  <p>{view.localizedCore.provenance_notes}</p>
                </div>
              )}
              {!isLetter && hasText(view.transcription) && (
                <div class="subsection">
                  <h3>{t("原文 / 转录", locale)}</h3>
                  {locale !== 'zh-CN' && <p>{view.transcriptionTranslation ? (view.transcriptionKind === 'summary' ? t('Translation summary',locale) : t('Translation',locale)) : t('Original text · translation pending',locale)}</p>}
                  <p class="transcription" lang={locale !== 'zh-CN' && view.transcriptionTranslation ? locale : view.originalLanguage}>{locale !== 'zh-CN' && view.transcriptionTranslation ? view.transcriptionTranslation : view.originalTranscription}</p>
                  {locale !== 'zh-CN' && view.transcriptionTranslation && view.originalTranscription && <details><summary>{t('View original text',locale)}</summary><p class="transcription" lang={view.originalLanguage}>{view.originalTranscription}</p></details>}
                </div>
              )}
            </div>
          </section>
        )
      }

      {
        specificFacts.length > 0 && (
          <section class="record-section" aria-labelledby="specific-heading">
            <h2 class="icon-heading" id="specific-heading"><span>{t("藏品细节", locale)}</span></h2>
            <dl class="section-facts">
              {specificFacts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        researchManagementFacts.length > 0 && (
          <details class="management-information">
            <summary>
              <span class="icon-heading"><span>{t("更多信息", locale)}</span></span>
              <small>{researchManagementFacts.length} {t("项", locale)}</small>
            </summary>
            <dl class="section-facts">
              {researchManagementFacts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </details>
        )
      }
    </div>

    {relatedRecordEntries.length > 0 && (
      <section class="record-related" aria-labelledby="record-related-heading">
        <div class="record-related-heading">
          <h2 class="icon-heading" id="record-related-heading"><span>{t("沿着线索继续看", locale)}</span></h2>
          <span>{t("根据共同标签、地点、年代或分类自动关联。", locale)}</span>
        </div>
        <div class="record-related-grid">
          {relatedRecordEntries.map((entry) => (
            <a href={localizePath(`/archive/${entry.view.id}/`, locale)} data-record-nav data-record-target={entry.view.id}>
              <figure>
                {entry.coverImage && (
                  <img
                    src={entry.coverImage.src}
                    srcset={entry.coverImage.srcset}
                    sizes="(max-width: 760px) 112px, 240px"
                    alt={entry.view.imageDescriptions[0]}
                    width={entry.coverImage.width}
                    height={entry.coverImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </figure>
              <div>
                <small>{entry.reason}</small>
                <strong>{entry.view.title}</strong>
                <span>{entry.view.typeLabel} · {entry.view.dateDisplay}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section
      class="record-usage"
      aria-labelledby="record-usage-heading"
      data-record-usage
      data-rights-status={item.core.rights_status ?? 'UNK'}
      data-download-available={String(usagePolicy.canDownloadPublicationCopy)}
    >
      <div class="record-usage-heading">
        <h2 class="icon-heading" id="record-usage-heading"><span>{t("使用与下载", locale)}</span></h2>
      </div>
      <div class="record-usage-content">
        <div class="record-usage-summary">
          <span>{t("权利状态 ·", locale)} {usagePolicy.statusLabel}</span>
          <strong>{usagePolicy.title}</strong>
          <p>{usagePolicy.description}</p>
          <small>{usagePolicy.attribution}</small>
        </div>
        {downloadableImages.length > 0 && (
          <div class="record-downloads" aria-label={t("可下载的网页发布副本", locale)}>
            {downloadableImages.map((image, index) => (
              <a class="ui-action ui-action--primary" href={localizePath(image.source, locale)} download={image.filename} data-download-publication-copy>
                {t("下载发布副本", locale)} {downloadableImages.length > 1 ? index + 1 : ''}
                <small>{image.description}</small>
              </a>
            ))}
            <p>{t("下载内容是网站使用的压缩发布副本，不是原始扫描件或档案主文件。", locale)}</p>
          </div>
        )}
      </div>
    </section>

    <section
      class="record-citation"
      aria-labelledby="record-citation-heading"
      data-record-citation
      data-record-title={view.title}
      data-record-identifier={view.id}
    >
      <div class="record-citation-heading">
        <h2 class="icon-heading" id="record-citation-heading"><span>{t("引用与分享", locale)}</span></h2>
      </div>
      <div class="record-citation-content">
        <p class="citation-preview">
          《{view.title}》（{view.id}{t("），老旧默片。复制时会自动补充当前页面地址和访问日期。", locale)}
        </p>
        <div class="citation-actions">
          <button class="ui-action ui-action--secondary" type="button" data-copy-record-link>{t("复制页面链接", locale)}</button>
          <button class="ui-action ui-action--secondary" type="button" data-copy-record-citation>{t("复制规范引用", locale)}</button>
        </div>
        <p class="citation-feedback" role="status" aria-live="polite" data-citation-feedback></p>
      </div>
    </section>

    {(previousBrowseView || nextBrowseView) && (
      <nav class="record-neighbors" aria-label={albumPhotoIndex >= 0 ? albumContextLabel : t("{0}档案导航", locale, {0: (currentCategory?.label ?? '同类')})}>
        <p>{t("继续浏览 ·", locale)} {albumPhotoIndex >= 0 ? albumContextLabel : currentCategory?.label ?? '同类档案'}</p>
        <div>
          {previousBrowseView && (
            <a href={localizePath(`/archive/${previousBrowseView.id}/`, locale)} data-record-nav data-record-target={previousBrowseView.id}>
              <small>{previousRecordLabel}</small>
              <strong>{previousBrowseView.title}</strong>
              <span>{previousBrowseView.dateDisplay}</span>
            </a>
          )}
          {nextBrowseView && (
            <a class="is-next" href={localizePath(`/archive/${nextBrowseView.id}/`, locale)} data-record-nav data-record-target={nextBrowseView.id}>
              <small>{nextRecordLabel}</small>
              <strong>{nextBrowseView.title}</strong>
              <span>{nextBrowseView.dateDisplay}</span>
            </a>
          )}
        </div>
      </nav>
    )}
    <script type="application/json" id="record-view-data" set:html={serializeHtmlJson(recordViewData)} />
  </article>
</BaseLayout>

<script>
import {clientText as ct,clientPath,clientLocale} from '../../i18n/client';

import '../../scripts/archive-likes';
  import '../../scripts/archive-favorite';
  import { recordView } from '../../scripts/view-history';

  // 浏览足迹：把当前档案记入访客本地足迹，供首页「您最近看过」使用。
  try {
    const viewDataElement = document.querySelector<HTMLElement>('#record-view-data');
    const viewData = JSON.parse(viewDataElement?.textContent ?? 'null') as {
      id?: string;
      title?: string;
      typeLabel?: string;
      dateDisplay?: string;
      imageSrc?: string;
      imageAlt?: string;
      imageWidth?: number;
      imageHeight?: number;
    };
    if (viewData?.id && viewData.title) {
      recordView({
        id: viewData.id,
        title: viewData.title,
        typeLabel: viewData.typeLabel ?? '',
        dateDisplay: viewData.dateDisplay ?? '',
        imageSrc: viewData.imageSrc ?? '',
        imageAlt: viewData.imageAlt ?? '',
        imageWidth: viewData.imageWidth ?? 0,
        imageHeight: viewData.imageHeight ?? 0,
      });
    }
  } catch {
    // 足迹记录失败不影响档案页面本身。
  }

  import { initLetterReader } from '../../scripts/letter-reading';
  document.querySelectorAll<HTMLElement>('[data-letter-reader]').forEach(initLetterReader);

  import { galleryImageIndexFromHash } from '../../data/gallery-image-link.mjs';

  document.querySelectorAll<HTMLElement>('[data-record-gallery]').forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const openButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-open]');
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
    const role = gallery.querySelector<HTMLElement>('[data-gallery-role]');
    const lightbox = gallery.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
    const lightboxImage = gallery.querySelector<HTMLImageElement>('[data-lightbox-main]');
    const lightboxCaption = gallery.querySelector<HTMLElement>('[data-lightbox-caption]');
    const lightboxRole = gallery.querySelector<HTMLElement>('[data-lightbox-role]');
    const lightboxCounter = gallery.querySelector<HTMLElement>('[data-lightbox-counter]');
    const zoomStage = gallery.querySelector<HTMLElement>('[data-gallery-zoom-stage]');
    const zoomLevel = gallery.querySelector<HTMLOutputElement>('[data-gallery-zoom-level]');
    const zoomIn = gallery.querySelector<HTMLButtonElement>('[data-gallery-zoom-in]');
    const zoomOut = gallery.querySelector<HTMLButtonElement>('[data-gallery-zoom-out]');
    const thumbnails = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumbnail]'),
    );
    const items = JSON.parse(gallery.dataset.galleryItems ?? '[]') as Array<{
      src: string;
      srcset?: string;
      description: string;
      role: string;
      width: number;
      height: number;
    }>;
    if (!mainImage || !openButton || items.length === 0) return;

    let activeIndex = 0;
    let zoom = 1;
    let offsetX = 0;
    let offsetY = 0;
    let pointer: { id: number; x: number; y: number; offsetX: number; offsetY: number } | undefined;
    const paintZoom = () => {
      if (!zoomStage || !lightboxImage || !lightbox?.open) return;
      const maxX = zoomStage.clientWidth * (zoom - 1) / 2;
      const maxY = zoomStage.clientHeight * (zoom - 1) / 2;
      offsetX = Math.min(maxX, Math.max(-maxX, offsetX));
      offsetY = Math.min(maxY, Math.max(-maxY, offsetY));
      lightboxImage.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${zoom})`;
      lightboxImage.sizes = `${Math.ceil(zoomStage.clientWidth * zoom)}px`;
      zoomStage.dataset.zoomed = String(zoom > 1);
      if (zoomLevel) zoomLevel.value = `${Math.round(zoom * 100)}%`;
      if (zoomIn) zoomIn.disabled = zoom >= 4;
      if (zoomOut) zoomOut.disabled = zoom <= 1;
    };
    const setZoom = (value: number) => {
      zoom = Math.max(1, Math.min(4, value));
      if (zoom === 1) { offsetX = 0; offsetY = 0; }
      paintZoom();
    };
    const displayEnlargedImage = () => {
      if (!lightboxImage || !lightbox?.open) return;
      const image = items[activeIndex];
      lightboxImage.srcset = image.srcset ?? '';
      lightboxImage.src = image.src;
      lightboxImage.alt = image.description;
      lightboxImage.width = image.width;
      lightboxImage.height = image.height;
    };
    const selectImage = (index: number) => {
      setZoom(1);
      activeIndex = (index + items.length) % items.length;
      const item = items[activeIndex];
      mainImage.srcset = item.srcset ?? '';
      mainImage.src = item.src;
      mainImage.alt = item.description;
      mainImage.width = item.width;
      mainImage.height = item.height;
      openButton.setAttribute('aria-label', ct("放大查看：{0}", {0: (item.description)}));
      thumbnails.forEach((button, thumbnailIndex) =>
        button.setAttribute('aria-current', String(thumbnailIndex === activeIndex)));
      const countLabel = gallery.dataset.pageCounterFormat?.replace('{page}', String(activeIndex + 1))
        ?? ct("第 {0} 张，共 {1} 张", {0: activeIndex + 1, 1: items.length});
      if (counter) counter.textContent = countLabel;
      if (caption) caption.textContent = item.description;
      if (role) role.textContent = item.role;
      displayEnlargedImage();
      if (lightboxCaption) lightboxCaption.textContent = item.description;
      if (lightboxRole) lightboxRole.textContent = item.role;
      if (lightboxCounter) lightboxCounter.textContent = countLabel;
      gallery.dispatchEvent(new CustomEvent('letter-image-changed', { bubbles: true, detail: activeIndex }));
    };

    gallery.addEventListener('letter-select-image', (event) => {
      const index = (event as CustomEvent<number>).detail;
      if (Number.isInteger(index) && index >= 0 && index < items.length) selectImage(index);
    });

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => {
        selectImage(index);
      });
    });

    gallery.querySelector<HTMLElement>('.record-thumbnails')?.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      const currentIndex = thumbnails.findIndex((button) => button === document.activeElement);
      if (currentIndex < 0) return;
      event.preventDefault();
      const targetIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? thumbnails.length - 1
          : (currentIndex + (event.key === 'ArrowRight' ? 1 : -1) + thumbnails.length) % thumbnails.length;
      thumbnails[targetIndex].focus();
      selectImage(targetIndex);
    });

    openButton.addEventListener('click', () => {
      lightbox?.showModal();
      setZoom(1);
      displayEnlargedImage();
    });
    zoomIn?.addEventListener('click', () => setZoom(zoom + 0.5));
    zoomOut?.addEventListener('click', () => setZoom(zoom - 0.5));
    gallery.querySelector<HTMLButtonElement>('[data-gallery-zoom-reset]')?.addEventListener('click', () => setZoom(1));
    zoomStage?.addEventListener('dblclick', () => setZoom(zoom === 1 ? 2 : 1));
    zoomStage?.addEventListener('wheel', (event) => {
      if (zoom === 1 && event.deltaY >= 0) return;
      event.preventDefault();
      setZoom(zoom + (event.deltaY < 0 ? 0.25 : -0.25));
    }, { passive: false });
    zoomStage?.addEventListener('pointerdown', (event) => {
      if (zoom <= 1 || event.button !== 0) return;
      event.preventDefault();
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY, offsetX, offsetY };
      zoomStage.setPointerCapture(event.pointerId);
      zoomStage.dataset.dragging = 'true';
    });
    zoomStage?.addEventListener('pointermove', (event) => {
      if (!pointer || event.pointerId !== pointer.id) return;
      offsetX = pointer.offsetX + event.clientX - pointer.x;
      offsetY = pointer.offsetY + event.clientY - pointer.y;
      paintZoom();
    });
    const stopDrag = () => { pointer = undefined; if (zoomStage) delete zoomStage.dataset.dragging; };
    zoomStage?.addEventListener('pointerup', stopDrag);
    zoomStage?.addEventListener('pointercancel', stopDrag);
    zoomStage?.addEventListener('lostpointercapture', stopDrag);
    lightboxImage?.addEventListener('dragstart', (event) => event.preventDefault());
    window.addEventListener('resize', paintZoom);
    gallery.querySelector<HTMLButtonElement>('[data-gallery-close]')?.addEventListener('click', () => lightbox?.close());
    gallery.querySelector<HTMLButtonElement>('[data-gallery-previous-inline]')?.addEventListener('click', () => selectImage(activeIndex - 1));
    gallery.querySelector<HTMLButtonElement>('[data-gallery-next-inline]')?.addEventListener('click', () => selectImage(activeIndex + 1));
    gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]')?.addEventListener('click', () => selectImage(activeIndex - 1));
    gallery.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => selectImage(activeIndex + 1));
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox?.addEventListener('keydown', (event) => {
      if (['+', '=', '-', '0'].includes(event.key)) {
        event.preventDefault();
        setZoom(event.key === '0' ? 1 : zoom + (event.key === '-' ? -0.5 : 0.5));
      } else if (zoom > 1 && ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key) && event.target === zoomStage) {
        event.preventDefault();
        offsetX += event.key === 'ArrowLeft' ? 40 : event.key === 'ArrowRight' ? -40 : 0;
        offsetY += event.key === 'ArrowUp' ? 40 : event.key === 'ArrowDown' ? -40 : 0;
        paintZoom();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        selectImage(activeIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        selectImage(activeIndex + 1);
		} else if (event.key === 'Escape') {
			event.preventDefault();
			lightbox.close();
      }
    });
    lightbox?.addEventListener('close', () => openButton.focus());

    gallery.querySelectorAll<HTMLElement>('[data-gallery-swipe]').forEach((surface) => {
      let startX = 0;
      let startY = 0;
      surface.addEventListener('touchstart', (event) => {
        startX = event.changedTouches[0]?.clientX ?? 0;
        startY = event.changedTouches[0]?.clientY ?? 0;
      }, { passive: true });
      surface.addEventListener('touchend', (event) => {
        if (items.length < 2 || lightbox?.open && zoom > 1) return;
        const deltaX = (event.changedTouches[0]?.clientX ?? startX) - startX;
        const deltaY = (event.changedTouches[0]?.clientY ?? startY) - startY;
        if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.15) return;
        selectImage(activeIndex + (deltaX < 0 ? 1 : -1));
      }, { passive: true });
    });

    const selectLinkedImage = () => {
      const index = galleryImageIndexFromHash(window.location.hash, items.length);
      if (index === undefined) return;
      selectImage(index);
      gallery.scrollIntoView({ block: 'start' });
    };
    selectImage(0);
    selectLinkedImage();
    window.addEventListener('hashchange', selectLinkedImage);
  });

  const browseStateKey = 'ljm-archive-browse-state';
  const recordPage = document.querySelector<HTMLElement>('[data-record-id]');
  const backLink = document.querySelector<HTMLAnchorElement>('[data-record-back]');

  try {
    const browseState = JSON.parse(window.sessionStorage.getItem(browseStateKey) ?? 'null');
    if (
      browseState?.targetId === recordPage?.dataset.recordId &&
      typeof browseState.href === 'string' &&
      /^\/(?:(?:en|th|ja|ko|zh-hant)\/)?archive\/(?:[?#]|$)/.test(browseState.href)
    ) {
      const localizedBrowseState = { ...browseState, href: clientPath(browseState.href), restorePending: true };
      window.sessionStorage.setItem(
        browseStateKey,
        JSON.stringify(localizedBrowseState),
      );
      if (backLink) {
        backLink.href = clientPath(browseState.href);
        backLink.textContent = ct("← 返回筛选结果");
      }

      document.querySelectorAll<HTMLAnchorElement>('[data-record-nav]').forEach((link) => {
        link.addEventListener('click', () => {
          window.sessionStorage.setItem(
            browseStateKey,
            JSON.stringify({ ...localizedBrowseState, targetId: link.dataset.recordTarget ?? '', restorePending: true }),
          );
        });
      });
    }
  } catch {
    // 无法使用会话存储时，返回链接仍按当前分类工作。
  }

  const citation = document.querySelector<HTMLElement>('[data-record-citation]');
  const citationFeedback = citation?.querySelector<HTMLElement>('[data-citation-feedback]');
  let citationFeedbackTimer = 0;
  const showCitationFeedback = (message: string) => {
    if (!citationFeedback) return;
    citationFeedback.textContent = message;
    window.clearTimeout(citationFeedbackTimer);
    citationFeedbackTimer = window.setTimeout(() => {
      citationFeedback.textContent = '';
    }, 4000);
  };
  const copyText = async (value: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }
    const fallback = document.createElement('textarea');
    fallback.value = value;
    fallback.setAttribute('readonly', '');
    fallback.style.position = 'fixed';
    fallback.style.opacity = '0';
    document.body.append(fallback);
    fallback.select();
    const copied = document.execCommand('copy');
    fallback.remove();
    if (!copied) throw new Error('copy failed');
  };
  const publicRecordUrl = () =>
    document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? window.location.href;
  const accessDate = () => new Intl.DateTimeFormat(clientLocale(), {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(new Date());

  citation?.querySelector<HTMLButtonElement>('[data-copy-record-link]')?.addEventListener('click', async () => {
    try {
      await copyText(publicRecordUrl());
      showCitationFeedback(ct("页面链接已复制。"));
    } catch {
      showCitationFeedback(ct("复制失败，请从浏览器地址栏复制。"));
    }
  });

  citation?.querySelector<HTMLButtonElement>('[data-copy-record-citation]')?.addEventListener('click', async () => {
    const title = citation.dataset.recordTitle ?? '';
    const identifier = citation.dataset.recordIdentifier ?? '';
    const citationText = ct("《{0}》（{1}），老旧默片，{2}，访问日期：{3}。", {0: (title), 1: (identifier), 2: (publicRecordUrl()), 3: (accessDate())});
    try {
      await copyText(citationText);
      showCitationFeedback(ct("规范引用已复制。"));
    } catch {
      showCitationFeedback(ct("复制失败，请手动选择上方引用信息。"));
    }
  });
</script>

