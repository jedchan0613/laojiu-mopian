    color: var(--site-accent);
    border-right: 1px solid #bcb5a4;
    font-size: var(--site-text-micro);
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .record-image figcaption small {
    flex: 0 0 auto;
    color: #817b70;
    font-size: var(--site-text-micro);
  }

  .record-gallery-controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin-top: -0.1rem;
  }

  .record-gallery-controls > span {
    color: #817b70;
    font-size: var(--site-text-micro);
    letter-spacing: 0.06em;
    text-align: center;
  }

  .gallery-step {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.42rem 0.7rem;
    color: #575349;
    background: rgba(248, 244, 234, 0.42);
    border: 1px solid #bdb5a5;
    cursor: pointer;
    font: inherit;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }

  .gallery-step-previous {
    justify-self: start;
  }

  .gallery-step-next {
    justify-self: end;
  }

  .gallery-step:hover,
  .gallery-step:focus-visible {
    color: var(--site-accent);
    border-color: var(--site-accent);
    outline: 0;
  }

  .record-thumbnails {
    display: grid;
    grid-auto-columns: minmax(4.5rem, 5.5rem);
    grid-auto-flow: column;
    gap: 0.55rem;
    padding: 0.15rem 0 0.35rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .record-thumbnails button {
    position: relative;
    aspect-ratio: 3 / 2;
    padding: 0;
    overflow: hidden;
    background: #ded7c8;
    border: 1px solid #bdb5a5;
    cursor: pointer;
    opacity: 0.62;
  }

  .record-thumbnails button[aria-current='true'] {
    border-color: var(--site-accent);
    box-shadow: 0 0 0 2px var(--site-accent);
    opacity: 1;
  }

  .record-thumbnails button:focus-visible {
    outline: 2px solid #4f4b43;
    outline-offset: 3px;
    opacity: 1;
  }

  .record-thumbnails img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .record-thumbnails button > span {
    position: absolute;
    right: 0.18rem;
    bottom: 0.18rem;
    padding: 0.12rem 0.28rem;
    color: #f7f0e4;
    background: rgba(38, 37, 33, 0.76);
    font-size: 0.58rem;
    line-height: 1.35;
    letter-spacing: 0.06em;
  }

  .record-thumbnails button[aria-current='true'] > span {
    background: var(--site-accent);
  }

  .record-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    color: #f4eee3;
    background: rgba(25, 25, 23, 0.97);
    border: 0;
  }

  .record-lightbox::backdrop {
    background: rgba(16, 16, 14, 0.92);
  }

  .lightbox-shell {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) 5rem;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 3.8rem clamp(1rem, 3vw, 2.5rem) 1rem;
  }

  .lightbox-close,
  .lightbox-previous,
  .lightbox-next {
    display: grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    color: #f4eee3;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.28);
    cursor: pointer;
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible,
  .lightbox-previous:hover,
  .lightbox-previous:focus-visible,
  .lightbox-next:hover,
  .lightbox-next:focus-visible {
    background: rgba(255, 255, 255, 0.17);
    outline: 2px solid #f4eee3;
    outline-offset: 2px;
  }

  .lightbox-close {
    position: absolute;
    top: 0.8rem;
    right: clamp(1rem, 3vw, 2.5rem);
    z-index: 1;
    min-width: auto;
    padding: 0.55rem 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .lightbox-previous,
  .lightbox-next {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    min-height: 4.25rem;
    font-size: 1.15rem;
  }

  .lightbox-previous {
    grid-column: 1;
    grid-row: 1;
  }

  .lightbox-next {
    grid-column: 3;
    grid-row: 1;
  }

  .lightbox-previous small,
  .lightbox-next small {
    color: inherit;
    font-size: 0.66rem;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .lightbox-figure {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    grid-template-rows: minmax(0, 1fr) auto;
    align-self: stretch;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0 clamp(0.6rem, 2vw, 1.5rem);
    touch-action: pan-y;
  }

  .lightbox-figure img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .lightbox-figure figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.7rem;
    color: #cfc7ba;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1.6;
  }

  .lightbox-figure figcaption small {
    flex: 0 0 auto;
    font-size: inherit;
  }

  .lightbox-caption-copy strong {
    color: #f0a796;
    border-right-color: rgba(255, 255, 255, 0.28);
  }

  .facts-heading {
    margin: 0 0 1rem;
    color: #6b665b;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    line-height: 1.8;
  }

  .record-facts,
  .section-facts {
    margin: 0;
    border-top: 1px solid #c9c2b2;
  }

  .record-facts > div,
  .section-facts > div {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.75fr) minmax(0, 1.25fr);
    gap: 0.5rem 1rem;
    padding: 0.62rem 0;
    border-bottom: 1px solid #c9c2b2;
  }

  .record-facts dt,
  .section-facts dt {
    color: #777165;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    line-height: 1.55;
  }

  .record-facts dd,
  .section-facts dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .fact-filter-link {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.15rem 0.55rem;
    color: inherit;
    text-decoration-color: #9a9386;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .fact-filter-link small {
    display: inline;
    margin: 0;
    color: var(--site-accent);
    font-family: inherit;
    letter-spacing: 0.05em;
  }

  .fact-filter-link:hover,
  .fact-filter-link:focus-visible {
    color: var(--site-accent);
    text-decoration-color: currentColor;
  }

  .record-sidebar-meta {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid #aaa294;
  }

  .record-sidebar-meta-group {
    min-width: 0;
  }

  .record-sidebar-meta-group + .record-sidebar-meta-group {
    padding-top: 0.85rem;
    border-top: 1px solid #d0c8b8;
  }

  .record-sidebar-meta-group h3 {
    margin: 0 0 0.45rem;
    color: #716b60;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.11em;
    line-height: 1.6;
  }

  .record-tags--sidebar {
    gap: 0.25rem 1.25rem;
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .record-tags--sidebar li:not(:last-child)::after {
    right: -0.68rem;
  }

  .record-updated-date p {
    margin: 0;
    color: #5f5a50;
    font-size: 0.82rem;
    line-height: 1.65;
  }

  dt small,
  dd small {
    display: block;
    margin-top: 0.2rem;
    color: #8a8478;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: var(--site-text-micro);
    letter-spacing: 0.08em;
  }

  .record-notes {
    max-width: 58rem;
    margin-top: clamp(1.25rem, 2.4vw, 2rem);
  }

  .record-section {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: 1.35rem 1rem 1.5rem;
    background: var(--site-paper);
    border-top: 1px solid #c8c0b1;
    border-left: 3px solid rgba(154, 63, 46, 0.32);
  }

  .record-section + .record-section,
  .record-section + .management-information {
    margin-top: 0.75rem;
  }

  .record-section:last-child {
    border-bottom: 1px solid #bcb5a4;
  }

  .management-information {
    padding: 0 1rem;
    background: rgba(248, 244, 234, 0.2);
    border-top: 1px solid #bcb5a4;
    border-bottom: 1px solid #bcb5a4;
  }

  .management-information > summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 0;
    color: #6b665b;
    cursor: pointer;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    line-height: 1.8;
    list-style: none;
  }

  .management-information > summary::-webkit-details-marker {
    display: none;
  }

  .management-information > summary::after {
    flex: 0 0 auto;
    content: '＋';
  }

  .management-information[open] > summary::after {
    content: '－';
  }

  .management-information > summary small {
    margin-left: auto;
    color: #827c70;
    font-size: var(--site-text-micro);
    letter-spacing: 0.06em;
    text-align: right;
  }

  .management-information .section-facts {
    padding-bottom: 0.4rem;
  }

  .record-related {
    max-width: 58rem;
    margin-top: clamp(2.8rem, 5vw, 4.2rem);
    padding-top: 1.25rem;
    border-top: 1px solid #bcb5a4;
  }

  .record-related-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
  }

  .record-related-heading h2,
  .record-related-heading span {
    margin: 0;
  }

  .record-related-heading h2 {
    color: #5f5a50;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .record-related-heading span {
    color: #777165;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .record-related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .record-related-grid a {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    padding: 0.55rem;
    color: inherit;
    border: 1px solid #c4bdad;
    text-decoration: none;
  }

  .record-related-grid a:hover,
  .record-related-grid a:focus-visible {
    border-color: #6b665b;
  }

  .record-related-grid figure {
    aspect-ratio: 3 / 2;
    margin: 0;
    overflow: hidden;
    background: #dfd8c9;
    border: 1px solid #d0c8b8;
  }

  .record-related-grid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .record-related-grid a > div {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 0.65rem 0.15rem 0.1rem;
  }

  .record-related-grid small,
  .record-related-grid span {
    color: #787267;
    font-size: var(--site-text-micro);
    line-height: 1.5;
  }

  .record-related-grid small {
    color: var(--site-accent);
  }

  .record-related-grid strong {
    overflow-wrap: anywhere;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.55;
  }

  .record-usage {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    max-width: 58rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: 1.2rem 1.1rem 1.3rem;
    background: var(--site-paper);
    border: 1px solid #c7bfaf;
    border-left: 3px solid var(--site-accent);
  }

  .record-usage-heading h2,
  .record-usage-summary p,
  .record-usage-summary small,
  .record-downloads p {
    margin: 0;
  }

  .record-usage-heading h2 {
    color: #6b665b;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    line-height: 1.8;
  }

  .record-usage-content,
  .record-usage-summary {
    display: grid;
    gap: 0.38rem;
  }

  .record-usage-summary > span {
    color: #7b756a;
    font-size: var(--site-text-micro);
    letter-spacing: 0.08em;
  }

  .record-usage-summary strong {
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.6;
  }

  .record-usage-summary p,
  .record-usage-summary small,
  .record-downloads p {
    color: #656057;
    font-size: 0.78rem;
    line-height: 1.75;
  }

  .record-usage-summary small {
    color: #7b756a;
  }

  .record-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.7rem;
  }

  .record-downloads a {
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.75rem;
  }

  .record-downloads a small {
    color: inherit;
    font-size: var(--site-text-micro);
  }

  .record-downloads a:hover,
  .record-downloads a:focus-visible {
    color: #fbf5e9;
    background: #7f3427;
    border-color: #7f3427;
  }

  .record-downloads p {
    flex-basis: 100%;
  }

  .record-neighbors {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 1.25rem 0 0;
    border-top: 1px solid #bcb5a4;
  }

  .record-citation {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    max-width: 58rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: 1.2rem 1.1rem 1.3rem;
    background: var(--site-paper);
    border: 1px solid #c7bfaf;
  }

  .record-citation-heading h2,
  .citation-preview,
  .citation-feedback {
    margin: 0;
  }

  .record-citation-heading h2 {
    color: #6b665b;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    line-height: 1.8;
  }

  .citation-preview {
    color: #5f5a50;
    font-size: 0.84rem;
    line-height: 1.85;
  }

  .citation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.9rem;
  }

  .citation-actions button {
    letter-spacing: 0.06em;
  }

  .citation-actions button:hover,
  .citation-actions button:focus-visible {
    color: var(--site-accent);
    border-color: var(--site-accent);
  }

  .citation-feedback {
    min-height: 1.5rem;
    margin-top: 0.5rem;
    color: var(--site-accent);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .record-neighbors > p {
    margin: 0 0 1rem;
    color: #777165;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  .record-neighbors > div {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .record-neighbors a {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    padding: 1rem;
    color: inherit;
    border: 1px solid #c4bdad;
    text-decoration: none;
  }

  .record-neighbors a.is-next {
    grid-column: 2;
    text-align: right;
  }

  .record-neighbors a:hover,
  .record-neighbors a:focus-visible {
    border-color: #6b665b;
  }

  .record-neighbors a:focus-visible {
    outline: 2px solid #575349;
    outline-offset: 3px;
  }

  .record-neighbors small,
  .record-neighbors span {
    color: #7b756a;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }

  .record-neighbors strong {
    overflow-wrap: anywhere;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.55;
  }

  .record-section > h2 {
    margin: 0;
    color: #6b665b;
	font-size: 0.86rem;
	font-weight: 600;
    letter-spacing: 0.15em;
    line-height: 1.8;
  }

  .section-content > p,
  .subsection p {
    margin: 0;
    font-size: 1rem;
    line-height: 2;
  }

  .subsection {
    margin-top: 2rem;
  }

  .section-content > .subsection:first-child {
    margin-top: 0;
  }

  .subsection h3 {
    margin: 0 0 0.75rem;
    color: #777165;
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .transcription {
    white-space: pre-line;
  }

  .record-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.8rem;
    margin: 0;
    padding: 0;
    color: #5f5b51;
    font-size: 0.88rem;
    line-height: 1.8;
    list-style: none;
  }

  .record-tags li {
    position: relative;
  }

  .record-tags a {
    color: inherit;
    text-decoration-color: #9a9386;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .record-tags a:hover,
  .record-tags a:focus-visible {
    color: var(--site-accent);
    text-decoration-color: currentColor;
  }

  .record-tags li:not(:last-child)::after {
    position: absolute;
    right: -0.9rem;
    color: #a8a195;
    content: '·';
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .record-page {
      padding-top: 1.65rem;
    }

    .breadcrumb-current {
      max-width: 100%;
    }

    .record-heading {
      margin-top: 1.45rem;
    }

    .record-lead {
      margin-top: 0.85rem;
      line-height: 1.8;
    }

    .record-sheet {
      grid-template-columns: 1fr;
      gap: 2.1rem;
      margin-top: 1.55rem;
      padding-top: 1.15rem;
    }

    .record-sheet--letter[data-letter-mode='compare'] {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .record-sheet--letter[data-letter-mode='compare'] > .letter-transcription,
    .record-sheet--letter[data-letter-mode='compare'] > .record-gallery {
      grid-column: 1;
    }

    .letter-reading-header {
      grid-template-columns: 1fr;
      padding: 0.8rem;
    }

    .letter-reading-controls {
      width: 100%;
      justify-content: space-between;
    }

    .letter-reading-modes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
    }

    .letter-reading-modes button {
      padding-inline: 0.4rem;
    }

    .letter-text-size {
      margin-left: auto;
    }

    .letter-transcription {
      padding: 1rem 0.9rem 1.2rem;
    }

    .letter-transcription-text {
      margin: 1.25rem auto 1.5rem;
      font-size: 1rem;
      line-height: 2;
    }

    .record-sheet--letter[data-letter-size='small'] .letter-transcription-text {
      font-size: 0.92rem;
    }

    .record-sheet--letter[data-letter-size='large'] .letter-transcription-text {
      font-size: 1.18rem;
    }

    .record-image-hint {
      opacity: 1;
      transform: none;
    }

    .record-gallery-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .record-gallery-controls > span {
      display: none;
    }

    .lightbox-shell {
      grid-template-columns: 3.35rem minmax(0, 1fr) 3.35rem;
      padding: 3.7rem 0.55rem 0.75rem;
    }

    .lightbox-figure {
      padding: 0 0.25rem;
    }

    .lightbox-close {
      right: 0.75rem;
    }

    .record-facts > div,
    .section-facts > div {
      grid-template-columns: minmax(6.5rem, 0.55fr) minmax(0, 1.45fr);
    }

    .record-notes {
      margin-top: 1.25rem;
    }

    .record-section {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.15rem 0.85rem 1.3rem;
    }

    .record-citation {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .record-usage {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .record-related-grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .record-related-grid a {
      grid-template-columns: 7rem minmax(0, 1fr);
      grid-template-rows: auto;
      gap: 0.75rem;
    }

    .record-related-grid figure {
      aspect-ratio: 4 / 3;
    }

    .record-related-grid a > div {
      padding-top: 0.1rem;
    }

    .record-neighbors > div {
      grid-template-columns: 1fr;
    }

