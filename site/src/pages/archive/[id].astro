---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteIcon from '../../components/SiteIcon.astro';
import { archiveItems, type ArchiveItem } from '../../data/archive';
import {
  archiveCategories,
  getArchiveCategorySlug,
} from '../../data/archive-categories';
import {
  createArchiveRecordView,
  displayCode,
  getSpecificMetadataFacts,
  isPublishedArchiveItem,
  type DisplayFact,
} from '../../data/archive-view';
import { getCodeEntry } from '../../data/code-dictionary';
import { getPublicUsagePolicy } from '../../data/archive-rights';
import { getResponsiveImage } from '../../data/responsive-images';

export function getStaticPaths() {
  return archiveItems.filter(isPublishedArchiveItem).map((item) => ({
    params: { id: item.core.item_id },
    props: { item },
  }));
}

interface Props {
  item: ArchiveItem;
}

const { item } = Astro.props;
const view = createArchiveRecordView(item);
const publishedViews = archiveItems.filter(isPublishedArchiveItem).map(createArchiveRecordView);
const currentCategorySlug = getArchiveCategorySlug(view.objectType);
const currentCategory = archiveCategories.find((category) => category.slug === currentCategorySlug);
const categoryViews = publishedViews.filter(
  (candidate) => getArchiveCategorySlug(candidate.objectType) === currentCategorySlug,
);
const categoryIndex = categoryViews.findIndex((candidate) => candidate.id === view.id);
const previousView = categoryIndex > 0 ? categoryViews[categoryIndex - 1] : undefined;
const nextView = categoryIndex >= 0 && categoryIndex < categoryViews.length - 1
  ? categoryViews[categoryIndex + 1]
  : undefined;
const defaultBackHref = currentCategorySlug ? `/archive/?category=${currentCategorySlug}` : '/archive/';

interface LinkedDisplayFact extends DisplayFact {
  href?: string;
}

interface RecordStatusFact {
  label: string;
  value: string;
  description: string;
}

const hasText = (value: string | undefined) => Boolean(value?.trim());
const compactFacts = <T extends DisplayFact>(facts: T[]) => facts.filter((fact) => hasText(fact.value));
const joinText = (value: string[] | undefined) => value?.filter(hasText).join('、') ?? '';
const archiveFilterHref = (name: 'category' | 'decade' | 'place' | 'tag', value: string) =>
  `/archive/?${name}=${encodeURIComponent(value)}`;
const normalizePlaceLabel = (value: string) => value.trim().replace(/[省市区县]$/, '');
const preferredPlaceFilter = view.placeFilters.find((place) => place === view.placeDisplay)
  ?? view.placeFilters.find(
    (place) => normalizePlaceLabel(place) === normalizePlaceLabel(view.placeDisplay),
  )
  ?? (view.placeFilters.length === 1 && !view.placeDisplay.includes('未知')
    ? view.placeFilters[0]
    : undefined);
const formatDisplayDate = (value: string | undefined) => {
  const match = value?.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!match) return value?.trim() ?? '';
  return `${match[1]}年${Number(match[2])}月${Number(match[3])}日`;
};
const codeStatusFact = (label: string, code: string | undefined): RecordStatusFact | undefined => {
  if (!code) return undefined;
  const entry = getCodeEntry(code);
  return {
    label,
    value: entry?.label ?? code,
    description: entry?.definition ?? '以当前档案记录为准。',
  };
};

const basicFacts = compactFacts<LinkedDisplayFact>([
  {
    label: '类型',
    value: view.typeLabel,
    href: currentCategorySlug ? archiveFilterHref('category', currentCategorySlug) : undefined,
  },
  {
    label: '年代',
    value: view.dateDisplay,
    href: view.decade ? archiveFilterHref('decade', view.decade) : undefined,
  },
  {
    label: '地点',
    value: view.placeDisplay,
    href: preferredPlaceFilter ? archiveFilterHref('place', preferredPlaceFilter) : undefined,
  },
  { label: '人物', value: joinText(item.core.people) },
]);

const recordStatusFacts = [
  codeStatusFact('研究状态', item.core.research_status),
  codeStatusFact('证据等级', item.core.evidence_level),
  item.core.updated_date
    ? {
      label: '最后更新',
      value: formatDisplayDate(item.core.updated_date),
      description: '公开档案最近一次修改的日期。',
    }
    : undefined,
].filter((fact): fact is RecordStatusFact => Boolean(fact));

const specificFacts = getSpecificMetadataFacts(item);
const specificTechnicalFacts = getSpecificMetadataFacts(item, { includeCodes: true });

const researchManagementFacts = compactFacts([
  { label: '永久编号', value: view.id },
  { label: '收藏品编码', value: view.collectionCode },
  { label: '对象类型', value: view.typeLabel, code: item.core.object_type },
  { label: '获得方式', value: displayCode(item.core.acquisition_method) },
  { label: '来源地点', value: item.core.source_place ?? '' },
  { label: '研究状态', value: displayCode(item.core.research_status) },
  { label: '证据等级', value: displayCode(item.core.evidence_level) },
  { label: '数字化状态', value: displayCode(item.core.digitization_status) },
  { label: '转录状态', value: displayCode(item.core.transcription_status) },
  { label: '备份状态', value: displayCode(item.core.backup_status) },
  { label: '保存等级', value: displayCode(item.core.condition_grade) },
  { label: '发布副本', value: view.images.length > 0 ? `${view.images.length} 个文件` : '' },
  { label: '隐私等级', value: displayCode(item.core.privacy_level) },
  { label: '权利状态', value: displayCode(item.core.rights_status) },
  { label: '利用状态', value: displayCode(item.core.use_status) },
  { label: '档案状态', value: displayCode(item.core.record_status) },
	...specificTechnicalFacts.map((fact) => ({
		label: `专属维度 · ${fact.label}`,
		value: fact.value,
		code: fact.code,
	})),
]);
const getImageRole = (description: string, index: number) => {
  const matchedRole = ['正面', '背面', '封面', '内页', '全景', '细节'].find((role) =>
    description.includes(role));
  return matchedRole ?? `图片 ${index + 1}`;
};
const galleryImages = view.images.map((source, index) => ({
  ...getResponsiveImage(source),
  description: view.imageDescriptions[index],
  role: getImageRole(view.imageDescriptions[index], index),
}));
const revisionNote = item.public_view.revision_note?.trim() ?? '';
const hasNarrativeContent = hasText(view.transcription) || hasText(item.core.provenance_notes);
const hasTags = view.tags.length > 0;
const usagePolicy = getPublicUsagePolicy(item.core.rights_status);
const downloadableImages = usagePolicy.canDownloadPublicationCopy
  ? view.images.map((source, index) => ({
    source,
    description: view.imageDescriptions[index],
    filename: `${view.id}-${String(index + 1).padStart(2, '0')}.${source.split('.').at(-1) ?? 'jpg'}`,
  }))
  : [];
const relatedRecordEntries = publishedViews
  .filter((candidate) => candidate.id !== view.id)
  .map((candidate) => {
    const sharedTags = candidate.tags.filter((tag) => view.tags.includes(tag));
    const sharedPlaces = candidate.placeFilters.filter((place) => view.placeFilters.includes(place));
    const sameDecade = Boolean(view.decade && candidate.decade === view.decade);
    const candidateCategorySlug = getArchiveCategorySlug(candidate.objectType);
    const sameCategory = Boolean(currentCategorySlug && candidateCategorySlug === currentCategorySlug);
    const reasons = [
      sharedTags.length ? `共同线索：${sharedTags.slice(0, 2).join('、')}` : '',
      sharedPlaces.length ? `关联地点：${sharedPlaces.slice(0, 2).join('、')}` : '',
      sameDecade ? `同属${view.decade}年代` : '',
      sameCategory ? `同属${currentCategory?.label ?? '相近类型'}` : '',
    ].filter(Boolean);
    const score = sharedTags.length * 4 + sharedPlaces.length * 3 + Number(sameDecade) * 2
      + Number(sameCategory) * 2 + Number(candidate.objectType !== view.objectType) * 0.25;
    return {
      view: candidate,
      score,
      reason: reasons[0] ?? '',
      coverImage: candidate.images[0] ? getResponsiveImage(candidate.images[0]) : undefined,
    };
  })
  .filter((entry) => entry.score > 0 && entry.reason)
  .sort((left, right) => right.score - left.score || left.view.title.localeCompare(right.view.title, 'zh-CN'))
  .slice(0, 3);
const recordUrl = Astro.site ? new URL(`/archive/${view.id}/`, Astro.site) : undefined;
const archiveIndexUrl = Astro.site ? new URL('/archive/', Astro.site) : undefined;
const recordStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: view.title,
  identifier: view.id,
  description: view.description || `${view.typeLabel}，${view.dateDisplay || '年代未知'}。`,
  dateCreated: item.core.created_date,
  dateModified: item.core.updated_date,
  temporalCoverage: view.dateDisplay || undefined,
  contentLocation: hasText(view.placeDisplay) && !view.placeDisplay.includes('未知')
    ? { '@type': 'Place', name: view.placeDisplay }
    : undefined,
  keywords: view.tags.length ? view.tags : undefined,
  image: Astro.site ? galleryImages.map((image) => new URL(image.src, Astro.site).href) : undefined,
  url: recordUrl?.href,
  isPartOf: {
    '@type': 'CollectionPage',
    name: '老旧默片',
    url: archiveIndexUrl?.href,
  },
};
---

<BaseLayout
  title={`${view.title}｜老旧默片`}
  description={view.description || `${view.title}，${view.typeLabel}，${view.dateDisplay || '年代未知'}。`}
  image={galleryImages[0]?.src}
  pageType="article"
  structuredData={recordStructuredData}
>
  <article class="record-page" data-record-id={view.id}>
    <a class="back-link ui-text-link" href={defaultBackHref} data-record-back>← 返回档案</a>

    <header class="record-heading">
      <p class="section-mark icon-heading"><SiteIcon name="archive" /><span>ARCHIVE RECORD · {view.typeLabel}</span></p>
      <h1>{view.title}</h1>
      {hasText(view.description) && <p class="record-lead">{view.description}</p>}
    </header>

    <div class="record-sheet">
      {
        galleryImages.length > 0 && (
          <div
            class="record-gallery"
            data-record-gallery
            data-gallery-items={JSON.stringify(galleryImages.map((image) => ({
              src: image.src,
              srcset: image.srcset,
              description: image.description,
              role: image.role,
              width: image.width,
              height: image.height,
            })))}
            aria-label="档案图片"
          >
            <figure class="record-image">
              <button
                class="record-image-open"
                type="button"
                data-gallery-open
                data-gallery-swipe
                aria-label={`放大查看：${galleryImages[0].description}`}
              >
                <img
                  data-gallery-main
                  src={galleryImages[0].src}
                  srcset={galleryImages[0].srcset}
                  sizes="(max-width: 760px) calc(100vw - 32px), 700px"
                  alt={galleryImages[0].description}
                  width={galleryImages[0].width}
                  height={galleryImages[0].height}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
                <span class="record-image-hint">放大查看</span>
              </button>
              <figcaption>
                <span class="record-image-caption">
                  <strong data-gallery-role>{galleryImages[0].role}</strong>
                  <span data-gallery-caption>{galleryImages[0].description}</span>
                </span>
                <small data-gallery-counter aria-live="polite">第 1 张，共 {galleryImages.length} 张</small>
              </figcaption>
            </figure>
            {galleryImages.length > 1 && (
              <div class="record-gallery-controls" aria-label="切换当前档案图片">
                <button class="gallery-step gallery-step-previous" type="button" data-gallery-previous-inline>
                  <span aria-hidden="true">←</span> 上一张
                </button>
                <span>点击主图可进入大图查看</span>
                <button class="gallery-step gallery-step-next" type="button" data-gallery-next-inline>
                  下一张 <span aria-hidden="true">→</span>
                </button>
              </div>
            )}
            {galleryImages.length > 1 && (
              <div class="record-thumbnails" aria-label="切换档案图片">
                {galleryImages.map((image, index) => (
                  <button
                    type="button"
                    aria-label={`查看第 ${index + 1} 张图片：${image.description}`}
                    aria-current={index === 0 ? 'true' : 'false'}
                    data-gallery-thumbnail
                    data-gallery-src={image.src}
                    data-gallery-srcset={image.srcset}
                    data-gallery-alt={image.description}
                    data-gallery-width={image.width}
                    data-gallery-height={image.height}
                    data-gallery-index={index + 1}
                  >
                    <img
                      src={image.src}
                      srcset={image.srcset}
                      sizes="88px"
                      alt=""
                      width="180"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{image.role}</span>
                  </button>
                ))}
              </div>
            )}

            <dialog class="record-lightbox" data-gallery-lightbox aria-label="放大查看档案图片">
              <div class="lightbox-shell">
                <button class="lightbox-close" type="button" data-gallery-close aria-label="关闭放大图片">关闭 ×</button>
                {galleryImages.length > 1 && (
                  <button class="lightbox-previous" type="button" data-gallery-previous aria-label="查看上一张图片">
                    <span aria-hidden="true">←</span><small>上一张</small>
                  </button>
                )}
                <figure class="lightbox-figure" data-gallery-swipe>
                  <img
                    data-lightbox-main
                    src={galleryImages[0].src}
                    srcset={galleryImages[0].srcset}
                    sizes="100vw"
                    alt={galleryImages[0].description}
                    width={galleryImages[0].width}
                    height={galleryImages[0].height}
                    decoding="async"
                  />
                  <figcaption>
                    <span class="lightbox-caption-copy">
                      <strong data-lightbox-role>{galleryImages[0].role}</strong>
                      <span data-lightbox-caption>{galleryImages[0].description}</span>
                    </span>
                    <small data-lightbox-counter>第 1 张，共 {galleryImages.length} 张</small>
                  </figcaption>
                </figure>
                {galleryImages.length > 1 && (
                  <button class="lightbox-next" type="button" data-gallery-next aria-label="查看下一张图片">
                    <span aria-hidden="true">→</span><small>下一张</small>
                  </button>
                )}
              </div>
            </dialog>
          </div>
        )
      }

      <section aria-labelledby="basic-heading">
        <h2 class="facts-heading icon-heading" id="basic-heading"><SiteIcon name="details" /><span>基本信息</span></h2>
        <dl class="record-facts">
          {
            basicFacts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>
                  {fact.href ? (
                    <a class="fact-filter-link" href={fact.href}>
                      {fact.value}
                      <small>查看相关档案 →</small>
                    </a>
                  ) : fact.value}
                  {fact.code && <small>{fact.code}</small>}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    {recordStatusFacts.length > 0 && (
      <aside class="record-status" aria-labelledby="record-status-heading">
        <div class="record-status-heading">
          <div>
            <p>CURRENT RECORD STATUS</p>
            <h2 class="icon-heading" id="record-status-heading"><SiteIcon name="status" /><span>资料状态</span></h2>
          </div>
          <a href="/about/#research">了解整理与判断方式 →</a>
        </div>
        <dl>
          {recordStatusFacts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}<small>{fact.description}</small></dd>
            </div>
          ))}
        </dl>
        {hasText(revisionNote) && (
          <div class="record-revision-note">
            <strong>最近修订</strong>
            <p>{revisionNote}</p>
          </div>
        )}
      </aside>
    )}

    <div class="record-notes">
      {
        hasNarrativeContent && (
          <section class="record-section" aria-labelledby="description-heading">
            <h2 class="icon-heading" id="description-heading"><SiteIcon name="story" /><span>故事与原文</span></h2>
            <div class="section-content">
              {hasText(item.core.provenance_notes) && (
                <div class="subsection">
                  <h3>流传线索</h3>
                  <p>{item.core.provenance_notes}</p>
                </div>
              )}
              {hasText(view.transcription) && (
                <div class="subsection">
                  <h3>原文 / 转录</h3>
                  <p class="transcription">{view.transcription}</p>
                </div>
              )}
            </div>
          </section>
        )
      }

      {
        hasTags && (
          <section class="record-section" aria-labelledby="tags-heading">
            <h2 class="icon-heading" id="tags-heading"><SiteIcon name="tag" /><span>标签</span></h2>
            <div class="section-content">
              <ul class="record-tags">
                {view.tags.map((tag) => (
                  <li><a href={archiveFilterHref('tag', tag)}>{tag}</a></li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      {
        specificFacts.length > 0 && (
          <section class="record-section" aria-labelledby="specific-heading">
            <h2 class="icon-heading" id="specific-heading"><SiteIcon name="details" /><span>藏品细节</span></h2>
            <dl class="section-facts">
              {specificFacts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        researchManagementFacts.length > 0 && (
          <details class="management-information">
            <summary>
              <span class="icon-heading"><SiteIcon name="archive" /><span>档案信息</span></span>
              <small>{researchManagementFacts.length} 项 · 包含编号与技术代码</small>
            </summary>
            <dl class="section-facts">
              {researchManagementFacts.map((fact) => (
                <div>
                  <dt>
                    {fact.label}
                    {fact.code && <small>{fact.code}</small>}
                  </dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </details>
        )
      }
    </div>

    {relatedRecordEntries.length > 0 && (
      <section class="record-related" aria-labelledby="record-related-heading">
        <div class="record-related-heading">
          <p>RELATED RECORDS</p>
          <h2 class="icon-heading" id="record-related-heading"><SiteIcon name="related" /><span>沿着线索继续看</span></h2>
          <span>根据共同标签、地点、年代或分类自动关联。</span>
        </div>
        <div class="record-related-grid">
          {relatedRecordEntries.map((entry) => (
            <a href={`/archive/${entry.view.id}/`} data-record-nav data-record-target={entry.view.id}>
              <figure>
                {entry.coverImage && (
                  <img
                    src={entry.coverImage.src}
                    srcset={entry.coverImage.srcset}
                    sizes="(max-width: 760px) 112px, 240px"
                    alt={entry.view.imageDescriptions[0]}
                    width={entry.coverImage.width}
                    height={entry.coverImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </figure>
              <div>
                <small>{entry.reason}</small>
                <strong>{entry.view.title}</strong>
                <span>{entry.view.typeLabel} · {entry.view.dateDisplay}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section
      class="record-usage"
      aria-labelledby="record-usage-heading"
      data-record-usage
      data-rights-status={item.core.rights_status ?? 'UNK'}
      data-download-available={String(usagePolicy.canDownloadPublicationCopy)}
    >
      <div class="record-usage-heading">
        <p>RIGHTS AND USE</p>
        <h2 class="icon-heading" id="record-usage-heading"><SiteIcon name="rights" /><span>使用与下载</span></h2>
      </div>
      <div class="record-usage-content">
        <div class="record-usage-summary">
          <span>权利状态 · {usagePolicy.statusLabel}</span>
          <strong>{usagePolicy.title}</strong>
          <p>{usagePolicy.description}</p>
          <small>{usagePolicy.attribution}</small>
        </div>
        {downloadableImages.length > 0 && (
          <div class="record-downloads" aria-label="可下载的网页发布副本">
            {downloadableImages.map((image, index) => (
              <a class="ui-action ui-action--primary" href={image.source} download={image.filename} data-download-publication-copy>
                下载发布副本 {downloadableImages.length > 1 ? index + 1 : ''}
                <small>{image.description}</small>
              </a>
            ))}
            <p>下载内容是网站使用的压缩发布副本，不是原始扫描件或档案主文件。</p>
          </div>
        )}
      </div>
    </section>

    <section
      class="record-citation"
      aria-labelledby="record-citation-heading"
      data-record-citation
      data-record-title={view.title}
      data-record-identifier={view.id}
    >
      <div class="record-citation-heading">
        <p>CITE THIS RECORD</p>
        <h2 class="icon-heading" id="record-citation-heading"><SiteIcon name="citation" /><span>引用与分享</span></h2>
      </div>
      <div class="record-citation-content">
        <p class="citation-preview">
          《{view.title}》（{view.id}），老旧默片。复制时会自动补充当前页面地址和访问日期。
        </p>
        <div class="citation-actions">
          <button class="ui-action ui-action--secondary" type="button" data-copy-record-link>复制页面链接</button>
          <button class="ui-action ui-action--secondary" type="button" data-copy-record-citation>复制规范引用</button>
        </div>
        <p class="citation-feedback" role="status" aria-live="polite" data-citation-feedback></p>
      </div>
    </section>

    {(previousView || nextView) && (
      <nav class="record-neighbors" aria-label={`${currentCategory?.label ?? '同类'}档案导航`}>
        <p>继续浏览 · {currentCategory?.label ?? '同类档案'}</p>
        <div>
          {previousView && (
            <a href={`/archive/${previousView.id}/`} data-record-nav data-record-target={previousView.id}>
              <small>← 上一件</small>
              <strong>{previousView.title}</strong>
              <span>{previousView.dateDisplay}</span>
            </a>
          )}
          {nextView && (
            <a class="is-next" href={`/archive/${nextView.id}/`} data-record-nav data-record-target={nextView.id}>
              <small>下一件 →</small>
              <strong>{nextView.title}</strong>
              <span>{nextView.dateDisplay}</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-record-gallery]').forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const openButton = gallery.querySelector<HTMLButtonElement>('[data-gallery-open]');
    const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
    const role = gallery.querySelector<HTMLElement>('[data-gallery-role]');
    const lightbox = gallery.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
    const lightboxImage = gallery.querySelector<HTMLImageElement>('[data-lightbox-main]');
    const lightboxCaption = gallery.querySelector<HTMLElement>('[data-lightbox-caption]');
    const lightboxRole = gallery.querySelector<HTMLElement>('[data-lightbox-role]');
    const lightboxCounter = gallery.querySelector<HTMLElement>('[data-lightbox-counter]');
    const thumbnails = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumbnail]'),
    );
    const items = JSON.parse(gallery.dataset.galleryItems ?? '[]') as Array<{
      src: string;
      srcset: string;
      description: string;
      role: string;
      width: number;
      height: number;
    }>;
    if (!mainImage || !openButton || items.length === 0) return;

    let activeIndex = 0;
    const selectImage = (index: number) => {
      activeIndex = (index + items.length) % items.length;
      const item = items[activeIndex];
      mainImage.src = item.src;
      mainImage.srcset = item.srcset;
      mainImage.alt = item.description;
      mainImage.width = item.width;
      mainImage.height = item.height;
      openButton.setAttribute('aria-label', `放大查看：${item.description}`);
      thumbnails.forEach((button, thumbnailIndex) =>
        button.setAttribute('aria-current', String(thumbnailIndex === activeIndex)));
      if (counter) counter.textContent = `第 ${activeIndex + 1} 张，共 ${items.length} 张`;
      if (caption) caption.textContent = item.description;
      if (role) role.textContent = item.role;
      if (lightboxImage) {
        lightboxImage.src = item.src;
        lightboxImage.srcset = item.srcset;
        lightboxImage.alt = item.description;
        lightboxImage.width = item.width;
        lightboxImage.height = item.height;
      }
      if (lightboxCaption) lightboxCaption.textContent = item.description;
      if (lightboxRole) lightboxRole.textContent = item.role;
      if (lightboxCounter) lightboxCounter.textContent = `第 ${activeIndex + 1} 张，共 ${items.length} 张`;
    };

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => {
        selectImage(index);
      });
    });

    gallery.querySelector<HTMLElement>('.record-thumbnails')?.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      const currentIndex = thumbnails.findIndex((button) => button === document.activeElement);
      if (currentIndex < 0) return;
      event.preventDefault();
      const targetIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? thumbnails.length - 1
          : (currentIndex + (event.key === 'ArrowRight' ? 1 : -1) + thumbnails.length) % thumbnails.length;
      thumbnails[targetIndex].focus();
      selectImage(targetIndex);
    });

    openButton.addEventListener('click', () => lightbox?.showModal());
    gallery.querySelector<HTMLButtonElement>('[data-gallery-close]')?.addEventListener('click', () => lightbox?.close());
    gallery.querySelector<HTMLButtonElement>('[data-gallery-previous-inline]')?.addEventListener('click', () => selectImage(activeIndex - 1));
    gallery.querySelector<HTMLButtonElement>('[data-gallery-next-inline]')?.addEventListener('click', () => selectImage(activeIndex + 1));
    gallery.querySelector<HTMLButtonElement>('[data-gallery-previous]')?.addEventListener('click', () => selectImage(activeIndex - 1));
    gallery.querySelector<HTMLButtonElement>('[data-gallery-next]')?.addEventListener('click', () => selectImage(activeIndex + 1));
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        selectImage(activeIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        selectImage(activeIndex + 1);
		} else if (event.key === 'Escape') {
			event.preventDefault();
			lightbox.close();
      }
    });
    lightbox?.addEventListener('close', () => openButton.focus());

    gallery.querySelectorAll<HTMLElement>('[data-gallery-swipe]').forEach((surface) => {
      let startX = 0;
      let startY = 0;
      surface.addEventListener('touchstart', (event) => {
        startX = event.changedTouches[0]?.clientX ?? 0;
        startY = event.changedTouches[0]?.clientY ?? 0;
      }, { passive: true });
      surface.addEventListener('touchend', (event) => {
        if (items.length < 2) return;
        const deltaX = (event.changedTouches[0]?.clientX ?? startX) - startX;
        const deltaY = (event.changedTouches[0]?.clientY ?? startY) - startY;
        if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.15) return;
        selectImage(activeIndex + (deltaX < 0 ? 1 : -1));
      }, { passive: true });
    });

    selectImage(0);
  });

  const browseStateKey = 'ljm-archive-browse-state';
  const recordPage = document.querySelector<HTMLElement>('[data-record-id]');
  const backLink = document.querySelector<HTMLAnchorElement>('[data-record-back]');

  try {
    const browseState = JSON.parse(window.sessionStorage.getItem(browseStateKey) ?? 'null');
    if (
      browseState?.targetId === recordPage?.dataset.recordId &&
      typeof browseState.href === 'string' &&
      browseState.href.startsWith('/archive/')
    ) {
      window.sessionStorage.setItem(
        browseStateKey,
        JSON.stringify({ ...browseState, restorePending: true }),
      );
      if (backLink) {
        backLink.href = browseState.href;
        backLink.textContent = '← 返回筛选结果';
      }

      document.querySelectorAll<HTMLAnchorElement>('[data-record-nav]').forEach((link) => {
        link.addEventListener('click', () => {
          window.sessionStorage.setItem(
            browseStateKey,
            JSON.stringify({ ...browseState, targetId: link.dataset.recordTarget ?? '', restorePending: true }),
          );
        });
      });
    }
  } catch {
    // 无法使用会话存储时，返回链接仍按当前分类工作。
  }

  const citation = document.querySelector<HTMLElement>('[data-record-citation]');
  const citationFeedback = citation?.querySelector<HTMLElement>('[data-citation-feedback]');
  let citationFeedbackTimer = 0;
  const showCitationFeedback = (message: string) => {
    if (!citationFeedback) return;
    citationFeedback.textContent = message;
    window.clearTimeout(citationFeedbackTimer);
    citationFeedbackTimer = window.setTimeout(() => {
      citationFeedback.textContent = '';
    }, 4000);
  };
  const copyText = async (value: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }
    const fallback = document.createElement('textarea');
    fallback.value = value;
    fallback.setAttribute('readonly', '');
    fallback.style.position = 'fixed';
    fallback.style.opacity = '0';
    document.body.append(fallback);
    fallback.select();
    const copied = document.execCommand('copy');
    fallback.remove();
    if (!copied) throw new Error('copy failed');
  };
  const publicRecordUrl = () =>
    document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? window.location.href;
  const accessDate = () => new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(new Date());

  citation?.querySelector<HTMLButtonElement>('[data-copy-record-link]')?.addEventListener('click', async () => {
    try {
      await copyText(publicRecordUrl());
      showCitationFeedback('页面链接已复制。');
    } catch {
      showCitationFeedback('复制失败，请从浏览器地址栏复制。');
    }
  });

  citation?.querySelector<HTMLButtonElement>('[data-copy-record-citation]')?.addEventListener('click', async () => {
    const title = citation.dataset.recordTitle ?? '';
    const identifier = citation.dataset.recordIdentifier ?? '';
    const citationText = `《${title}》（${identifier}），老旧默片，${publicRecordUrl()}，访问日期：${accessDate()}。`;
    try {
      await copyText(citationText);
      showCitationFeedback('规范引用已复制。');
    } catch {
      showCitationFeedback('复制失败，请手动选择上方引用信息。');
    }
  });
</script>

