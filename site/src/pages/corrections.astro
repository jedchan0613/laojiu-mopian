---
import BaseLayout from '../layouts/BaseLayout.astro';

const configuredEmail = import.meta.env.PUBLIC_CONTACT_EMAIL?.trim() ?? '';
const contactEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(configuredEmail) ? configuredEmail : '';
const requestTemplate = `档案永久编号：
页面地址：
申请类型：资料纠错／权利补充／限制公开／撤下申请
需要核对的内容：
可以帮助核对的依据：
希望如何处理：
回信方式（如需要）：`;
const mailtoHref = contactEmail
  ? `mailto:${contactEmail}?subject=${encodeURIComponent('老旧默片｜档案纠错或撤下申请')}&body=${encodeURIComponent(requestTemplate)}`
  : '';
---

<BaseLayout
  title="纠错与撤下说明｜老旧默片"
  description="了解如何针对公开档案提出资料纠错、权利补充、限制公开或撤下申请。"
>
  <article class="correction-page">
    <header class="correction-heading">
      <p class="correction-eyebrow">纠错与撤下</p>
      <h1>如果某件档案需要更正，或不再适合公开，可以按这里的方式联系。</h1>
      <p>本页没有在线表单，不会收集您填写的内容。请先准备核对材料，再通过联系站主或邮件提交。</p>
    </header>

    <section class="correction-section" aria-labelledby="request-types-heading">
      <h2 id="request-types-heading">可以提出哪些申请</h2>
      <dl>
        <div>
          <dt>资料纠错</dt>
          <dd>题名、年代、地点、人物、事件或其他说明可能存在错误。</dd>
        </div>
        <div>
          <dt>权利补充</dt>
          <dd>补充著作权、授权范围、署名方式或资料来源。</dd>
        </div>
        <div>
          <dt>限制公开</dt>
          <dd>申请遮盖敏感内容、限制下载或缩小公开范围。</dd>
        </div>
        <div>
          <dt>撤下申请</dt>
          <dd>申请暂时或长期停止公开某件档案及其发布副本。</dd>
        </div>
      </dl>
    </section>

    <section class="correction-section" aria-labelledby="request-process-heading">
      <h2 id="request-process-heading">提交前请准备</h2>
      <ol>
        <li>
          <strong>提供永久编号和页面地址</strong>
          <span>永久编号通常以“LJM-”开头，用它可以避免认错档案。</span>
        </li>
        <li>
          <strong>说明希望核对的内容</strong>
          <span>明确指出哪句话、哪项资料或哪张发布图片需要处理。</span>
        </li>
        <li>
          <strong>提供能够帮助判断的依据</strong>
          <span>可以说明资料来源或关系，但不要通过公开网页提交身份证号、完整地址、签名等敏感信息。</span>
        </li>
        <li>
          <strong>等待人工核对</strong>
          <span>收到申请不等于立即修改；必要时会先暂时撤下，再核对档案和权利情况。</span>
        </li>
      </ol>
    </section>

    <section class="correction-section" aria-labelledby="request-template-heading">
      <h2 id="request-template-heading">申请内容模板</h2>
      <p>复制模板后，请在您自己的邮件或文字工具中填写。站点不会在这一页保存任何申请内容。</p>
      <pre id="correction-request-template">{requestTemplate}</pre>
      <div class="request-actions">
        <button class="ui-action ui-action--secondary" type="button" data-copy-correction-template>复制申请模板</button>
        {contactEmail && <a class="ui-action ui-action--primary" href={mailtoHref}>发送邮件</a>}
      </div>
      <p class="copy-feedback" data-copy-correction-feedback role="status" aria-live="polite"></p>
      {!contactEmail && (
        <aside class="contact-pending">
          <strong>正式联系邮箱尚未配置</strong>
          <span>当前可以先复制申请模板。站点所有者配置真实公开邮箱后，本页会自动显示“发送邮件”入口；这里不会使用虚构地址。</span>
        </aside>
      )}
    </section>

    <aside class="privacy-boundary">
      <strong>隐私边界</strong>
      <p>请先发送必要的说明，不要在第一封联系中附带完整证件号码、精确私人地址、清晰签名、指纹或医疗资料。确有必要时，应先确认安全的补充方式。</p>
    </aside>
  </article>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-correction-template]');
  const template = document.querySelector<HTMLElement>('#correction-request-template');
  const feedback = document.querySelector<HTMLElement>('[data-copy-correction-feedback]');
  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(template?.textContent?.trim() ?? '');
      if (feedback) feedback.textContent = '申请模板已复制。';
    } catch {
      if (feedback) feedback.textContent = '浏览器未允许自动复制，请手工选择模板文字。';
    }
  });
</script>

<style>
  .correction-page {
    max-width: 42rem;
    margin: 0 auto;
    padding-top: clamp(3.25rem, 7vw, 5.25rem);
  }

  .correction-eyebrow {
    margin: 0 0 0.85rem;
    color: var(--site-subtle);
    font-family: var(--site-ui-font);
    font-size: var(--site-text-micro);
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 2.35rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-wrap: balance;
  }

  .correction-heading > p:last-child {
    margin: 1.35rem 0 0;
    color: #514e47;
    font-size: 1rem;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  .correction-section {
    margin-top: clamp(2.2rem, 5vw, 3.2rem);
  }

  .correction-section h2 {
    margin: 0 0 0.95rem;
    font-size: clamp(1.15rem, 2.1vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .correction-section p {
    margin: 0 0 1rem;
    color: #45433e;
    font-size: 0.98rem;
    line-height: 1.95;
  }

  dl {
    margin: 0;
    display: grid;
    gap: 0.85rem 0;
  }

  dl > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.6rem 1.1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--site-border-soft);
  }

  dl > div:last-child {
    border-bottom: 1px solid var(--site-border-soft);
  }

  dt {
    color: var(--site-subtle);
    font-family: var(--site-ui-font);
    font-size: var(--site-text-small);
    letter-spacing: 0.08em;
    line-height: 1.6;
  }

  dd {
    margin: 0;
    color: #45433e;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
  }

  ol li {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--site-border-soft);
  }

  ol li:last-child {
    border-bottom: 1px solid var(--site-border-soft);
  }

  ol li strong {
    font-size: 0.95rem;
    font-weight: 600;
  }

  ol li span {
    color: var(--site-muted);
    font-size: var(--site-text-small);
    line-height: 1.75;
  }

  pre {
    margin: 1rem 0 0;
    padding: 1rem 0;
    overflow-x: auto;
    color: #3f3c36;
    background: transparent;
    border-top: 1px solid var(--site-border-soft);
    border-bottom: 1px solid var(--site-border-soft);
    font-family: var(--site-ui-font);
    font-size: 0.78rem;
    line-height: 1.9;
    white-space: pre-wrap;
  }

  .request-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.9rem;
  }

  .copy-feedback {
    min-height: 1.4rem;
    margin: 0.45rem 0 0;
    color: var(--site-muted);
    font-size: var(--site-text-small);
  }

  .contact-pending,
  .privacy-boundary {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.4rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--site-border);
  }

  .contact-pending strong,
  .privacy-boundary strong {
    font-size: 0.92rem;
  }

  .privacy-boundary p,
  .contact-pending span {
    margin: 0;
    color: var(--site-muted);
    font-size: var(--site-text-small);
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .correction-page {
      padding-top: 2.6rem;
    }

    dl > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
