---

import { t, getLocale, localizePath, canonicalPath } from '../i18n/ui';
const locale = getLocale(Astro.url.pathname);
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/account.css';
---

<BaseLayout
	title={t("登录或开通账户｜老旧默片", locale)}
	description={t("使用邮箱验证码登录或开通账户，用于保存中意的档案与查看自己的投稿。不需要密码，不收集多余资料。", locale)}
	robots="noindex, nofollow"
>
	<div class="account-page" data-ljm-account-page="login">
		<header class="account-hero">
			<div>
				<p class="eyebrow">{t("登录 / 开通", locale)}</p>
				<h1>{t("把一段记忆，", locale)}<br class="mobile-break" />{t("交给时间保存。", locale)}</h1>
				<p class="account-lede">{t("用邮箱验证码登录，不需要密码。首次使用时先阅读并同意服务与隐私说明，再填写一个昵称即可。邮箱始终私密，不会自动变成公开昵称。", locale)}</p>
			</div>
			<div class="account-seal" aria-hidden="true"><span>{t("老旧默片", locale)}</span><strong>{t("登录", locale)}</strong><span>{t("邮箱验证", locale)}</span></div>
		</header>

		<div class="login-grid">
			<form id="login-form" class="account-panel" method="post" action="/api/account/code" autocomplete="off">
				<h2>{t("邮箱验证码", locale)}</h2>
				<p id="login-service" class="account-status" role="status">{t("正在检查登录通道…", locale)}</p>
				<noscript><p class="account-notice">{t("请在浏览器中开启 JavaScript 后再登录。未开启时页面不会提交任何内容。", locale)}</p></noscript>

				<div class="account-field">
					<label for="login-email">{t("邮箱", locale)}</label>
					<input id="login-email" name="email" type="email" required maxlength="160" inputmode="email" autocomplete="email" placeholder="name@example.com" aria-describedby="login-email-hint" />
					<small id="login-email-hint">{t("只用于接收验证码和必要的账号通知，不会公开。", locale)}</small>
				</div>

				<div class="account-actions">
					<button id="login-request" class="ui-action ui-action--primary" type="submit">{t("获取验证码", locale)}</button>
				</div>

				<div id="login-code-step" hidden>
					<div class="account-field">
						<label for="login-code">{t("验证码", locale)}</label>
						<input id="login-code" name="code" type="text" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" placeholder={t("6 位数字", locale)} />
						<small>{t("6 位数字，10 分钟内有效，只能使用一次。可以直接粘贴。", locale)}</small>
					</div>
					<div class="account-actions">
						<button id="login-verify" class="ui-action ui-action--primary" type="button">{t("验证并继续", locale)}</button>
						<button id="login-resend" class="ui-action ui-action--secondary" type="button">{t("重新发送", locale)}</button>
					</div>
				</div>

				<section id="login-onboarding" class="account-onboarding" hidden aria-labelledby="onboarding-heading">
					<h3 id="onboarding-heading">{t("首次使用：完成开通", locale)}</h3>
					<div class="account-field">
						<label for="login-nickname">{t("昵称", locale)} <small>{t("可以留空", locale)}</small></label>
						<input id="login-nickname" name="nickname" type="text" maxlength="24" placeholder={t("留空则使用系统生成的默认昵称", locale)} />
						<small>{t("昵称与登录邮箱互相独立；以后修改昵称不会改写已经发布的署名。", locale)}</small>
					</div>
					<label class="account-choice">
						<input id="login-agreement" type="checkbox" />
						<span>{t("我已阅读并主动同意", locale)} <a href={localizePath("/about/", locale)}>{t("服务与隐私说明", locale)}</a> {t("与", locale)} <a href={localizePath("/corrections/", locale)}>{t("纠错与撤下说明", locale)}</a>{t("。我理解：账号只用于收藏与投稿，发布授权需要在每件投稿中另行确认。", locale)}</span>
					</label>
					<div class="account-actions">
						<button id="login-complete" class="ui-action ui-action--primary" type="button">{t("完成开通", locale)}</button>
					</div>
				</section>

				<p id="login-status" class="account-status" role="status" aria-live="polite"></p>
			</form>

			<aside class="login-aside" aria-label={t("登录说明", locale)}>
				<div class="account-panel">
					<h3>{t("会收集哪些资料？", locale)}</h3>
					<p>{t("只需要一个可以收信的邮箱，其余都可以留空。不要求手机号、真实姓名、身份证、头像或密码。", locale)}</p>
					<h3>{t("登录后能做什么？", locale)}</h3>
					<p>{t("保存中意的公开档案、查看自己的收藏，也可以上传档案、管理自己的投稿和账号。", locale)}</p>
					<h3>{t("收不到验证码？", locale)}</h3>
					<p>{t("先确认邮箱填写正确，也看看广告或推广邮件文件夹。一分钟内不能重复发送；连续多次输入错误需要重新获取。仍收不到时可以通过页脚的联系入口告知站主。", locale)}</p>
				</div>
			</aside>
		</div>
	</div>
	<script>import '../scripts/account-login';</script>
</BaseLayout>

<style>
	.login-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 34px;
		align-items: start;
		margin-top: 30px;
	}

	.login-grid .account-panel:first-child {
		margin-bottom: 0;
	}

	.login-aside .account-panel {
		margin-bottom: 0;
	}

	.account-onboarding {
		margin-top: 26px;
		padding-top: 22px;
		border-top: 1px solid #c8bead;
	}

	@media (max-width: 900px) {
		.login-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 22px;
		}
	}
</style>
