---

import { t, getLocale, localizePath, canonicalPath } from '../../i18n/ui';
const locale = getLocale(Astro.url.pathname);
import AccountShell from '../../components/AccountShell.astro';
---

<AccountShell
	current="contributions"
	title={t("投稿档案｜老旧默片", locale)}
	description={t("分三步提交一份资料：选择图片副本、填写说明、预览并确认。图片只在你点击保存或提交后才会上传。", locale)}
	heading="投稿档案"
	lede="先选择资料，再填写说明，最后预览并确认。图片只在你点击「保存草稿」或「提交审核」后才会上传；每件投稿只代表一件对象，可以包含它的多张图片。"
>
	<div id="workbench-loading" class="account-skeleton" role="status" aria-label={t("正在准备投稿页面", locale)}></div>

	<div id="workbench-unauth" hidden>
		<div class="account-panel">
			<h2>{t("需要先登录", locale)}</h2>
			<p>{t("账号投稿需要先登录。如果你不想注册，也可以继续使用免注册投稿。", locale)}</p>
			<div class="account-actions">
				<a class="ui-action ui-action--primary" href={localizePath("/login/?next=/me/contributions/", locale)}>{t("去登录", locale)}</a>
				<a class="ui-text-link" href={localizePath("/contribute/", locale)}>{t("免注册投稿", locale)}</a>
			</div>
		</div>
	</div>

	<div id="workbench-missing" hidden>
		<div class="account-panel">
			<h2>{t("找不到这份投稿", locale)}</h2>
			<p>{t("它可能不属于当前账号，或者编号不正确。请回到「我的投稿」重新选择。", locale)}</p>
			<div class="account-actions"><a class="ui-text-link" href={localizePath("/me/contributions/", locale)}>{t("返回我的投稿", locale)}</a></div>
		</div>
	</div>

	<div id="workbench-content" hidden>
		<section id="workbench-state" class="account-panel" hidden aria-labelledby="workbench-state-heading">
			<h2 id="workbench-state-heading">{t("这份投稿的当前状态", locale)}</h2>
			<dl class="workbench-detail" id="workbench-state-list"></dl>
			<p id="workbench-message" class="account-notice" hidden></p>
			<div class="account-actions" id="workbench-actions">
				<button id="wb-withdraw" class="ui-action ui-action--secondary" type="button" hidden>{t("撤回这份投稿", locale)}</button>
				<button id="wb-discard" class="ui-action ui-action--secondary" type="button" hidden>{t("把草稿移入回收区", locale)}</button>
				<button id="wb-request-modify" class="ui-action ui-action--secondary" type="button" hidden>{t("申请修改已公开内容", locale)}</button>
				<button id="wb-request-remove" class="ui-action ui-action--secondary" type="button" hidden>{t("申请撤下已公开内容", locale)}</button>
				<a class="ui-text-link" href={localizePath("/me/contributions/", locale)}>{t("返回我的投稿", locale)}</a>
			</div>
			<p id="workbench-state-status" class="account-status" role="status" aria-live="polite"></p>
		</section>

		<form id="workbench-form" autocomplete="off" novalidate>
			<section class="account-panel" aria-labelledby="wb-images-heading">
				<h2 id="wb-images-heading"><span class="account-hint">01</span> {t("选择资料", locale)}</h2>
				<p class="account-hint">{t("1—8 张 · JPG、PNG、WebP · 每张不超过 5 MB · 合计不超过 20 MB。请提交经过筛选、压缩和必要遮盖的副本，原件请自行保留。", locale)}</p>
				<div class="account-field">
					<label for="wb-images">{t("选择图片副本", locale)}</label>
					<input id="wb-images" type="file" accept="image/jpeg,image/png,image/webp" multiple />
					<small>{t("选择后先在本地预览；点击下方的保存或提交才会真正上传。", locale)}</small>
				</div>
				<p id="wb-image-feedback" class="account-hint" role="status" aria-live="polite">{t("尚未选择图片。", locale)}</p>
				<ul id="wb-previews" class="workbench-preview" aria-label={t("已选择的图片", locale)}></ul>
			</section>

			<section class="account-panel" aria-labelledby="wb-fields-heading">
				<h2 id="wb-fields-heading"><span class="account-hint">02</span> {t("填写说明", locale)}</h2>
				<div class="account-field">
					<label for="wb-title">{t("题名", locale)} <span aria-hidden="true">*</span></label>
					<input id="wb-title" name="title" type="text" required minlength="2" maxlength="80" placeholder={t("例如：外婆留下的一本生活笔记", locale)} />
				</div>
				<div class="account-inline">
					<div class="account-field">
						<label for="wb-category">{t("藏品分类", locale)} <span aria-hidden="true">*</span></label>
						<select id="wb-category" name="category" required>
							<option value="">{t("请选择", locale)}</option>
							{['照片', '明信片', '信件', '证件与卡片', '日记与笔记', '其他'].map((label) => <option value={label}>{label}</option>)}
						</select>
					</div>
					<div class="account-field">
						<label for="wb-era">{t("大致年代", locale)} <small>{t("选填", locale)}</small></label>
						<input id="wb-era" name="era" type="text" maxlength="80" placeholder={t("例如：约 20 世纪 80 年代 / 年代未知", locale)} />
					</div>
				</div>
				<div class="account-field">
					<label for="wb-place">{t("大致地点", locale)} <small>{t("选填", locale)}</small></label>
					<input id="wb-place" name="place" type="text" maxlength="80" placeholder={t("只要城市或乡镇即可，请不要填写精确私人住址", locale)} />
				</div>
				<div class="account-field">
					<label for="wb-description">{t("资料介绍", locale)} <span aria-hidden="true">*</span></label>
					<textarea id="wb-description" name="description" rows="6" required minlength="10" maxlength="3000" placeholder={t("它从哪里来、记录了什么、你为什么会留下它。请把亲历的事实和自己的推测分开写。", locale)}></textarea>
					<small id="wb-count" class="account-hint">0 / 3000</small>
				</div>
				<div class="account-field">
					<label for="wb-source">{t("来源与展示授权依据", locale)} <span aria-hidden="true">*</span></label>
					<textarea id="wb-source" name="source_note" rows="3" required minlength="2" maxlength="500" placeholder={t("这份资料是怎么到你手上的？是否经过原主人或家人同意展示？不确定就如实写，交人工核实。", locale)}></textarea>
				</div>
				<div class="account-field">
					<label for="wb-people">{t("可识别真实人物情况", locale)} <span aria-hidden="true">*</span></label>
					<select id="wb-people" name="people" required>
						<option value="" selected disabled>{t("请选择是否涉及可识别人物", locale)}</option>
						<option value="none">{t("没有可以识别的真实人物", locale)}</option>
						<option value="yes">{t("有，需要人工确认", locale)}</option>
						<option value="unsure">{t("不确定，请协助判断", locale)}</option>
					</select>
					<small>{t("选择「有」或「不确定」的资料会交人工判断，不会被自动公开。", locale)}</small>
				</div>
				<div class="account-field">
					<span class="account-label">{t("公开署名", locale)} <span aria-hidden="true">*</span></span>
					<label class="account-choice"><input type="radio" name="attribution" value="anonymous" checked /> <span>{t("匿名（默认）", locale)}</span></label>
					<label class="account-choice"><input type="radio" name="attribution" value="named" /> <span>{t("使用我填写的署名", locale)}</span></label>
					<div class="account-field" id="wb-credit-field" hidden>
						<label for="wb-credit">{t("希望公开的署名", locale)}</label>
						<input id="wb-credit" name="credit" type="text" maxlength="40" placeholder={t("只填写你愿意公开的名字", locale)} />
					</div>
				</div>
			</section>

			<section class="account-panel" aria-labelledby="wb-consent-heading">
				<h2 id="wb-consent-heading"><span class="account-hint">03</span> {t("预览并确认", locale)}</h2>
				<dl class="workbench-detail" id="wb-preview"></dl>
				<p class="account-hint">{t("上方只是你填写内容的摘要。提交后站主会人工核对来源与隐私；请逐项确认下面四点，它们不会被预先勾选。", locale)}</p>
				<label class="account-choice"><input type="checkbox" data-consent="copies" /> <span>{t("我提交的是经过筛选并完成必要遮盖的图片副本，原件和唯一主档已自行保留。", locale)}</span></label>
				<label class="account-choice"><input type="checkbox" data-consent="rights" /> <span>{t("我有权提供这些资料，并同意「老旧默片」在本站范围内整理与展示；该授权是非独家的，不包含出售或转授权。", locale)}</span></label>
				<label class="account-choice"><input type="checkbox" data-consent="privacy" /> <span>{t("我已检查隐私，对涉及的真实人物和不确定之处如实说明，并接受进一步人工核实。", locale)}</span></label>
				<label class="account-choice"><input type="checkbox" data-consent="processing" /> <span>{t("我同意为审核与沟通私密保存本次投稿，并了解查询、补充材料与停止处理的方式。", locale)}</span></label>
			</section>

			<div class="account-actions">
				<button id="wb-save" class="ui-action ui-action--secondary" type="button">{t("保存草稿", locale)}</button>
				<button id="wb-submit" class="ui-action ui-action--primary" type="button">{t("提交审核", locale)}</button>
			</div>
			<p id="wb-status" class="account-status" role="status" aria-live="polite"></p>
		</form>
	</div>

	<script>import '../../scripts/account-contribution';</script>
</AccountShell>
