---

import { t, getLocale, localizePath, canonicalPath } from '../../i18n/ui';
const locale = getLocale(Astro.url.pathname);
import AccountShell from '../../components/AccountShell.astro';
---

<AccountShell
	current="contributions"
	title={t("我的投稿｜老旧默片", locale)}
	description={t("查看自己提交的资料、处理进度与站主说明，保存草稿、提交审核、补充材料或申请停止处理。", locale)}
	heading="我的投稿"
	lede="这里保存你自己提交的资料与处理进度。资料收到后会先由站主核对，未经确认不会公开；初审通过只代表进入整理，不等于已经发布。"
>
	<div id="contributions-loading" class="account-skeleton" role="status" aria-label={t("正在读取投稿", locale)}></div>

	<div id="contributions-unauth" hidden>
		<div class="account-panel">
			<h2>{t("需要先登录", locale)}</h2>
			<p>{t("投稿与账号关联，请先用邮箱验证码登录，再回来查看。", locale)}</p>
			<div class="account-actions">
				<a class="ui-action ui-action--primary" href={localizePath("/login/?next=/me/contributions/", locale)}>{t("去登录", locale)}</a>
				<a class="ui-text-link" href={localizePath("/contribute/", locale)}>{t("免注册投稿", locale)}</a>
			</div>
		</div>
	</div>

	<div id="contributions-content" hidden>
		<div class="account-toolbar">
			<a class="ui-action ui-action--primary" href={localizePath("/me/contribution/", locale)}>{t("上传档案", locale)}</a>
			<p class="account-hint" id="contributions-summary" role="status"></p>
			<p class="account-hint" id="contributions-quota"></p>
		</div>

		<ul id="contributions-list" class="account-list account-list--wide" aria-label={t("我的投稿", locale)}></ul>

		<div id="contributions-empty" class="account-empty" hidden>
			{t("还没有投稿。点击上方「上传档案」开始；不确定的内容可以先保存草稿，之后再补充。", locale)}
		</div>

		<details class="account-panel" id="claim-panel">
			<summary>{t("关联我以前用编号提交的投稿", locale)}</summary>
			<p>{t("以前免注册投稿时拿到过投稿编号和查询密钥，可以把那份投稿关联到当前账号。需要同时填写正确的编号与密钥，仅凭相同的邮箱或相似的图片不能认领。", locale)}</p>
			<div class="account-inline">
				<div class="account-field">
					<label for="claim-id">{t("投稿编号", locale)}</label>
					<input id="claim-id" name="claim_id" type="text" spellcheck="false" placeholder="TG-…" />
				</div>
				<div class="account-field">
					<label for="claim-key">{t("查询密钥", locale)}</label>
					<input id="claim-key" name="claim_key" type="password" autocomplete="off" />
				</div>
			</div>
			<label class="account-choice">
				<input id="claim-confirm" type="checkbox" />
				<span>{t("我确认这份投稿由我本人提交，并同意把它关联到当前账号。关联后仍可用原编号与密钥查询。", locale)}</span>
			</label>
			<div class="account-actions">
				<button id="claim-submit" class="ui-action ui-action--secondary" type="button">{t("确认关联", locale)}</button>
			</div>
			<p id="claim-status" class="account-status" role="status" aria-live="polite"></p>
		</details>
	</div>

	<p id="contributions-status" class="account-status" role="status" aria-live="polite"></p>
	<script>import '../../scripts/account-contributions';</script>
</AccountShell>
