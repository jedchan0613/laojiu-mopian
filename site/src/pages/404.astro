---
import BaseLayout from '../layouts/BaseLayout.astro';
import { archiveItems } from '../data/archive';
import { isPublishedArchiveItem } from '../data/archive-view';

// 随手翻一件：404 页也提供随机浏览，索引只包含已公开档案的永久编号。
const randomRecordIds = archiveItems
	.filter(isPublishedArchiveItem)
	.map((item) => item.core.item_id);
---

<BaseLayout
  title="页面暂时不可访问｜老旧默片"
  description="当前页面不存在、地址已经改变，或相关档案暂时不对外开放。"
>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="not-found-mark">缺页</p>
    <h1 id="not-found-title">这页目前找不到</h1>
    <p>
      地址可能已经改变，也可能对应一件目前不对外开放的档案。为了保护资料隐私，这里不会说明具体原因。
    </p>
    <form class="not-found-search" action="/archive/" method="get" role="search" aria-labelledby="not-found-search-heading">
      <p class="not-found-search-heading" id="not-found-search-heading">先在档案里找找看</p>
      <div class="not-found-search-row">
        <label class="not-found-search-label" for="not-found-search-input">搜索档案关键词</label>
        <input
          id="not-found-search-input"
          type="search"
          name="q"
          placeholder="例如：明信片、上海、家书"
          autocomplete="off"
        />
        <button class="ui-action ui-action--primary" type="submit">搜索档案</button>
      </div>
      <p class="not-found-search-hint">会打开档案列表，并自动填入这个关键词。</p>
    </form>
    <div class="not-found-actions">
      <a class="ui-action ui-action--primary" href="/archive/">浏览现有档案</a>
      <button class="ui-action ui-action--secondary" type="button" data-random-record-button hidden>随手翻一件</button>
      <a class="ui-text-link" href="/">返回首页</a>
    </div>
    <aside>
      <strong>如果您是在核对某件档案</strong>
      <span>请检查永久编号和页面地址。也可以查看纠错与撤下说明，准备需要提交的信息。</span>
      <a class="ui-text-link" href="/corrections/">查看纠错与撤下说明 →</a>
    </aside>
  </section>
  <script type="application/json" id="random-record-index" set:html={JSON.stringify(randomRecordIds)} />
  <script>import '../scripts/random-record';</script>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(4.25rem, 10vw, 7.5rem) 0 clamp(2rem, 5vw, 4rem);
  }

  .not-found-mark {
    margin: 0 0 0.85rem;
    color: var(--site-subtle);
    font-family: var(--site-ui-font);
    font-size: var(--site-text-micro);
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 4vw, 2.45rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .not-found > p:not(.not-found-mark) {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: #514e47;
    font-size: 1rem;
    line-height: 1.9;
    letter-spacing: 0.03em;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem 1.1rem;
    margin-top: 1.6rem;
  }

  .not-found-search {
    width: 100%;
    margin-top: 2rem;
    padding: 0 0 1.2rem;
    border-top: 1px solid var(--site-border);
    border-bottom: 1px solid var(--site-border);
  }

  .not-found-search-heading {
    margin: 1rem 0 0;
    color: var(--site-subtle);
    font-family: var(--site-ui-font);
    font-size: var(--site-text-micro);
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .not-found-search-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .not-found-search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .not-found-search input {
    flex: 1 1 14rem;
    min-height: 44px;
    padding: 0.65rem 0.85rem;
    color: #3b362f;
    background: var(--site-paper);
    border: 1px solid var(--site-border-soft);
    border-radius: 0;
    font: 0.95rem/1.6 var(--site-ui-font);
  }

  .not-found-search input:focus {
    border-color: var(--site-ink);
    outline: 2px solid var(--site-focus-outline);
    outline-offset: 2px;
  }

  .not-found-search input::placeholder {
    color: #8b8274;
    opacity: 1;
  }

  .not-found-search-hint {
    margin: 0.6rem 0 0;
    color: var(--site-muted);
    font-size: var(--site-text-small);
    line-height: 1.7;
  }

  aside {
    display: grid;
    gap: 0.45rem;
    width: 100%;
    margin-top: clamp(2.6rem, 6vw, 4rem);
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--site-border);
  }

  aside strong {
    font-size: 0.92rem;
    font-weight: 600;
  }

  aside span {
    color: var(--site-muted);
    font-size: var(--site-text-small);
    line-height: 1.75;
  }

  aside a {
    justify-self: start;
    margin-top: 0.25rem;
  }
</style>
