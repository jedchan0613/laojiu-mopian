---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveLikeButton from '../components/ArchiveLikeButton.astro';
import SiteIcon, { type SiteIconName } from '../components/SiteIcon.astro';
import { archiveItems } from '../data/archive';
import {
	archiveCategories,
	getArchiveCategorySlug,
	type ArchiveCategorySlug,
} from '../data/archive-categories';
import { createArchiveRecordView, isPublishedArchiveItem } from '../data/archive-view';
import { getResponsiveImage } from '../data/responsive-images';
import { siteCuration } from '../data/site-curation';

const publishedItems = archiveItems.filter(isPublishedArchiveItem);
const publishedViews = publishedItems.map(createArchiveRecordView);
const categoryCounts = new Map<string, number>();
for (const item of publishedItems) {
	const slug = getArchiveCategorySlug(item.core.object_type);
	categoryCounts.set(slug, (categoryCounts.get(slug) ?? 0) + 1);
}

const compareViewsByRecency = (left: (typeof publishedViews)[number], right: (typeof publishedViews)[number]) => {
	const leftDate = left.item.core.accession_date ?? left.item.core.created_date ?? '';
	const rightDate = right.item.core.accession_date ?? right.item.core.created_date ?? '';
	return rightDate.localeCompare(leftDate) || right.id.localeCompare(left.id);
};
const categoryViewGroups = archiveCategories.map((category) => ({
	category,
	views: publishedViews
		.filter((view) => getArchiveCategorySlug(view.objectType) === category.slug)
		.sort(compareViewsByRecency),
}));
const recentViews = categoryViewGroups.flatMap(({ views }) => views[0] ? [views[0]] : []);
const excludedCarouselImages = new Set<string>(siteCuration.homeCarouselExcludedImagePaths);
const carouselSlideGroups = categoryViewGroups.map(({ category, views }) => views.flatMap((view) =>
	view.images.flatMap((source, index) => excludedCarouselImages.has(source) ? [] : [{
		image: getResponsiveImage(source),
		description: view.imageDescriptions[index],
		itemId: view.id,
		title: view.title,
		dateDisplay: view.dateDisplay,
		href: `/archive/${view.id}/`,
		categorySlug: category.slug,
	}]),
));
const carouselRoundCount = Math.max(0, ...carouselSlideGroups.map((slides) => slides.length));
const featuredSlides = Array.from({ length: carouselRoundCount }, (_, roundIndex) =>
	carouselSlideGroups.flatMap((slides) => slides[roundIndex] ? [slides[roundIndex]] : []),
).flat();
const featuredImage = featuredSlides[0]?.image;
const firstFeaturedSlide = featuredSlides[0];
const carouselItemIds = [...new Set(featuredSlides.map((slide) => slide.itemId))];
const recentEntries = recentViews.map((view) => ({
	view,
	image: view.images[0] ? getResponsiveImage(view.images[0]) : undefined,
}));
const categoryIconBySlug: Record<ArchiveCategorySlug, SiteIconName> = {
	photos: 'photos',
	postcards: 'postcards',
	letters: 'letters',
	credentials: 'credentials',
	cards: 'cards',
	notes: 'notes',
	other: 'objects',
};
const categoryEntries = archiveCategories.map((category, index) => {
	const count = categoryCounts.get(category.slug) ?? 0;
	return {
		...category,
		count,
		icon: categoryIconBySlug[category.slug],
		indexLabel: String(index + 1).padStart(2, '0'),
	};
});
---

<BaseLayout image={featuredImage?.src}>
	<div class="home">
		<div class="hero">
			<div class="hero-copy">
				<header class="masthead">
					<div class="masthead-mark" aria-hidden="true">
						<svg viewBox="0 0 48 48" focusable="false">
							<path d="M15 6.75H6.75V15M33 6.75h8.25V15M41.25 33v8.25H33M15 41.25H6.75V33" />
							<rect x="11.75" y="12.75" width="24.5" height="22.5" />
							<circle cx="19" cy="20" r="2.75" />
							<path class="masthead-mark-trace" d="M14.75 31.75c3.7-4.35 6.55-6.5 8.55-6.5 2.35 0 4.15 1.3 5.85 3.15l2.1-1.9 2 2.1" />
						</svg>
						<span><strong>生活档案</strong><small>ARCHIVE · 001</small></span>
					</div>
					<h1>老旧默片</h1>
					<p>普通人的生活档案</p>
				</header>
				<section class="introduction" aria-label="网站介绍">
					<p>收藏、整理和讲述那些被时间留下来的普通生活痕迹。</p>
					<a class="browse-link ui-action ui-action--primary" href="/archive/">浏览全部 {publishedItems.length} 件档案 →</a>
				</section>
			</div>

			{featuredImage && firstFeaturedSlide && (
				<div
					class="hero-record-shell"
					data-home-featured-record={firstFeaturedSlide.itemId}
					data-home-featured-carousel={featuredSlides.length > 1 ? '' : undefined}
					data-carousel-category-order={featuredSlides.map((slide) => slide.categorySlug).join(',')}
					data-carousel-items={featuredSlides.length > 1 ? JSON.stringify(featuredSlides.map(({ image, description, itemId, title, dateDisplay, href }) => ({
						src: image.src,
						srcset: image.srcset ?? '',
						width: image.width,
						height: image.height,
						description,
						itemId,
						title,
						dateDisplay,
						href,
					}))) : undefined}
					role={featuredSlides.length > 1 ? 'region' : undefined}
					aria-roledescription={featuredSlides.length > 1 ? '轮播图' : undefined}
					aria-label={featuredSlides.length > 1 ? '全部公开藏品的精选图片' : undefined}
				>
					<a
						class="hero-record"
						href={firstFeaturedSlide.href}
						aria-label={`查看精选档案：${firstFeaturedSlide.title}`}
						data-home-carousel-link={featuredSlides.length > 1 ? '' : undefined}
					>
						<figure>
							<div class="hero-record-image">
								<span class="hero-record-index" aria-hidden="true">精选<br /><span data-home-carousel-index>01</span></span>
								<img
									src={featuredImage.src}
									srcset={featuredImage.srcset}
									sizes="(max-width: 760px) calc(100vw - 32px), 600px"
									alt={firstFeaturedSlide.description}
									width={featuredImage.width}
									height={featuredImage.height}
									loading="eager"
									fetchpriority="high"
									decoding="async"
									data-home-carousel-image={featuredSlides.length > 1 ? '' : undefined}
								/>
							</div>
							<figcaption>
								<div class="hero-record-heading">
									<small class="hero-record-date"><span>年代</span><span data-home-carousel-date>{firstFeaturedSlide.dateDisplay}</span></small>
									<strong data-home-carousel-title>{firstFeaturedSlide.title}</strong>
								</div>
								<small class="hero-record-open">打开档案 →</small>
							</figcaption>
						</figure>
					</a>
					<div class="hero-record-toolbar">
						{featuredSlides.length > 1 && (
							<div class="hero-carousel-controls" aria-label="精选图片轮播控制">
								<button type="button" data-home-carousel-previous aria-label="查看上一张精选图片">
									<span aria-hidden="true">←</span><span class="carousel-control-label">上一张</span>
								</button>
								<div class="hero-carousel-progress">
									<span data-home-carousel-status>第 1 张，共 {featuredSlides.length} 张</span>
								</div>
								<button type="button" data-home-carousel-next aria-label="查看下一张精选图片">
									<span class="carousel-control-label">下一张</span><span aria-hidden="true">→</span>
								</button>
								<button
									class="hero-carousel-toggle"
									type="button"
									data-home-carousel-toggle
									aria-label="暂停自动轮播"
									aria-pressed="false"
								>
									<span data-home-carousel-toggle-icon aria-hidden="true">Ⅱ</span>
									<span data-home-carousel-toggle-label>暂停</span>
								</button>
								<span class="carousel-announcement" data-home-carousel-announcement aria-live="polite"></span>
							</div>
						)}
						<div class="hero-record-actions">
							<ArchiveLikeButton
								itemId={firstFeaturedSlide.itemId}
								title={firstFeaturedSlide.title}
								preloadItemIds={carouselItemIds}
							/>
						</div>
					</div>
				</div>
			)}
		</div>

		<nav class="archive-entrances" aria-label="档案分类入口">
			<div class="archive-entrances-heading">
				<div class="archive-entrances-title icon-heading">
					<SiteIcon name="collection" />
					<p>按藏品类型浏览</p>
				</div>
				<span>ARCHIVE CATEGORIES · {String(categoryEntries.length).padStart(2, '0')}</span>
			</div>
			<ul>
				{categoryEntries.map((category) => (
					<li class:list={{ 'has-records': category.count > 0, 'is-empty': category.count === 0 }}>
						<a href={`/archive/?category=${category.slug}`}>
							<span class="category-index" aria-hidden="true">{category.indexLabel}</span>
							<SiteIcon name={category.icon} class="category-icon" />
							<strong>{category.label}</strong>
							<small>{category.count > 0 ? `${category.count} 件档案` : '待收录'}</small>
							<span class="category-arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		{recentEntries.length > 0 && (
			<section class="home-discovery" aria-labelledby="discovery-heading">
				<header class="discovery-heading">
					<div class="discovery-title">
						<SiteIcon name="archive" />
						<div>
							<p>MORE FROM THE ARCHIVE</p>
							<h2 id="discovery-heading">继续浏览其他档案</h2>
						</div>
					</div>
					<a class="ui-text-link" href="/archive/">查看全部 {publishedItems.length} 件档案 →</a>
				</header>

				<section class="recent-records" aria-label="其他档案">
					<ul>
						{recentEntries.map(({ view, image }, index) => (
							<li>
								<a
									href={`/archive/${view.id}/`}
									aria-label={`查看档案：${view.title}`}
									data-home-recent-record={view.id}
									data-home-recent-category={getArchiveCategorySlug(view.objectType)}
								>
									<span class="recent-record-image">
										<span class="recent-record-index" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
										{image && (
											<img
												src={image.src}
												srcset={image.srcset}
												sizes="(max-width: 760px) 94px, 312px"
												alt=""
												width={image.width}
												height={image.height}
												loading="lazy"
												decoding="async"
											/>
										)}
									</span>
									<span class="recent-record-copy">
										<small>{view.typeLabel} · {view.dateDisplay}</small>
										<strong>{view.title}</strong>
										<em>查看档案 →</em>
									</span>
								</a>
								<div class="recent-record-actions">
									<ArchiveLikeButton itemId={view.id} title={view.title} compact />
								</div>
							</li>
						))}
					</ul>
				</section>
			</section>
		)}
	</div>
	<script>
		import '../scripts/archive-likes';
		import '../scripts/home-featured-carousel';
	</script>
</BaseLayout>

<style>
	.home {
		width: min(100%, 65rem);
		margin: 0 auto;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(17rem, 0.78fr) minmax(0, 1.22fr);
		align-items: center;
		gap: clamp(38px, 5.5vw, 62px);
		padding: clamp(30px, 4vw, 42px) clamp(0.8rem, 2vw, 1.25rem) clamp(32px, 4vw, 44px);
		background: linear-gradient(110deg, rgba(248, 244, 234, 0.38), rgba(232, 224, 207, 0.13));
		border-bottom: 1px solid rgba(188, 181, 164, 0.68);
	}

	.hero-copy {
		min-width: 0;
	}

	.masthead h1,
	.masthead p,
	.introduction p {
		margin: 0;
	}

	.masthead h1 {
		font-size: clamp(2.6rem, 4.5vw, 3.75rem);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: 0.14em;
	}

	.masthead-mark {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 1rem;
		color: var(--site-accent);
	}

	.masthead-mark svg {
		display: block;
		width: 2.65rem;
		height: 2.65rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: square;
		stroke-linejoin: miter;
	}

	.masthead-mark circle {
		fill: currentColor;
		stroke: none;
	}

	.masthead-mark-trace {
		opacity: 0.68;
	}

	.masthead-mark span {
		display: grid;
		gap: 0.08rem;
	}

	.masthead-mark strong,
	.masthead-mark small {
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: 0.16em;
	}

	.masthead-mark strong {
		font-family: inherit;
		font-size: 0.72rem;
	}

	.masthead-mark small {
		font-size: var(--site-text-micro);
	}

	.masthead p {
		margin-top: 9px;
		color: #646057;
		font-size: clamp(0.78rem, 1.3vw, 0.9rem);
		line-height: 1.7;
		letter-spacing: 0.26em;
	}

	.introduction p {
		max-width: 17em;
		font-size: clamp(1.03rem, 1.55vw, 1.22rem);
		font-weight: 400;
		line-height: 1.68;
		letter-spacing: 0.055em;
	}

	.introduction {
		margin-top: clamp(1.6rem, 3vw, 2.15rem);
	}

	.browse-link {
		margin-top: 15px;
		letter-spacing: 0.1em;
	}

	.hero-record-shell {
		min-width: 0;
	}

	.hero-record-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.72rem;
		margin-top: 0.72rem;
	}

	.hero-record {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.hero-record figure {
		position: relative;
		margin: 0;
		padding: clamp(0.55rem, 1vw, 0.72rem);
		background: #e7dfcd;
		border: 1px solid #c4baa7;
		box-shadow: 0.7rem 0.7rem 0 rgba(90, 79, 61, 0.07);
		transition: border-color 180ms ease, box-shadow 180ms ease;
	}

	.hero-record-image {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #d8d1c0;
	}

	.hero-record img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 240ms ease;
	}

	.hero-record-index {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 1;
		min-width: 3.4rem;
		padding: 0.55rem 0.65rem 0.5rem;
		color: #f7f0e2;
		background: var(--site-accent);
		font-size: var(--site-text-micro);
		line-height: 1.4;
		letter-spacing: 0.12em;
	}

	.hero-record figcaption {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: 1rem;
		row-gap: 0.42rem;
		align-items: end;
		padding: 0.72rem 0.2rem 0.08rem;
	}

	.hero-record-heading {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		gap: 0.7rem;
		min-width: 0;
	}

	.hero-record-date {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
		color: #686359;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: var(--site-text-micro);
		font-weight: 400;
		line-height: 1.45;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.hero-record-date span:first-child {
		color: var(--site-accent);
		font-family: inherit;
		font-size: 0.62rem;
		letter-spacing: 0.08em;
	}

	.hero-record figcaption strong {
		min-width: 0;
		font-size: clamp(0.96rem, 1.5vw, 1.1rem);
		font-weight: 500;
		line-height: 1.45;
		letter-spacing: 0.05em;
	}

	.hero-record-open {
		color: var(--site-accent);
		font-size: 0.74rem;
		line-height: 1.5;
		letter-spacing: 0.08em;
	}

	.hero-record:hover img,
	.hero-record:focus-visible img {
		transform: scale(1.018);
	}

	.hero-record:hover figure,
	.hero-record:focus-visible figure {
		border-color: rgba(154, 63, 46, 0.62);
		box-shadow: 0.7rem 0.7rem 0 rgba(154, 63, 46, 0.11);
	}

	.hero-record:hover figcaption strong,
	.hero-record:focus-visible figcaption strong {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
	}

	.hero-record-actions {
		display: flex;
		justify-content: flex-end;
		margin-left: auto;
	}

	.recent-record-actions {
		display: flex;
		justify-content: flex-end;
		margin-top: 0.72rem;
	}

	.hero-carousel-controls {
		display: none;
		flex: 1 1 20rem;
		grid-template-columns: auto minmax(5rem, 1fr) auto auto;
		align-items: center;
		gap: 0.45rem;
	}

	.hero-record-shell[data-carousel-ready] .hero-carousel-controls {
		display: grid;
	}

	.hero-carousel-controls > button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.25rem;
		padding: 0.38rem 0.58rem;
		color: #5f5a50;
		background: rgba(248, 244, 234, 0.66);
		border: 1px solid #bdb4a3;
		cursor: pointer;
		font: inherit;
		font-size: 0.72rem;
		line-height: 1.35;
		letter-spacing: 0.05em;
		transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease;
	}

	.hero-carousel-controls > button:hover,
	.hero-carousel-controls > button:focus-visible {
		color: var(--site-accent);
		background: #f8f2e6;
		border-color: rgba(154, 63, 46, 0.62);
	}

	.hero-carousel-progress {
		display: grid;
		justify-items: center;
		gap: 0.18rem;
		min-width: 0;
		color: #777166;
		font-size: var(--site-text-micro);
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-align: center;
	}

	.hero-carousel-toggle {
		min-width: 3.8rem;
	}

	.carousel-announcement {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.browse-link:focus-visible,
	.archive-entrances a:focus-visible {
		outline: 2px solid #575349;
		outline-offset: 6px;
	}

	.archive-entrances-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin: 1.35rem 0 0.75rem;
	}

	.archive-entrances-heading p,
	.archive-entrances-heading span {
		margin: 0;
	}

	.archive-entrances-title {
		color: #4f4b43;
	}

	.archive-entrances-heading p {
		font-size: 0.88rem;
		letter-spacing: 0.12em;
	}

	.archive-entrances-heading span {
		color: var(--site-accent);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: var(--site-text-micro);
		letter-spacing: 0.15em;
	}

	.archive-entrances ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.65rem clamp(0.75rem, 2vw, 1.2rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.archive-entrances li {
		background: rgba(248, 244, 234, 0.32);
		border: 1px solid #c7bfaf;
		font-size: clamp(0.9rem, 1.4vw, 1rem);
		line-height: 1.6;
		letter-spacing: 0.12em;
		transition: border-color 160ms ease, box-shadow 160ms ease;
	}

	.archive-entrances a {
		display: grid;
		grid-template-columns: 1.5rem 1.45rem minmax(0, 1fr) auto 1rem;
		align-items: center;
		gap: 0.62rem;
		padding: 14px 8px 13px 6px;
		text-decoration: none;
		transition: color 160ms ease, background-color 160ms ease;
	}

	.archive-entrances strong {
		font-weight: 400;
	}

	.category-index {
		color: #8a8377;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: var(--site-text-micro);
		letter-spacing: 0.08em;
	}

	.archive-entrances :global(.category-icon) {
		width: 1.15rem;
		height: 1.15rem;
		color: #756f64;
		stroke-width: 1.45;
	}

	.archive-entrances small {
		flex: 0 0 auto;
		color: #777166;
		font-size: var(--site-text-micro);
		letter-spacing: 0.08em;
	}

	.category-arrow {
		color: #8a8377;
		font-size: 0.8rem;
		transition: transform 160ms ease;
	}

	.archive-entrances .has-records a {
		box-shadow: inset 3px 0 var(--site-accent);
		background: rgba(154, 63, 46, 0.045);
	}

	.archive-entrances .has-records .category-index,
	.archive-entrances .has-records small,
	.archive-entrances .has-records .category-arrow {
		color: var(--site-accent);
	}

	.archive-entrances .has-records :global(.category-icon) {
		color: var(--site-accent);
	}

	.archive-entrances .has-records strong {
		font-weight: 600;
