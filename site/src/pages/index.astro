---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveLikeButton from '../components/ArchiveLikeButton.astro';
import SiteIcon, { type SiteIconName } from '../components/SiteIcon.astro';
import BrandMark from '../components/BrandMark.astro';
import { archiveItems } from '../data/archive';
import {
	archiveCategories,
	getArchiveCategorySlug,
	type ArchiveCategorySlug,
} from '../data/archive-categories';
import { createArchiveRecordView, isPublishedArchiveItem } from '../data/archive-view';
import { getResponsiveImage } from '../data/responsive-images';

const publishedItems = archiveItems.filter(isPublishedArchiveItem);
const publishedViews = publishedItems.map(createArchiveRecordView);
const categoryCounts = new Map<string, number>();
for (const item of publishedItems) {
	const slug = getArchiveCategorySlug(item.core.object_type);
	categoryCounts.set(slug, (categoryCounts.get(slug) ?? 0) + 1);
}

// 首页的“上传时间”沿用项目现有的“最近收录”定义：优先按首次录入日期，
// 缺失时才使用获得日期；同一天再用更新时间、获得日期和永久编号稳定排序。
const compareViewsByCreatedDate = (left: (typeof publishedViews)[number], right: (typeof publishedViews)[number]) => {
	const leftCreated = left.item.core.created_date?.trim() || left.item.core.accession_date?.trim() || '';
	const rightCreated = right.item.core.created_date?.trim() || right.item.core.accession_date?.trim() || '';
	const createdOrder = rightCreated.localeCompare(leftCreated);
	if (createdOrder !== 0) return createdOrder;
	const updatedOrder = (right.item.core.updated_date ?? '').localeCompare(left.item.core.updated_date ?? '');
	if (updatedOrder !== 0) return updatedOrder;
	const accessionOrder = (right.item.core.accession_date ?? '').localeCompare(left.item.core.accession_date ?? '');
	if (accessionOrder !== 0) return accessionOrder;
	return right.id.localeCompare(left.id, 'zh-CN', { numeric: true, sensitivity: 'base' });
};
const categoryViewGroups = archiveCategories.map((category) => ({
	category,
	views: publishedViews
		.filter((view) => getArchiveCategorySlug(view.objectType) === category.slug && Boolean(view.images[0]))
		.sort(compareViewsByCreatedDate),
}));

// 上方精选：每种访客分类取创建时间最新的一件，只展示首张图片，
// 按分类顺序排列，总数由实际符合条件的分类决定（最多 7 张）。
const featuredSlides = categoryViewGroups.flatMap(({ category, views }) => {
	const view = views[0];
	const source = view?.images[0];
	return view && source ? [{
		image: getResponsiveImage(source),
		description: view.imageDescriptions[0],
		itemId: view.id,
		title: view.title,
		dateDisplay: view.dateDisplay,
		href: `/archive/${view.id}/`,
		categorySlug: category.slug,
	}] : [];
});
const featuredImage = featuredSlides[0]?.image;
const firstFeaturedSlide = featuredSlides[0];

// 下方继续浏览：整件排除上方已经使用的藏品，避免其第二张、第三张图片
// 以任何形式重复出现；再按分类取剩余藏品中创建时间最新的一件及其首图。
const featuredRecordIds = new Set(featuredSlides.map((slide) => slide.itemId));
const recentViews = categoryViewGroups.flatMap(({ views }) => {
	const newestRemainingView = views.find((view) => !featuredRecordIds.has(view.id));
	return newestRemainingView ? [newestRemainingView] : [];
});
const recentEntries = recentViews.map((view) => ({
	view,
	image: view.images[0] ? getResponsiveImage(view.images[0]) : undefined,
}));

// 随手翻一件：把全部已公开档案编号写入页面，供浏览器端随机挑选跳转。
const randomRecordIds = publishedViews.map((view) => view.id);
const categoryIconBySlug: Record<ArchiveCategorySlug, SiteIconName> = {
	photos: 'photos',
	postcards: 'postcards',
	letters: 'letters',
	credentials: 'credentials',
	cards: 'cards',
	notes: 'notes',
	other: 'objects',
};
const categoryEntries = archiveCategories.map((category, index) => {
	const count = categoryCounts.get(category.slug) ?? 0;
	return {
		...category,
		count,
		icon: categoryIconBySlug[category.slug],
		indexLabel: String(index + 1).padStart(2, '0'),
	};
});
---

<BaseLayout image={featuredImage?.src}>
	<div class="home">
		<div class="hero">
			<div class="hero-copy">
				<header class="masthead">
					<div class="masthead-title">
						<div class="masthead-mark"><BrandMark variant="seal" /></div>
						<h1>老旧默片</h1>
					</div>
					<p>普通人的生活档案</p>
				</header>
				<section class="introduction" aria-label="网站介绍">
					<p>
						<span class="introduction-line">收藏、整理和讲述那些被时间</span>
						<span class="introduction-line">留下来的普通生活痕迹。</span>
					</p>
					<div class="introduction-actions">
						<a class="browse-link ui-action ui-action--primary" href="/archive/">浏览全部 {publishedItems.length} 件档案 →</a>
						<button class="browse-link ui-action ui-action--secondary" type="button" data-random-record-button hidden>随手翻一件</button>
					</div>
				</section>
			</div>

			{featuredImage && firstFeaturedSlide && (
				<div
					class="hero-record-shell"
					data-home-featured-record={firstFeaturedSlide.itemId}
					data-home-featured-carousel={featuredSlides.length > 1 ? '' : undefined}
					data-carousel-category-order={featuredSlides.map((slide) => slide.categorySlug).join(',')}
					data-carousel-record-order={featuredSlides.map((slide) => slide.itemId).join(',')}
					data-carousel-items={featuredSlides.length > 1 ? JSON.stringify(featuredSlides.map(({ image, description, itemId, title, dateDisplay, href }) => ({
						src: image.src,
						srcset: image.srcset ?? '',
						width: image.width,
						height: image.height,
						description,
						itemId,
						title,
						dateDisplay,
						href,
					}))) : undefined}
					role={featuredSlides.length > 1 ? 'region' : undefined}
					aria-roledescription={featuredSlides.length > 1 ? '轮播图' : undefined}
					aria-label={featuredSlides.length > 1 ? '精选公开藏品图片' : undefined}
				>
					<a
						class="hero-record"
						href={firstFeaturedSlide.href}
						aria-label={`查看精选档案：${firstFeaturedSlide.title}`}
						data-home-carousel-link={featuredSlides.length > 1 ? '' : undefined}
					>
						<figure>
							<div class="hero-record-image">
								<span class="hero-record-index" aria-hidden="true">精选<br /><span data-home-carousel-index>01</span></span>
								<img
									src={featuredImage.src}
									srcset={featuredImage.srcset}
									sizes="(max-width: 760px) calc(100vw - 32px), 600px"
									alt={firstFeaturedSlide.description}
									width={featuredImage.width}
									height={featuredImage.height}
									loading="eager"
									fetchpriority="high"
									decoding="async"
									data-home-carousel-image={featuredSlides.length > 1 ? '' : undefined}
								/>
							</div>
							<figcaption>
								<div class="hero-record-heading">
									<small class="hero-record-date"><span>年代</span><span data-home-carousel-date>{firstFeaturedSlide.dateDisplay}</span></small>
									<strong data-home-carousel-title>{firstFeaturedSlide.title}</strong>
								</div>
								<small class="hero-record-open">打开档案 →</small>
							</figcaption>
						</figure>
					</a>
					<div class="hero-record-toolbar">
						{featuredSlides.length > 1 && (
							<div class="hero-carousel-controls" aria-label="精选图片轮播控制">
								<button type="button" data-home-carousel-previous aria-label="查看上一张精选图片">
									<span aria-hidden="true">←</span><span class="carousel-control-label">上一张</span>
								</button>
								<div class="hero-carousel-progress">
									<span data-home-carousel-status>第 1 张，共 {featuredSlides.length} 张</span>
								</div>
								<button type="button" data-home-carousel-next aria-label="查看下一张精选图片">
									<span class="carousel-control-label">下一张</span><span aria-hidden="true">→</span>
								</button>
								<button
									class="hero-carousel-toggle"
									type="button"
									data-home-carousel-toggle
									aria-label="暂停自动轮播"
									aria-pressed="false"
								>
									<span data-home-carousel-toggle-icon aria-hidden="true">Ⅱ</span>
									<span data-home-carousel-toggle-label>暂停</span>
								</button>
								<span class="carousel-announcement" data-home-carousel-announcement aria-live="polite"></span>
							</div>
						)}
						<div class="hero-record-actions">
							<ArchiveLikeButton
								itemId={firstFeaturedSlide.itemId}
								title={firstFeaturedSlide.title}
							/>
						</div>
					</div>
				</div>
			)}
		</div>

		<section class="view-history" data-view-history hidden aria-labelledby="view-history-heading">
			<header class="view-history-header">
				<div class="view-history-title">
					<SiteIcon name="compass" />
					<div>
						<h2 id="view-history-heading">您最近看过</h2>
						<p>继续上次的浏览 · 足迹只保存在这台设备的浏览器里</p>
					</div>
				</div>
				<button class="view-history-clear" type="button" data-view-history-clear>清空足迹</button>
			</header>
			<ul class="view-history-list" data-view-history-list></ul>
		</section>

		<nav class="archive-entrances" aria-label="档案分类入口">
			<div class="archive-entrances-heading">
				<div class="archive-entrances-title icon-heading">
					<SiteIcon name="collection" />
					<p>按藏品类型浏览</p>
				</div>
			</div>
			<ul>
				{categoryEntries.map((category) => (
					<li class:list={{ 'has-records': category.count > 0, 'is-empty': category.count === 0 }}>
						<a href={`/archive/?category=${category.slug}`}>
							<span class="category-index" aria-hidden="true">{category.indexLabel}</span>
							<SiteIcon name={category.icon} class="category-icon" />
							<strong>{category.label}</strong>
							<small>{category.count > 0 ? `${category.count} 件档案` : '待收录'}</small>
							<span class="category-arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		{recentEntries.length > 0 && (
			<section class="home-discovery" aria-labelledby="discovery-heading">
				<header class="discovery-heading">
					<div class="discovery-title">
					<SiteIcon name="archive" />
					<div>
						<h2 id="discovery-heading">继续浏览其他档案</h2>
					</div>
					</div>
					<a class="ui-text-link" href="/archive/">查看全部 {publishedItems.length} 件档案 →</a>
				</header>

				<section class="recent-records" aria-label="其他档案">
					<ul>
						{recentEntries.map(({ view, image }, index) => (
							<li>
								<a
									href={`/archive/${view.id}/`}
									aria-label={`查看档案：${view.title}`}
									data-home-recent-record={view.id}
									data-home-recent-category={getArchiveCategorySlug(view.objectType)}
								>
									<span class="recent-record-image">
										<span class="recent-record-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
										{image && (
											<img
												src={image.src}
												srcset={image.srcset}
												sizes="(max-width: 760px) 94px, 312px"
												alt=""
												width={image.width}
												height={image.height}
												loading="lazy"
												decoding="async"
											/>
										)}
									</span>
									<span class="recent-record-copy">
										<small>{view.typeLabel} · {view.dateDisplay}</small>
										<strong>{view.title}</strong>
										<em>查看档案 →</em>
									</span>
								</a>
								<div class="recent-record-actions">
									<ArchiveLikeButton itemId={view.id} title={view.title} compact />
								</div>
							</li>
						))}
					</ul>
				</section>
			</section>
		)}
	</div>
	<script type="application/json" id="random-record-index" set:html={JSON.stringify(randomRecordIds)} />
	<script>
		import '../scripts/archive-likes';
		import '../scripts/home-featured-carousel';
		import '../scripts/random-record';
		import { clearViewHistory, readViewHistory } from '../scripts/view-history';

		// 浏览足迹：完全在访客浏览器本地渲染，没有足迹时区块保持隐藏。
		const historySection = document.querySelector<HTMLElement>('[data-view-history]');
		const historyList = historySection?.querySelector<HTMLElement>('[data-view-history-list]');
		const historyClearButton = historySection?.querySelector<HTMLButtonElement>('[data-view-history-clear]');

		const renderViewHistory = () => {
			if (!historySection || !historyList) return;
			const entries = readViewHistory().slice(0, 4);
			historySection.hidden = entries.length === 0;
			historyList.replaceChildren(...entries.map((entry) => {
				const item = document.createElement('li');
				const link = document.createElement('a');
				link.href = `/archive/${entry.id}/`;
				link.setAttribute('aria-label', `继续查看档案：${entry.title}`);
				const image = document.createElement('span');
				image.className = 'view-history-image';
				if (entry.imageSrc) {
					const img = document.createElement('img');
					img.src = entry.imageSrc;
					img.alt = '';
					img.width = entry.imageWidth;
					img.height = entry.imageHeight;
					img.loading = 'lazy';
					img.decoding = 'async';
					image.append(img);
				}
				const copy = document.createElement('span');
				copy.className = 'view-history-copy';
				const meta = document.createElement('small');
				meta.textContent = `${entry.typeLabel} · ${entry.dateDisplay || '年代未知'}`;
				const title = document.createElement('strong');
				title.textContent = entry.title;
				const open = document.createElement('em');
				open.textContent = '继续查看 →';
				copy.append(meta, title, open);
				link.append(image, copy);
				item.append(link);
				return item;
			}));
		};

		historyClearButton?.addEventListener('click', () => {
			clearViewHistory();
			renderViewHistory();
		});

		renderViewHistory();
	</script>
</BaseLayout>

<style>
	.home {
		/* 字间距统一分四档：紧凑 / 常规 / 宽松 / 展示，避免零散数值 */
		--ls-tight: 0.05em;
		--ls-text: 0.08em;
		--ls-wide: 0.12em;
		--ls-display: 0.22em;
		width: min(100%, 65rem);
		margin: 0 auto;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		align-items: stretch;
		gap: clamp(28px, 4vw, 48px);
		padding: clamp(36px, 4vw, 48px) clamp(0.8rem, 2vw, 1.25rem) clamp(36px, 4vw, 48px);
		background: #f1ecdf;
		border-bottom: 1px solid rgba(188, 181, 164, 0.68);
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
	}

	.masthead {
		--masthead-mark-size: clamp(44px, 4vw, 48px);
		--masthead-gap: clamp(12px, 1.4vw, 16px);
	}

	.masthead h1,
	.masthead p,
	.introduction p {
		margin: 0;
	}

	.masthead h1 {
		font-family: var(--site-brand-font);
		font-size: clamp(2.25rem, 4.1vw, 3rem);
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: var(--ls-tight);
		white-space: nowrap;
	}

	.masthead-title {
		display: flex;
		align-items: center;
		gap: var(--masthead-gap);
	}

	.masthead-mark {
		width: var(--masthead-mark-size);
		height: var(--masthead-mark-size);
		flex: 0 0 auto;
	}

	.masthead p {
		margin-top: 8px;
		margin-left: calc(var(--masthead-mark-size) + var(--masthead-gap));
		color: #514c43;
		font-family: var(--site-brand-font);
		font-size: clamp(0.875rem, 1.4vw, 1.125rem);
		font-weight: 500;
		line-height: 1.8;
		letter-spacing: var(--ls-display);
	}

	.introduction p {
		max-width: 19em;
		text-wrap: balance;
		font-size: clamp(1.03rem, 1.55vw, 1.22rem);
		font-weight: 400;
		line-height: 1.9;
		letter-spacing: var(--ls-tight);
	}

	.introduction-line {
		display: block;
		white-space: nowrap;
	}

	.introduction {
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
	}

	.introduction-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 22px;
	}

	.browse-link {
		min-height: 44px;
		padding: 0.7rem 1.2rem;
		font-size: 0.9375rem;
		letter-spacing: var(--ls-wide);
	}

	.hero-record-shell {
		min-width: 0;
	}

	.view-history {
		margin: clamp(1.9rem, 3.8vw, 2.75rem) 0 0;
		padding: 1.05rem clamp(1rem, 2.2vw, 1.25rem) 1.2rem;
		background: rgba(224, 215, 197, 0.3);
		border-left: 3px solid var(--site-accent);
	}

	.view-history-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.view-history-title {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
	}

	.view-history-title > :global(.site-icon) {
		flex: 0 0 auto;
		width: 1.2rem;
		height: 1.2rem;
		color: var(--site-accent);
	}

	.view-history-title h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: var(--ls-wide);
	}

	.view-history-title p {
		margin: 0.22rem 0 0;
		color: #655f52;
		font-size: 0.74rem;
		line-height: 1.55;
		letter-spacing: var(--ls-text);
	}

	.view-history-clear {
		flex: 0 0 auto;
		min-height: 44px;
		padding: 0.45rem 0.85rem;
		color: #6d675c;
		background: transparent;
		border: 1px solid #b9b1a0;
		font: inherit;
		font-size: 0.78rem;
		letter-spacing: var(--ls-text);
		cursor: pointer;
	}

	.view-history-clear:hover {
		color: var(--site-accent);
		border-color: var(--site-accent);
	}

	.view-history-clear:focus-visible {
		outline: 2px solid #575349;
		outline-offset: 2px;
	}

	.view-history-clear:active {
		transform: translateY(1px);
	}

	.view-history-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.9rem;
		margin: 0.95rem 0 0;
		padding: 0;
		list-style: none;
	}

	.view-history-list a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.7rem;
		align-items: center;
		min-height: 44px;
		padding: 0.35rem;
		color: inherit;
		text-decoration: none;
	}

	.view-history-list a:hover strong,
	.view-history-list a:focus-visible strong {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.32em;
	}

	.view-history-list a:active {
		transform: translateY(1px);
	}

	.view-history-image {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.4rem;
		height: 3.4rem;
		overflow: hidden;
		background: #e7dfcd;
		border: 1px solid #c4baa7;
	}

	.view-history-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.view-history-copy {
		display: grid;
		gap: 0.12rem;
		min-width: 0;
	}

	.view-history-copy small {
		color: #655f52;
		font-size: 0.7rem;
		letter-spacing: var(--ls-text);
		line-height: 1.5;
	}

	.view-history-copy strong {
		overflow: hidden;
		font-size: 0.88rem;
		font-weight: 500;
		line-height: 1.5;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.view-history-copy em {
		color: var(--site-accent);
		font-size: 0.72rem;
		font-style: normal;
		letter-spacing: var(--ls-text);
		line-height: 1.5;
	}

	.hero-record-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.72rem;
		margin-top: 0.72rem;
	}

	.hero-record {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.hero-record figure {
		position: relative;
		margin: 0;
		padding: clamp(0.55rem, 1vw, 0.72rem);
		background: #e7dfcd;
		border: 1px solid #c4baa7;
		box-shadow: 0.7rem 0.7rem 0 rgba(90, 79, 61, 0.07);
		transition: border-color 180ms ease, box-shadow 180ms ease;
	}

	.hero-record-image {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #d8d1c0;
	}

	.hero-record img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 240ms ease;
	}

	.hero-record-index {
		position: absolute;
		top: 0;
		left: 0;
