---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandMark from '../components/BrandMark.astro';
import { archiveItems } from '../data/archive';
import {
	archiveCategories,
	getArchiveCategorySlug,
} from '../data/archive-categories';
import { createArchiveRecordView, isPublishedArchiveItem } from '../data/archive-view';
import { getResponsiveImage } from '../data/responsive-images';

const publishedItems = archiveItems.filter(isPublishedArchiveItem);
const publishedViews = publishedItems.map(createArchiveRecordView);
const categoryCounts = new Map<string, number>();
for (const item of publishedItems) {
	const slug = getArchiveCategorySlug(item.core.object_type);
	categoryCounts.set(slug, (categoryCounts.get(slug) ?? 0) + 1);
}

// 首页的“上传时间”沿用项目现有的“最近收录”定义：优先按首次录入日期，
// 缺失时才使用获得日期；同一天再用更新时间、获得日期和永久编号稳定排序。
const compareViewsByCreatedDate = (left: (typeof publishedViews)[number], right: (typeof publishedViews)[number]) => {
	const leftCreated = left.item.core.created_date?.trim() || left.item.core.accession_date?.trim() || '';
	const rightCreated = right.item.core.created_date?.trim() || right.item.core.accession_date?.trim() || '';
	const createdOrder = rightCreated.localeCompare(leftCreated);
	if (createdOrder !== 0) return createdOrder;
	const updatedOrder = (right.item.core.updated_date ?? '').localeCompare(left.item.core.updated_date ?? '');
	if (updatedOrder !== 0) return updatedOrder;
	const accessionOrder = (right.item.core.accession_date ?? '').localeCompare(left.item.core.accession_date ?? '');
	if (accessionOrder !== 0) return accessionOrder;
	return right.id.localeCompare(left.id, 'zh-CN', { numeric: true, sensitivity: 'base' });
};
const categoryViewGroups = archiveCategories.map((category) => ({
	category,
	views: publishedViews
		.filter((view) => getArchiveCategorySlug(view.objectType) === category.slug && Boolean(view.images[0]))
		.sort(compareViewsByCreatedDate),
}));

// 上方精选：每种访客分类取创建时间最新的一件，只展示首张图片，
// 按分类顺序排列，总数由实际符合条件的分类决定（最多 7 张）。
const featuredSlides = categoryViewGroups.flatMap(({ category, views }) => {
	const view = views[0];
	const source = view?.images[0];
	return view && source ? [{
		image: getResponsiveImage(source),
		description: view.imageDescriptions[0],
		itemId: view.id,
		title: view.title,
		dateDisplay: view.dateDisplay,
		href: `/archive/${view.id}/`,
		categorySlug: category.slug,
	}] : [];
});
const featuredImage = featuredSlides[0]?.image;
const firstFeaturedSlide = featuredSlides[0];

// 下方继续浏览：整件排除上方已经使用的藏品，避免其第二张、第三张图片
// 以任何形式重复出现；再按分类取剩余藏品中创建时间最新的一件及其首图。
const featuredRecordIds = new Set(featuredSlides.map((slide) => slide.itemId));
const recentViews = categoryViewGroups.flatMap(({ views }) => {
	const newestRemainingView = views.find((view) => !featuredRecordIds.has(view.id));
	return newestRemainingView ? [newestRemainingView] : [];
});

// 首页策展说明只组合已经公开的类型、年代与地点字段，不使用推测性叙述。
const createHomepageRecordNote = (view: (typeof publishedViews)[number]) => {
	const place = [
		view.item.core.specific_place,
		view.item.core.street_town,
		view.item.core.district,
		view.item.core.city,
		view.item.core.province,
		view.item.core.country,
	].find((value) => value?.trim())?.trim();
	const dateFact = view.dateDisplay === '年代未知'
		? '年代尚待确认'
		: `年代记录为 ${view.dateDisplay}`;
	return place
		? `${view.typeLabel}，${dateFact}，地点标注为${place}。`
		: `${view.typeLabel}，${dateFact}。`;
};

const recentEntries = recentViews.map((view) => ({
	view,
	image: view.images[0] ? getResponsiveImage(view.images[0]) : undefined,
	note: createHomepageRecordNote(view),
}));
// 编辑式版式：第一件作为横向主图版，其余作为右侧错落的小件。
const [leadEntry, ...sideEntries] = recentEntries;

// 随手翻一件：把全部已公开档案编号写入页面，供浏览器端随机挑选跳转。
const randomRecordIds = publishedViews.map((view) => view.id);
const categoryEntries = archiveCategories.map((category, index) => {
	const count = categoryCounts.get(category.slug) ?? 0;
	return {
		...category,
		count,
		indexLabel: String(index + 1).padStart(2, '0'),
	};
});
// 分类分区：有藏品的分类用较大卡片展示，空分类收纳为一行轻量说明。
const activeCategories = categoryEntries.filter((entry) => entry.count > 0);
const pendingCategories = categoryEntries.filter((entry) => entry.count === 0);
---

<BaseLayout image={featuredImage?.src}>
	<div class="home">
		<noscript>
			<style>
				.hero-carousel-controls,
				[data-random-record-button] { display: none !important; }
			</style>
		</noscript>
		<div class="hero">
			<div class="hero-copy">
				<header class="masthead">
					<div class="masthead-title">
						<div class="masthead-mark"><BrandMark variant="seal" /></div>
						<h1>老旧默片</h1>
					</div>
					<p>普通人的生活档案</p>
				</header>
				<section class="introduction" aria-label="网站介绍">
					<p>
						<span class="introduction-line">从一张照片、一封信和一件旧物开始，</span>
						<span class="introduction-line">保存普通人的生活痕迹。</span>
					</p>
					<div class="introduction-actions">
						<a class="browse-link ui-action ui-action--primary" href="/archive/">进入馆藏 →</a>
						<button class="browse-link random-record-link" type="button" data-random-record-button>随手翻一件</button>
					</div>
				</section>
			</div>

			{featuredImage && firstFeaturedSlide && (
				<div
					class="hero-record-shell"
					data-home-featured-record={firstFeaturedSlide.itemId}
					data-home-featured-carousel={featuredSlides.length > 1 ? '' : undefined}
					data-carousel-category-order={featuredSlides.map((slide) => slide.categorySlug).join(',')}
					data-carousel-record-order={featuredSlides.map((slide) => slide.itemId).join(',')}
					data-carousel-items={featuredSlides.length > 1 ? JSON.stringify(featuredSlides.map(({ image, description, itemId, title, dateDisplay, href }) => ({
						src: image.src,
						srcset: image.srcset ?? '',
						width: image.width,
						height: image.height,
						description,
						itemId,
						title,
						dateDisplay,
						href,
					}))) : undefined}
					role={featuredSlides.length > 1 ? 'region' : undefined}
					aria-roledescription={featuredSlides.length > 1 ? '轮播图' : undefined}
					aria-label={featuredSlides.length > 1 ? '精选公开藏品图片' : undefined}
				>
					<a
						class="hero-record"
						href={firstFeaturedSlide.href}
						aria-label={`查看精选档案：${firstFeaturedSlide.title}`}
						data-home-carousel-link={featuredSlides.length > 1 ? '' : undefined}
					>
						<figure>
							<div class="hero-record-image">
								<img
									src={featuredImage.src}
									srcset={featuredImage.srcset}
									sizes="(max-width: 760px) calc(100vw - 32px), 640px"
									alt={firstFeaturedSlide.description}
									width={featuredImage.width}
									height={featuredImage.height}
									loading="eager"
									fetchpriority="high"
									decoding="async"
									data-home-carousel-image={featuredSlides.length > 1 ? '' : undefined}
								/>
							</div>
							<figcaption>
								<div class="hero-record-heading">
									<small class="hero-record-date"><span>年代</span><span data-home-carousel-date>{firstFeaturedSlide.dateDisplay}</span></small>
									<strong data-home-carousel-title>{firstFeaturedSlide.title}</strong>
								</div>
							</figcaption>
						</figure>
					</a>
					{featuredSlides.length > 1 && (
						<div class="hero-carousel-controls" aria-label="精选图片轮播控制">
							<button type="button" class="carousel-arrow carousel-arrow--prev" data-home-carousel-previous aria-label="查看上一张精选图片">
								<span aria-hidden="true">←</span>
							</button>
							<div class="carousel-dots" data-home-carousel-dots role="tablist" aria-label="精选图片页码">
								{featuredSlides.map((slide, index) => (
									<button
										type="button"
										class="carousel-dot"
										role="tab"
										aria-selected={index === 0 ? 'true' : 'false'}
										aria-label={`第 ${index + 1} 张精选图片`}
										data-home-carousel-dot={index}
									/>
								))}
							</div>
							<button type="button" class="carousel-arrow carousel-arrow--next" data-home-carousel-next aria-label="查看下一张精选图片">
								<span aria-hidden="true">→</span>
							</button>
							<span class="carousel-announcement" data-home-carousel-announcement aria-live="polite"></span>
						</div>
					)}
				</div>
			)}
		</div>

		<nav class="archive-entrances" aria-label="档案分类入口">
			<div class="archive-entrances-heading">
				<div class="archive-entrances-title">
					<p>按藏品类型浏览</p>
				</div>
			</div>
			<ul class="category-active-list">
				{activeCategories.map((category) => (
					<li class="has-records">
						<a href={`/archive/?category=${category.slug}`}>
							<span class="category-index" aria-hidden="true">{category.indexLabel}</span>
							<strong>{category.label}</strong>
							<small>{category.count} 件档案</small>
							<span class="category-arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
			{pendingCategories.length > 0 && (
				<p class="category-pending">
					<span class="category-pending-label">正在整理：</span>
					{pendingCategories.map((category, index) => (
						<>
							{index > 0 && <span class="category-pending-sep" aria-hidden="true"> · </span>}
							<a class="category-pending-link" href={`/archive/?category=${category.slug}`}>{category.label}</a>
						</>
					))}
				</p>
			)}
		</nav>

		{recentEntries.length > 0 && leadEntry && (
			<section class="home-discovery" aria-labelledby="discovery-heading">
				<header class="discovery-heading">
					<div class="discovery-title">
						<p class="discovery-kicker">馆藏选读</p>
						<h2 id="discovery-heading">继续浏览</h2>
					</div>
					<a class="ui-text-link" href="/archive/">查看档案目录 →</a>
				</header>

				<div class:list={['recent-records', { 'recent-records--solo': sideEntries.length === 0 }]}>
					<article class="recent-lead">
						<a
							href={`/archive/${leadEntry.view.id}/`}
							aria-label={`查看档案：${leadEntry.view.title}`}
							data-home-recent-record={leadEntry.view.id}
							data-home-recent-category={getArchiveCategorySlug(leadEntry.view.objectType)}
						>
							<span class="recent-lead-image">
								{leadEntry.image && (
									<img
										src={leadEntry.image.src}
										srcset={leadEntry.image.srcset}
										sizes="(max-width: 760px) calc(100vw - 32px), 620px"
										alt=""
										width={leadEntry.image.width}
										height={leadEntry.image.height}
										loading="lazy"
										decoding="async"
									/>
								)}
							</span>
							<span class="recent-lead-copy">
								<small><span class="recent-record-index" aria-hidden="true">01</span>{leadEntry.view.typeLabel} · {leadEntry.view.dateDisplay}</small>
								<strong>{leadEntry.view.title}</strong>
								<p class="recent-lead-note">{leadEntry.note}</p>
								<em>查看档案 →</em>
							</span>
						</a>
					</article>

					{sideEntries.length > 0 && (
						<div class="recent-side-col">
							<ul class="recent-side">
								{sideEntries.map(({ view, image, note }, index) => (
									<li>
										<a
											href={`/archive/${view.id}/`}
											aria-label={`查看档案：${view.title}`}
											data-home-recent-record={view.id}
											data-home-recent-category={getArchiveCategorySlug(view.objectType)}
										>
											<span class="recent-record-image">
												{image && (
													<img
														src={image.src}
														srcset={image.srcset}
														sizes="(max-width: 760px) 88px, 144px"
														alt=""
														width={image.width}
														height={image.height}
														loading="lazy"
														decoding="async"
													/>
												)}
											</span>
											<span class="recent-record-copy">
												<small><span class="recent-record-index" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>{view.typeLabel} · {view.dateDisplay}</small>
												<strong>{view.title}</strong>
												<p class="recent-record-note">{note}</p>
												<em>查看档案 →</em>
											</span>
										</a>
									</li>
								))}
							</ul>
							<p class="recent-side-note">更多档案正在整理、核对与释读中。</p>
						</div>
					)}
				</div>
			</section>
		)}

		<section class="view-history" data-view-history hidden aria-labelledby="view-history-heading">
			<header class="view-history-header">
				<div class="view-history-title">
					<h2 id="view-history-heading">最近看过</h2>
				</div>
				<button class="view-history-clear" type="button" data-view-history-clear>清空足迹</button>
			</header>
			<ul class="view-history-list" data-view-history-list></ul>
		</section>
	</div>
	<script type="application/json" id="random-record-index" set:html={JSON.stringify(randomRecordIds)} />
	<script>
		import '../scripts/home-featured-carousel';
		import '../scripts/random-record';
		import { clearViewHistory, readViewHistory } from '../scripts/view-history';

		// 浏览足迹：完全在访客浏览器本地渲染，没有足迹时区块保持隐藏。
		const historySection = document.querySelector<HTMLElement>('[data-view-history]');
		const historyList = historySection?.querySelector<HTMLElement>('[data-view-history-list]');
		const historyClearButton = historySection?.querySelector<HTMLButtonElement>('[data-view-history-clear]');

		const renderViewHistory = () => {
			if (!historySection || !historyList) return;
			const entries = readViewHistory().slice(0, 4);
			historySection.hidden = entries.length === 0;
			historyList.replaceChildren(...entries.map((entry) => {
				const item = document.createElement('li');
				item.className = 'view-history-item';
				const link = document.createElement('a');
				link.className = 'view-history-link';
				link.href = `/archive/${entry.id}/`;
				link.setAttribute('aria-label', `继续查看档案：${entry.title}`);
				const image = document.createElement('span');
				image.className = 'view-history-image';
				if (entry.imageSrc) {
					const img = document.createElement('img');
					img.src = entry.imageSrc;
					img.alt = '';
					img.width = entry.imageWidth;
					img.height = entry.imageHeight;
					img.loading = 'lazy';
					img.decoding = 'async';
					image.append(img);
				}
				const copy = document.createElement('span');
				copy.className = 'view-history-copy';
				const meta = document.createElement('small');
				meta.textContent = `${entry.typeLabel} · ${entry.dateDisplay || '年代未知'}`;
				const title = document.createElement('strong');
				title.textContent = entry.title;
				const open = document.createElement('em');
				open.textContent = '继续查看 →';
				copy.append(meta, title, open);
				link.append(image, copy);
				item.append(link);
				return item;
			}));
		};

		historyClearButton?.addEventListener('click', () => {
			clearViewHistory();
			renderViewHistory();
		});

		renderViewHistory();
	</script>
</BaseLayout>

<style>
	.home {
		/* 字间距统一分四档：紧凑 / 常规 / 宽松 / 展示，避免零散数值 */
		--ls-tight: 0.05em;
		--ls-text: 0.08em;
		--ls-wide: 0.12em;
		--ls-display: 0.22em;
		/* 首页展签小字保持至少 12px，并适度收紧中文字距。 */
		--site-text-micro: 0.75rem;
		--site-label-tracking: 0.12em;
		width: min(100%, 65rem);
		margin: 0 auto;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		align-items: center;
		gap: clamp(32px, 5vw, 56px);
		padding: clamp(40px, 5vw, 56px) clamp(1.25rem, 3vw, 2.25rem) clamp(44px, 5vw, 60px);
		background: var(--site-paper);
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-width: 0;
	}

	.masthead {
		--masthead-mark-size: clamp(44px, 4vw, 48px);
		--masthead-gap: clamp(12px, 1.4vw, 16px);
	}

	.masthead h1,
	.masthead p,
	.introduction p {
		margin: 0;
	}

	.masthead h1 {
		font-family: var(--site-brand-font);
		font-size: clamp(2.5rem, 4.6vw, 3.4rem);
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: 0.06em;
		white-space: nowrap;
	}

	.masthead-title {
		display: flex;
		align-items: center;
		gap: var(--masthead-gap);
	}

	.masthead-mark {
		width: var(--masthead-mark-size);
		height: var(--masthead-mark-size);
		flex: 0 0 auto;
	}

	.masthead p {
		margin-top: 10px;
		margin-left: calc(var(--masthead-mark-size) + var(--masthead-gap));
		color: var(--site-muted);
		font-family: var(--site-brand-font);
		font-size: clamp(0.78rem, 1.1vw, 0.9rem);
		font-weight: 500;
		line-height: 1.8;
		letter-spacing: 0.3em;
	}

	.introduction p {
		max-width: 20em;
		text-wrap: balance;
		color: var(--site-text);
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		font-weight: 400;
		line-height: 1.95;
		letter-spacing: var(--ls-tight);
	}

	.introduction-line {
		display: block;
		white-space: nowrap;
	}

	.introduction {
		margin-top: clamp(1.75rem, 3vw, 2.5rem);
	}

	.introduction-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 22px;
	}

	.browse-link {
		min-height: 44px;
		padding: 0.7rem 1.2rem;
		font-size: 0.9375rem;
		letter-spacing: var(--ls-wide);
	}

	.random-record-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding-right: 0.2rem;
		padding-left: 0.2rem;
		color: var(--site-muted);
		background: transparent;
		border: 0;
		font: inherit;
		font-size: 0.84rem;
		letter-spacing: var(--ls-text);
		text-decoration: underline;
		text-decoration-color: var(--site-border);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.34em;
		cursor: pointer;
		transition: color 150ms ease, text-decoration-color 150ms ease;
	}

	.random-record-link:hover,
	.random-record-link:focus-visible {
		color: var(--site-ink);
		text-decoration-color: currentColor;
	}

	/* 随机档案按钮：JS 就绪前先占位但不可见，避免按钮出现时把整行推下去（CLS）。
	   脚本会在拿到有效档案编号后为按钮加上 data-random-record-ready。 */
	[data-random-record-button] {
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transition: opacity 220ms ease, visibility 0s linear 220ms;
	}

	[data-random-record-button][data-random-record-ready] {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transition: opacity 220ms ease, visibility 0s;
	}

	.hero-record-shell {
		position: relative;
		min-width: 0;
	}

	.view-history {
		margin: clamp(3.75rem, 7vw, 5rem) 0 0;
		padding: 1rem 0 0;
		background: transparent;
		border-top: 1px solid var(--site-border-soft);
	}

	.view-history-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.view-history-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	.view-history-title > :global(.site-icon) {
		flex: 0 0 auto;
		width: 1.1rem;
		height: 1.1rem;
		color: var(--site-muted);
	}

	.view-history-title h2 {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 500;
		letter-spacing: var(--ls-wide);
	}

	.view-history-clear {
		flex: 0 0 auto;
		min-height: 44px;
		padding: 0.35rem 0;
		color: #6d675c;
		background: transparent;
		border: 0;
		font: inherit;
		font-size: 0.78rem;
		letter-spacing: var(--ls-text);
		text-decoration: underline;
		text-decoration-color: var(--site-border);
		text-underline-offset: 0.3em;
		cursor: pointer;
	}

	.view-history-clear:hover {
		color: var(--site-ink);
		text-decoration-color: currentColor;
	}

	.view-history-clear:focus-visible {
		outline: 2px solid var(--site-focus-outline);
		outline-offset: 2px;
	}

	.view-history-clear:active {
		transform: translateY(1px);
	}

	.view-history-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.65rem;
		margin: 0.7rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* 列表项由浏览器脚本动态生成，必须用全局子选择器，避免 Astro 的局部样式
	   因动态节点没有页面标记而失效，让原图按自身尺寸撑破版面。 */
	.view-history-list :global(.view-history-item) {
		min-width: 0;
		overflow: hidden;
	}

	.view-history-list :global(.view-history-link) {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 0.6rem;
		align-items: center;
		min-height: 44px;
		padding: 0.15rem 0;
		color: inherit;
		text-decoration: none;
		overflow: hidden;
	}

	.view-history-list :global(.view-history-link:hover strong),
	.view-history-list :global(.view-history-link:focus-visible strong) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.32em;
	}

	.view-history-list :global(.view-history-link:active) {
		transform: translateY(1px);
	}

	.view-history-list :global(.view-history-image) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		max-width: 100%;
		overflow: hidden;
		background: var(--site-mat);
		border: 1px solid var(--site-border-soft);
	}

	.view-history-list :global(.view-history-image img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
	}

	.view-history-list :global(.view-history-copy) {
		display: grid;
		gap: 0;
		min-width: 0;
		overflow: hidden;
	}

	.view-history-list :global(.view-history-copy small) {
		color: var(--site-subtle);
		font-size: 0.75rem;
		letter-spacing: var(--site-label-tracking);
		line-height: 1.4;
	}

	.view-history-list :global(.view-history-copy strong) {
		overflow: hidden;
		font-size: 0.86rem;
		font-weight: 600;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.view-history-list :global(.view-history-copy em) {
		color: var(--site-muted);
		font-size: 0.75rem;
		font-style: normal;
		letter-spacing: var(--ls-text);
		line-height: 1.4;
	}

	.hero-record {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.hero-record figure {
		position: relative;
		margin: 0;
		padding: 0.55rem;
		background: var(--site-mat);
		border: 1px solid var(--site-border-soft);
		box-shadow: 0 8px 24px rgba(70, 61, 45, 0.1), 0 2px 6px rgba(70, 61, 45, 0.05);
		transition: box-shadow 240ms ease, border-color 240ms ease;
	}

	.hero-record-image {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--site-mat-deep);
	}

	.hero-record img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 320ms ease;
	}

	.hero-record figcaption {
		display: block;
		padding: 0.72rem 0.3rem 0.15rem;
	}

	.hero-record-heading {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		gap: 0.7rem;
		min-width: 0;
	}

	.hero-record-date {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		color: var(--site-subtle);
		font-family: var(--site-ui-font);
		font-size: var(--site-text-micro);
		font-weight: 400;
		line-height: 1.45;
		letter-spacing: var(--site-label-tracking);
		white-space: nowrap;
	}

	.hero-record-date span:first-child {
		color: var(--site-subtle);
		font-family: inherit;
		font-size: 0.75rem;
		letter-spacing: var(--site-label-tracking);
	}

	.hero-record figcaption strong {
		min-width: 0;
		font-family: var(--site-brand-font);
		font-size: clamp(1.05rem, 1.7vw, 1.3rem);
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: 0.02em;
	}

	.hero-record:hover img,
	.hero-record:focus-visible img {
		transform: scale(1.012);
	}

	.hero-record:hover figure,
	.hero-record:focus-visible figure {
		border-color: rgba(44, 40, 35, 0.45);
		box-shadow: 0 12px 32px rgba(44, 40, 35, 0.1), 0 3px 8px rgba(44, 40, 35, 0.05);
	}

	.hero-record:active figure {
		transform: translateY(1px);
	}

	.hero-record:hover figcaption strong,
	.hero-record:focus-visible figcaption strong {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
	}

	/* 轮播控件：浮动箭头在图片两侧，圆点指示器在底部居中 */
	.hero-carousel-controls {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		pointer-events: none;
		/* JS 就绪前先占位但不可见，避免控制栏出现时把下方内容推下去（CLS）。 */
		visibility: hidden;
		opacity: 0;
		transition: opacity 200ms ease, visibility 0s linear 200ms;
	}

	.hero-record-shell[data-carousel-ready] .hero-carousel-controls {
		visibility: visible;
		opacity: 1;
		transition: opacity 200ms ease, visibility 0s;
	}

	.carousel-arrow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		color: #5f5a50;
		background: rgba(248, 244, 234, 0.88);
		border: 1px solid rgba(189, 180, 163, 0.6);
		border-radius: 50%;
		cursor: pointer;
		font: inherit;
		font-size: 1rem;
		line-height: 1;
		pointer-events: auto;
		opacity: 0;
		transition: opacity 180ms ease, color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
		backdrop-filter: blur(4px);
	}

	.hero-record-shell:hover .carousel-arrow,
	.hero-record-shell:focus-within .carousel-arrow,
	.carousel-arrow:focus-visible {
		opacity: 1;
	}

	.carousel-arrow:hover,
	.carousel-arrow:focus-visible {
		color: var(--site-ink);
		background: #f8f2e6;
		border-color: rgba(44, 40, 35, 0.45);
		transform: scale(1.06);
	}

	.carousel-arrow:active {
		transform: scale(0.96);
	}

	.carousel-arrow--prev {
		margin-left: -1.25rem;
	}

	.carousel-arrow--next {
		margin-right: -1.25rem;
	}

	.carousel-dots {
		position: absolute;
		bottom: -2rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		pointer-events: auto;
	}

	.carousel-dot {
		width: 0.4rem;
		height: 0.4rem;
		padding: 0;
		background: #b9b1a0;
		border: 0;
		border-radius: 50%;
		cursor: pointer;
		transition: background-color 180ms ease, transform 180ms ease, width 180ms ease;
	}

	.carousel-dot:hover {
		background: #8a8272;
		transform: scale(1.2);
	}

	.carousel-dot[aria-selected='true'] {
		width: 1.2rem;
		background: var(--site-text);
		border-radius: 0.2rem;
	}

	.carousel-dot:focus-visible {
		outline: 2px solid var(--site-focus-outline);
		outline-offset: 3px;
	}

	.carousel-announcement {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.browse-link:focus-visible,
	.archive-entrances a:focus-visible {
		outline: 2px solid var(--site-focus-outline);
		outline-offset: 6px;
	}

	.archive-entrances-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin: clamp(3rem, 6vw, 4.5rem) 0 1rem;
	}

	.archive-entrances-heading p {
		margin: 0;
	}

	.archive-entrances-title {
		color: var(--site-text);
	}

	.archive-entrances-heading p {
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: var(--ls-wide);
	}

	/* 有藏品的分类：去框化，用底部细线 + hover 左侧色条 */
	.category-active-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.category-active-list li {
		border-bottom: 1px solid rgba(188, 181, 164, 0.5);
		font-size: clamp(0.9rem, 1.4vw, 1rem);
		line-height: 1.6;
		letter-spacing: var(--ls-wide);
	}

	.category-active-list li:nth-child(odd) {
		border-right: 1px solid rgba(188, 181, 164, 0.5);
	}

	.category-active-list a {
		display: grid;
		grid-template-columns: 1.5rem minmax(0, 1fr) auto 1rem;
		align-items: center;
		gap: 0.62rem;
		padding: 1.1rem 1rem 1.1rem 0.85rem;
		text-decoration: none;
		transition: color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
	}

	.category-active-list strong {
		min-width: 0;
		font-weight: 500;
		word-break: keep-all;
		overflow-wrap: normal;
	}

	.category-index {
		color: var(--site-subtle);
		font-family: var(--site-ui-font);
		font-size: var(--site-text-micro);
		letter-spacing: var(--ls-text);
	}

	.archive-entrances :global(.category-icon) {
		width: 1.15rem;
		height: 1.15rem;
		color: var(--site-subtle);
		stroke-width: 1.45;
	}

	.category-active-list small {
		flex: 0 0 auto;
		color: var(--site-subtle);
		font-size: var(--site-text-micro);
		letter-spacing: var(--site-label-tracking);
		white-space: nowrap;
	}

	.category-arrow {
		color: var(--site-subtle);
		font-size: 0.8rem;
		opacity: 0;
		transition: transform 160ms ease, opacity 160ms ease;
	}

	.category-active-list .has-records a {
		box-shadow: none;
	}

	.category-active-list .has-records strong {
		font-weight: 600;
	}

	.category-active-list a:hover,
	.category-active-list a:focus-visible {
		color: var(--site-text);
		background: rgba(44, 40, 35, 0.04);
	}

	.category-active-list a:hover .category-index,
	.category-active-list a:focus-visible .category-index,
	.category-active-list a:hover :global(.category-icon),
	.category-active-list a:focus-visible :global(.category-icon) {
		color: var(--site-ink);
	}

	.category-active-list a:hover strong,
	.category-active-list a:focus-visible strong {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.35em;
	}

	.category-active-list a:hover .category-arrow,
	.category-active-list a:focus-visible .category-arrow {
		opacity: 1;
		transform: translateX(3px);
	}

	.category-active-list a:active {
		transform: translateY(1px);
	}

	/* 待收录分类：一行轻量说明，每个词可点击 */
	.category-pending {
		margin: 1.25rem 0 0;
		color: var(--site-subtle);
		font-size: 0.82rem;
		line-height: 2;
		letter-spacing: var(--ls-text);
	}

	.category-pending-label {
		color: var(--site-subtle);
	}

	.category-pending-sep {
		color: var(--site-border);
	}

	.category-pending-link {
		color: var(--site-muted);
		text-decoration: underline;
		text-decoration-color: rgba(44, 40, 35, 0.28);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.3em;
		transition: color 160ms ease, text-decoration-color 160ms ease;
	}

	.category-pending-link:hover,
	.category-pending-link:focus-visible {
		color: var(--site-ink);
		text-decoration-color: var(--site-ink);
	}

	/* 继续浏览区：编辑式版式——左侧横向主图版，右侧小件错落排列 */
	.home-discovery {
		margin-top: clamp(4rem, 8vw, 6rem);
	}

	.discovery-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
		padding-bottom: 0.85rem;
		border-bottom: 1px solid var(--site-border-soft);
	}

	.discovery-heading h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.15rem);
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.discovery-title {
		display: grid;
		gap: 0.4rem;
	}

	.discovery-kicker {
		margin: 0;
		color: var(--site-subtle);
		font-size: 0.75rem;
		line-height: 1.4;
		letter-spacing: 0.18em;
	}

	.recent-records {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		gap: clamp(2rem, 4.5vw, 3.25rem);
		align-items: start;
	}

	.recent-records--solo {
		grid-template-columns: minmax(0, 1fr);
	}

	.recent-lead > a {
		display: grid;
		gap: 1.1rem;
		color: inherit;
		text-decoration: none;
	}

	.recent-lead-image {
		position: relative;
		display: block;
		padding: 0.55rem;
		background: var(--site-mat);
		border: 1px solid var(--site-border-soft);
		box-shadow: 0 6px 18px rgba(70, 61, 45, 0.08);
		overflow: hidden;
		transition: border-color 200ms ease, box-shadow 200ms ease;
	}

	.recent-lead-image img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
		background: var(--site-mat-deep);
		transition: transform 260ms ease;
	}

	.recent-lead-copy {
		display: grid;
		justify-items: start;
		gap: 0.5rem;
		min-width: 0;
	}

	.recent-lead-copy small {
		color: var(--site-subtle);
		font-size: 0.75rem;
		letter-spacing: var(--site-label-tracking);
		line-height: 1.6;
	}

	.recent-lead-copy strong {
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		font-weight: 600;
		line-height: 1.45;
		letter-spacing: 0.02em;
	}

	.recent-lead-note {
		margin: 0;
		max-width: 36em;
		color: var(--site-muted);
		font-size: 0.86rem;
		line-height: 1.9;
		letter-spacing: 0.04em;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.recent-lead-copy em {
		color: var(--site-muted);
		font-size: 0.76rem;
		font-style: normal;
		letter-spacing: var(--ls-text);
		transition: transform 160ms ease;
	}

	.recent-lead > a:hover img,
	.recent-lead > a:focus-visible img {
		transform: scale(1.015);
	}

	.recent-lead > a:hover .recent-lead-image,
	.recent-lead > a:focus-visible .recent-lead-image {
		border-color: rgba(44, 40, 35, 0.4);
		box-shadow: 0 8px 22px rgba(44, 40, 35, 0.09);
	}

	.recent-lead > a:hover strong,
	.recent-lead > a:focus-visible strong {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.32em;
	}

	.recent-lead > a:hover em,
	.recent-lead > a:focus-visible em {
		transform: translateX(3px);
	}

	.recent-lead > a:active {
		transform: translateY(1px);
	}

	/* 右侧小件适度下移，形成错落节奏，同时保持足够的图文分量。 */
	.recent-side-col {
		min-width: 0;
		margin-top: clamp(1.5rem, 4vw, 3rem);
	}

	.recent-side {
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.recent-side li {
		min-width: 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--site-border-soft);
	}

	.recent-side li:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.recent-side a {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		color: inherit;
		text-decoration: none;
	}

	.recent-record-image {
		position: relative;
		display: block;
		padding: 0.3rem;
		background: var(--site-mat);
		border: 1px solid var(--site-border-soft);
		box-shadow: 0 4px 12px rgba(70, 61, 45, 0.07);
		overflow: hidden;
		transition: border-color 200ms ease, box-shadow 200ms ease;
	}

	.recent-side img {
		display: block;
		width: 100%;
		height: 6.25rem;
		object-fit: contain;
		background: var(--site-mat-deep);
		transition: transform 260ms ease;
	}

	.recent-record-copy {
		display: grid;
		gap: 0.4rem;
		align-content: start;
		min-width: 0;
	}

	.recent-record-copy small {
		color: var(--site-subtle);
		font-size: 0.75rem;
		letter-spacing: var(--site-label-tracking);
		line-height: 1.6;
	}

	.recent-record-copy strong {
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.5;
		letter-spacing: 0.02em;
	}

	.recent-record-copy em {
		color: var(--site-muted);
		font-size: 0.75rem;
		font-style: normal;
		letter-spacing: var(--ls-text);
		transition: transform 160ms ease;
	}

	/* 编号用展签小字，不再使用朱红 */
	.recent-record-index {
		margin-right: 0.55rem;
		color: var(--site-subtle);
		font-family: var(--site-ui-font);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
	}

	.recent-record-note {
		display: -webkit-box;
		margin: 0;
		overflow: hidden;
		color: var(--site-muted);
		font-size: 0.78rem;
		line-height: 1.65;
		letter-spacing: 0.03em;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.recent-side a:hover img,
	.recent-side a:focus-visible img {
		transform: scale(1.02);
	}

	.recent-side a:hover .recent-record-image,
	.recent-side a:focus-visible .recent-record-image {
		border-color: rgba(44, 40, 35, 0.4);
		box-shadow: 0 6px 16px rgba(44, 40, 35, 0.08);
	}

	.recent-side a:hover strong,
	.recent-side a:focus-visible strong {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.32em;
	}

	.recent-side a:hover em,
	.recent-side a:focus-visible em {
		transform: translateX(3px);
	}

	.recent-side a:active {
		transform: translateY(1px);
	}

	.recent-side-note {
		margin: 1.75rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--site-border-soft);
		color: var(--site-subtle);
		font-size: 0.78rem;
		line-height: 1.9;
		letter-spacing: var(--ls-text);
	}

	@media (max-width: 760px) {
		.hero {
			display: flex;
			flex-direction: column;
			align-items: start;
			gap: 0;
			padding: 24px 0.8rem 28px;
		}

		.hero-copy {
			display: contents;
		}

		.masthead {
			--masthead-mark-size: 36px;
			--masthead-gap: 12px;
			order: 1;
			align-self: center;
			max-width: 100%;
		}

		.hero-record-shell {
			order: 2;
			width: 100%;
			margin-top: 1.25rem;
		}

		.hero-carousel-controls {
			/* 移动端箭头常驻显示，不依赖 hover */
			opacity: 1;
		}

		.carousel-arrow {
			width: 2.25rem;
			height: 2.25rem;
			opacity: 0.85;
		}

		.carousel-arrow--prev {
			margin-left: -0.5rem;
		}

		.carousel-arrow--next {
			margin-right: -0.5rem;
		}

		.carousel-dots {
			bottom: -1.75rem;
			gap: 0.4rem;
		}

		.introduction {
			order: 3;
			width: 100%;
			margin-top: 1.25rem;
		}

