---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeEditorial from '../components/HomeEditorial.astro';
import { t, getLocale } from '../i18n/ui';
import { serializeHtmlJson } from '../../../shared/html-json.mjs';
import { archiveItems } from '../data/archive';
import { archiveCategories, getArchiveCategorySlug } from '../data/archive-categories';
import { createArchiveRecordView, isPublishedArchiveItem } from '../data/archive-view';
import { createAlbumBrowseViews } from '../data/album-browse';
import { getResponsiveImage } from '../data/responsive-images';

const locale = getLocale(Astro.url.pathname);
const publishedItems = archiveItems.filter(isPublishedArchiveItem);
const publishedViews = publishedItems.map(item => createArchiveRecordView(item, locale));
const albums = createAlbumBrowseViews(publishedItems, locale);
const categoryEntries = archiveCategories.map(category => ({
  ...category,
  count: publishedItems.filter(item => getArchiveCategorySlug(item.core.object_type) === category.slug).length,
}));
const dalianRecord = publishedViews.find(view => view.id === 'LJM-20261018-PHO-001' && view.images[0]);
const primaryAlbum = albums.find(album => album.memberIds.includes('LJM-20261018-PHO-001'))
  ?? (!dalianRecord ? albums.find(album => album.coverPath) : undefined);
const primaryRecord = dalianRecord
  ?? publishedViews.find(view => view.images[0]);
const shareSource = primaryAlbum?.coverPath ?? primaryRecord?.images[0];
const shareImage = shareSource ? getResponsiveImage(shareSource).src : undefined;
const randomRecordIds = publishedViews.map(view => view.id);
---

<BaseLayout image={shareImage} homepageStyle="editorial">
  <div class="home">
    <noscript><style>[data-random-record-button] { display: none !important; }</style></noscript>
    <HomeEditorial locale={locale} albums={albums} records={publishedViews} categories={categoryEntries} />
    <section class="view-history" data-view-history hidden aria-labelledby="view-history-heading">
      <header class="view-history-header">
        <h2 id="view-history-heading">{t('最近看过', locale)}</h2>
        <button class="view-history-clear" type="button" data-view-history-clear>{t('清空足迹', locale)}</button>
      </header>
      <ul class="view-history-list" data-view-history-list></ul>
    </section>
  </div>
  <script type="application/json" id="random-record-index" set:html={serializeHtmlJson(randomRecordIds)} />
  <script>
    import { clientText as ct, clientPath } from '../i18n/client';
    import '../scripts/random-record';
    import { clearViewHistory, readLocalizedViewHistory } from '../scripts/view-history';

    const historySection = document.querySelector<HTMLElement>('[data-view-history]');
    const historyList = historySection?.querySelector<HTMLElement>('[data-view-history-list]');
    const historyClearButton = historySection?.querySelector<HTMLButtonElement>('[data-view-history-clear]');

    const renderViewHistory = async () => {
      if (!historySection || !historyList) return;
      const entries = (await readLocalizedViewHistory()).slice(0, 4);
      historySection.hidden = entries.length === 0;
      historyList.replaceChildren(...entries.map(entry => {
        const item = document.createElement('li');
        item.className = 'view-history-item';
        const link = document.createElement('a');
        link.className = 'view-history-link';
        link.href = clientPath(`/archive/${entry.id}/`);
        link.setAttribute('aria-label', ct('继续查看档案：{0}', { 0: entry.title }));
        const image = document.createElement('span');
        image.className = 'view-history-image';
        if (entry.imageSrc) {
          const img = document.createElement('img');
          img.src = entry.imageSrc;
          img.alt = '';
          img.width = entry.imageWidth;
          img.height = entry.imageHeight;
          img.loading = 'lazy';
          img.decoding = 'async';
          image.append(img);
        }
        const copy = document.createElement('span');
        copy.className = 'view-history-copy';
        const meta = document.createElement('small');
        meta.textContent = `${entry.typeLabel} · ${entry.dateDisplay || ct('年代未知')}`;
        const title = document.createElement('strong');
        title.textContent = entry.title;
        const open = document.createElement('em');
        open.textContent = ct('继续查看 →');
        copy.append(meta, title, open);
        link.append(image, copy);
        item.append(link);
        return item;
      }));
    };
    historyClearButton?.addEventListener('click', () => {
      clearViewHistory();
      renderViewHistory();
    });
    renderViewHistory();
  </script>
</BaseLayout>

<style>
  .home {
    width: 100%;
    margin: auto;
  }
  .view-history[hidden] {
    display: none;
  }
  .view-history {
    margin-top: 44px;
    padding-top: 30px;
    border-top: 1px solid #dcd5c9;
  }
  .view-history-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .view-history h2 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.6;
  }
  .view-history-clear {
    background: none;
    border: 0;
    padding: 8px 0;
    color: var(--site-muted);
    cursor: pointer;
    font: .875rem/1.7 var(--site-ui-font);
  }
  .view-history-list {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .view-history-list :global(.view-history-item) {
    min-width: 0;
  }
  .view-history-list :global(.view-history-link) {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: inherit;
    text-decoration: none;
  }
  .view-history-list :global(.view-history-image) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 160px;
    background: #f0ece3;
    padding: 12px;
  }
  .view-history-list :global(.view-history-image img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .view-history-list :global(.view-history-copy) {
    display: grid;
    gap: 7px;
  }
  .view-history-list :global(.view-history-copy strong) {
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .view-history-list :global(.view-history-copy small),.view-history-list :global(.view-history-copy em) {
    color: var(--site-muted);
    font: .8125rem/1.7 var(--site-ui-font);
  }
  .view-history-list :global(.view-history-link:hover strong) {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media(max-width:760px) {
    .view-history-list {
      grid-template-columns: repeat(2,minmax(0,1fr));
      gap: 24px 18px;
    }
    .view-history h2 {
      font-size: 1.5rem;
    }
  }
</style>
