# 放在 laojiumopian.com 的公开站点块内、静态文件服务之前。
# 只代理公开投稿与联系接收端口；严禁将 /api/admin/* 代理到公开站点。
@public_inbox path /api/submissions /api/submissions/* /api/contact /api/contact/*
handle @public_inbox {
 request_body {
  max_size 28MB
 }
 reverse_proxy 127.0.0.1:4176 {
  header_up X-LJM-Client-IP {client_ip}
 }
}
# 保留现有管理域名的 Cloudflare Access 验证与公开目录设置。
# 如果 Caddy 位于 Cloudflare 之后，沿用现有可信代理配置；不能直接信任访客自带的 IP 请求头。
