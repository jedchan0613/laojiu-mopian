# 供管理服务和账号服务共同读取，只放说明书开关。PDF由既有独立配置控制。
# 两个服务的 .service.d 目录均使用 60-manuals-settings.conf。
# 完成正式上线清单并取得授权后，才在服务器专用配置改为true。
LJM_MANUALS_ONLINE_ENABLED=false
# 专用非PDF审核默认关闭。线上保存需要Linux部署锁；8.5获批后再启用。
LJM_MANUAL_REVIEW_ONLINE_ENABLED=false
# 非PDF整册转入默认关闭；须同时开放审核、目录维护并通过Linux验收后单独批准启用。
LJM_MANUAL_TRANSFER_ONLINE_ENABLED=false
# 9.4 获批后开放药品资料录入和审核转入。物件说明书、正式发布权限沿用各自设置。
LJM_MANUAL_MEDICINES_ONLINE_ENABLED=false
