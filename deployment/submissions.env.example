# 投稿与联系接收进程独立配置，不放管理员登录密钥，不与管理员环境文件混用。
# 联系记录保存在投稿私密目录下的 _contacts 子目录，不需要新增公开目录。
PUBLIC_SITE_URL=https://laojiumopian.com
LJM_SUBMISSION_PORT=4176
# 与账号、管理进程共用同一个私密收件区预算；三份正式环境须保持一致。
LJM_SUBMISSION_MAX_STORAGE_MIB=1024
LJM_SUBMISSION_DATA_DIR=/srv/laojiumopian-admin/data/submissions
LJM_PUBLIC_RELEASES_DIR=/srv/laojiumopian/releases
