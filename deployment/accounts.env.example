# 账户与账户投稿服务的独立配置。不放管理员登录密钥，不与管理端或公开接收进程的环境文件混用。
# 正式文件放在服务器 /etc/laojiumopian-accounts.env，权限 0600，属主 root。密钥只写在本文件里，不进代码仓库。

# production：会拒绝本机测试投递通道，必须使用正式邮件服务。
LJM_ACCOUNT_ENV=production
LJM_ACCOUNT_PORT=4177
# 有限开放开关。初次部署保持 false；验收通过后才逐项改为 true 并重启账户服务。
LJM_ACCOUNT_REGISTRATION_OPEN=false
LJM_ACCOUNT_UPLOADS_OPEN=false

# 公开网站来源地址：账户接口据此校验请求来源。
LJM_ACCOUNT_ORIGIN=https://laojiumopian.com
# 管理入口来源地址：只有该来源可以调用 /api/account-admin/*（该前缀不对外暴露）。
LJM_ADMIN_ORIGIN=https://admin.laojiumopian.com

# 账户业务数据目录（账号、会话、收藏、申请、邮件事件）与共用的私密投稿收件区。
LJM_ACCOUNT_DATA_DIR=/srv/laojiumopian-admin/data/accounts
LJM_SUBMISSION_DATA_DIR=/srv/laojiumopian-admin/data/submissions

# 正式邮件通道：服务商 HTTPS 接口 + Node 内置 fetch，零额外依赖。
LJM_MAIL_TRANSPORT=https
LJM_MAIL_API_ENDPOINT=https://api.resend.com/emails
LJM_MAIL_API_KEY=REPLACE_WITH_RESEND_API_KEY
LJM_MAIL_FROM=老旧默片 <no-reply@laojiumopian.com>
# 服务器直连服务商即可，不需要代理；本机自测才需要 LJM_MAIL_PROXY。

# 来源地址摘要盐：留空时会在数据目录自动生成并保存到 .ip-salt。
LJM_ACCOUNT_IP_SALT=
