# 仅 import 到公开站点块；共享测试域名不受影响。
# 已存在的公开静态文件自动覆盖六语言、相册、图片和索引。
# 成功响应（包括304）才允许复用，不存在的哈希文件不得缓存一年。
@ljmHashedAssets {
	host laojiumopian.com
	method GET HEAD
	path_regexp ljm_hashed ^/_astro/(?:[^/]+/)*[^/]+\.[A-Za-z0-9_-]{8,}\.(?:css|m?js|woff2?|ttf|otf)$
	file {path}
}
header @ljmHashedAssets {
	Cache-Control "public, max-age=31536000, immutable"
	match status 200 206 304
}

@ljmPublicStatic {
	host laojiumopian.com
	method GET HEAD
	not path /_astro/*
	not path_regexp ljm_private ^/(?:en/|th/|ja/|ko/|zh-hant/)?(?:api|admin|local-admin|login|me|drafts|history|recycle-bin|archive-data)(?:/|$)
	file {path}/index.html {path}
}
header @ljmPublicStatic {
	Cache-Control "public, max-age=0, must-revalidate"
	match status 200 206 304
}

# 发布副本和响应式图片也由上面的通用静态规则处理，每次复用前核验。
# 不叠加一小时图片规则：同名副本可能更新或因隐私撤下，不能延迟重新核验。

# _astro内未带内容版本的资源也不能长缓存。
@ljmUnversionedAssets {
	host laojiumopian.com
	method GET HEAD
	path /_astro/*
	not path_regexp ljm_not_hashed ^/_astro/(?:[^/]+/)*[^/]+\.[A-Za-z0-9_-]{8,}\.(?:css|m?js|woff2?|ttf|otf)$
	file {path}
}
header @ljmUnversionedAssets {
	Cache-Control "public, max-age=0, must-revalidate"
	match status 200 206 304
}

@ljmPrivateRequests {
	host laojiumopian.com
	path_regexp ljm_no_store ^/(?:en/|th/|ja/|ko/|zh-hant/)?(?:api|admin|local-admin|login|me|drafts|history|recycle-bin|archive-data)(?:/|$)
}
header @ljmPrivateRequests >Cache-Control "no-store"

# Caddy直接返回的拒绝/重定向及反向代理错误也不得留下持久副本。
@ljmPublicHost host laojiumopian.com
header @ljmPublicHost {
	Cache-Control "no-store"
	match status 301 302 303 307 308 4xx 5xx
}
